# ---------------------------------------------------------------- sizes
to_mb() {   # 8G / 8192M / 8 (GB) -> MB
    local v=${1^^}
    [[ $v =~ ^([0-9]+)(G|GB|M|MB)?$ ]] || return 1
    case ${BASH_REMATCH[2]} in M|MB) echo "${BASH_REMATCH[1]}" ;; *) echo $(( BASH_REMATCH[1] * 1024 )) ;; esac
}
to_gb() {
    local v=${1^^}
    [[ $v =~ ^([0-9]+)(G|GB|T|TB)?$ ]] || return 1
    case ${BASH_REMATCH[2]} in T|TB) echo $(( BASH_REMATCH[1] * 1024 )) ;; *) echo "${BASH_REMATCH[1]}" ;; esac
}

check_resources() {   # RAM_MB CPUS DISK_GB
    local ram=$1 cpus=$2 disk=$3 threads avail free_gb problems=()
    threads=$(nproc)
    avail=$(( $(awk '/^MemAvailable:/ {print $2}' /proc/meminfo) / 1024 ))
    free_gb=$(( $(df -Pk "$STORE" | awk 'NR==2 {print $4}') / 1048576 ))
    (( cpus <= threads )) || problems+=("$cpus cores requested but this host has only $threads CPU threads.")
    (( ram <= avail - RESERVE_RAM_MB )) || problems+=("$((ram / 1024)) GB RAM requested but only $((avail / 1024)) GB is available and $((RESERVE_RAM_MB / 1024)) GB is kept for the host.")
    (( disk <= free_gb )) || problems+=("$disk GB disk requested but only $free_gb GB is free in $STORE.")
    if (( ${#problems[@]} )); then
        local p; for p in "${problems[@]}"; do warn "$p"; done
        confirm "The VM may run slowly or affect other services on this server." || die "cancelled"
    fi
}

# ---------------------------------------------------------------- create
usage_create() {
    cat <<'EOF'
vmctl create [options]          (anything not given is asked for)
  --name NAME          VM name: letters, digits and dashes, up to 15 characters
  --os OS              win11 | win10 | win11ltsc | win10ltsc | tiny11 | linux-iso | linux-cloud
                       tiny11: give the ISO with --iso-url or --iso-path; NVDA is installed from a
                       shared folder on this server (a drive in Windows), which stays for other installers
  --distro ID          linux-iso: debian13 ubuntu2604-desktop ubuntu2604-server ubuntu2404-desktop
                       ubuntu2404-server fedora-workstation fedora-server mint custom
                       linux-cloud: debian13 debian12 ubuntu2604 ubuntu2404
  --iso-url URL        use this ISO download (Windows or Linux)
  --iso-path FILE      use an ISO already on this server
  --edition NAME       Windows 10/11 image name (default "Windows 11 Pro" / "Windows 10 Pro");
                       tiny11: only needed if its ISO holds more than one edition
  --ram SIZE           e.g. 8G or 4096M
  --cpus N             CPU cores
  --disk SIZE          e.g. 80G
  --user NAME          account to create (Windows and linux-cloud)
  --password PASS      its password (otherwise asked for, hidden)
  --ssh-key KEY|FILE   linux-cloud: an SSH public key or a file containing one
  --allow LIST         comma-separated IPs/subnets allowed to reach this VM's ports; "any" for everyone
  --data-disk SIZE     add a second disk for data, e.g. 100G (0 or none = no data disk). Windows gets
                       an NTFS drive called Data, Linux gets it mounted at /data; both stay after restarts
  --autostart yes|no   start the VM automatically whenever this server starts (default yes)
  --owner USER         server account that may use this VM's snapshots and shared folder with
                       "sudo vmctl snapshot" and "sudo vmctl share" (none = only root and admins)
  --no-wait            Windows: do not wait for the install to finish
  -y, --yes            do not ask for final confirmation
EOF
}

CREATE_PENDING=
# EXIT trap while a create is in progress: undo the reservation, disk, seed,
# DHCP entry and firewall rules so a failed or cancelled create leaves nothing.
create_abort() {
    local name=$CREATE_PENDING
    [[ -n $name ]] || return 0
    CREATE_PENDING=
    msg "Cleaning up the unfinished VM $name..." >&2
    rm -f "$STORE/seed/$name-"*.iso
    vm_exists "$name" && ( cmd_delete "$name" --force --keep-shared >/dev/null 2>&1 ) || true
}

cmd_create() {
    local NAME= OS= DISTRO= ISO_URL= ISO_PATH= EDITION= RAM= CPUS_IN= DISK_IN= USERNAME= PASSWORD= SSHKEY= ALLOW= ALLOW_SET=0 NOWAIT=0 YES=0
    local DATA_IN= DATA_SET=0 AUTOSTART= OWNER= OWNER_SET=0 SNAP_AUTO=yes SNAP_KEEP=$SNAP_KEEP_DEFAULT
    while (( $# )); do
        case $1 in
            --data-disk) DATA_IN=$2; DATA_SET=1; shift ;;
            --autostart) AUTOSTART=$2; shift ;;
            --owner) OWNER=$2; OWNER_SET=1; shift ;;
            --name) NAME=$2; shift ;;
            --os) OS=$2; shift ;;
            --distro) DISTRO=$2; shift ;;
            --iso-url) ISO_URL=$2; shift ;;
            --iso-path) ISO_PATH=$2; shift ;;
            --edition) EDITION=$2; shift ;;
            --ram) RAM=$2; shift ;;
            --cpus) CPUS_IN=$2; shift ;;
            --disk) DISK_IN=$2; shift ;;
            --user) USERNAME=$2; shift ;;
            --password) PASSWORD=$2; shift ;;
            --ssh-key) SSHKEY=$2; shift ;;
            --allow) ALLOW=$2; ALLOW_SET=1; shift ;;
            --no-wait) NOWAIT=1 ;;
            -y|--yes) YES=1 ;;
            -h|--help) usage_create; return ;;
            *) die "unknown option $1 (see: vmctl create --help)" ;;
        esac
        shift
    done

    ensure_network
    vmsg "Server check finished: ready to run virtual machines"

    # --- name
    while :; do
        [[ -n $NAME ]] || ask NAME "Name for the new VM (letters, digits, dashes; up to 15 characters)"
        if [[ ! $NAME =~ ^[A-Za-z][A-Za-z0-9-]{0,14}$ ]]; then msg "That name is not allowed."; NAME=
        elif vm_exists "$NAME" || "${VIRSH[@]}" dominfo "$NAME" >/dev/null 2>&1; then msg "A VM called $NAME already exists."; NAME=
        else break; fi
        (( INTERACTIVE )) || die "invalid or duplicate --name"
    done

    # --- operating system
    local c
    if [[ -z $OS ]]; then
        menu c "Which operating system?" \
            "Windows 11 (Pro; may need your own ISO link, see below)" \
            "Windows 10 (Pro; may need your own ISO link)" \
            "Windows 11 LTSC (Enterprise LTSC 2024, 90-day evaluation, downloads automatically)" \
            "Windows 10 LTSC (Enterprise LTSC 2021, 90-day evaluation, downloads automatically)" \
            "Tiny11 (trimmed Windows 11 with no browser; you give the ISO link or file; NVDA comes from a shared folder)" \
            "Linux from an installer ISO (you install it through remote-viewer)" \
            "Linux cloud image (Debian or Ubuntu, unattended, ready in about a minute)"
        OS=$(echo "win11 win10 win11ltsc win10ltsc tiny11 linux-iso linux-cloud" | cut -d' ' -f"$c")
    fi
    local KIND MODE OS_LABEL
    case $OS in
        win11|win10|win11ltsc|win10ltsc|tiny11) KIND=windows MODE=winiso; win_info "$OS"; OS_LABEL=$WIN_LABEL ;;
        linux-iso) KIND=linux MODE=iso ;;
        linux-cloud) KIND=linux MODE=cloud ;;
        *) die "unknown --os '$OS'" ;;
    esac
    [[ $OS == tiny11 ]] && ensure_tiny11_deps

    # --- distro
    local entry id label url osinfo_c=()
    if [[ $MODE == iso ]]; then
        if [[ -z $DISTRO && -z $ISO_URL && -z $ISO_PATH ]]; then
            local labels=(); for entry in "${LINUX_ISOS[@]}"; do labels+=("${entry#*|}"); done
            menu c "Which Linux distribution?" "${labels[@]}"
            DISTRO=${LINUX_ISOS[c-1]%%|*}
        fi
        [[ -n $DISTRO ]] || DISTRO=custom
        OS_LABEL="Linux ($DISTRO)"
        for entry in "${LINUX_ISOS[@]}"; do [[ ${entry%%|*} == "$DISTRO" ]] && OS_LABEL=${entry#*|}; done
        OS_LABEL=${OS_LABEL%% (*}
    elif [[ $MODE == cloud ]]; then
        if [[ -z $DISTRO ]]; then
            local labels=(); for entry in "${CLOUD_IMAGES[@]}"; do IFS='|' read -r id label url _ <<<"$entry"; labels+=("$label"); done
            menu c "Which cloud image?" "${labels[@]}"
            DISTRO=${CLOUD_IMAGES[c-1]%%|*}
        fi
        local found=0
        for entry in "${CLOUD_IMAGES[@]}"; do
            IFS='|' read -r id label url osi <<<"$entry"
            if [[ $id == "$DISTRO" ]]; then found=1; OS_LABEL=$label; CLOUD_URL=$url; read -ra osinfo_c <<<"$osi"; fi
        done
        (( found )) || die "unknown cloud image '$DISTRO'"
    fi

    # --- size
    local dram dcpu ddisk
    case $KIND in windows) dram=8G dcpu=4 ddisk=80G ;; *) dram=4G dcpu=2 ddisk=40G ;; esac
    [[ $MODE == cloud ]] && dram=2G ddisk=20G
    local RAM_MB CPUS DISK_GB
    while :; do [[ -n $RAM ]] || ask RAM "How much RAM? (for example 8G or 4096M)" "$dram"
        RAM_MB=$(to_mb "$RAM") && (( RAM_MB >= 512 )) && break; msg "Please give a size like 8G."; RAM=
        (( INTERACTIVE )) || die "bad --ram"; done
    while :; do [[ -n $CPUS_IN ]] || ask CPUS_IN "How many CPU cores?" "$dcpu"
        [[ $CPUS_IN =~ ^[0-9]+$ ]] && (( CPUS_IN >= 1 )) && { CPUS=$CPUS_IN; break; }; msg "Please give a whole number."; CPUS_IN=
        (( INTERACTIVE )) || die "bad --cpus"; done
    while :; do [[ -n $DISK_IN ]] || ask DISK_IN "How much disk space? (for example 80G)" "$ddisk"
        DISK_GB=$(to_gb "$DISK_IN") && (( DISK_GB >= 8 )) && break; msg "Please give a size like 80G (at least 8G)."; DISK_IN=
        (( INTERACTIVE )) || die "bad --disk"; done
    if [[ $OS == win11* || $OS == tiny11 ]]; then
        (( RAM_MB >= 4096 )) || warn "Windows 11 officially needs at least 4 GB RAM."
        (( DISK_GB >= 64 )) || warn "Windows 11 officially needs at least 64 GB of disk."
    fi
    # Optional second disk for data.
    local DATA_GB=0 where
    if [[ $KIND == windows ]]; then where="it will show up in Windows as a drive called Data"
    else where="it will be mounted at /data"; fi
    while :; do
        if (( ! DATA_SET )); then
            if (( INTERACTIVE )); then
                msg "Do you want a second disk for storing data? It is kept separate from the system disk; $where."
                ask DATA_IN "Size of the data disk, for example 100G, or press Enter for no data disk" "none"
            else DATA_IN=none; fi
        fi
        case ${DATA_IN,,} in none|no|0|0g|"") DATA_GB=0; break ;; esac
        DATA_GB=$(to_gb "$DATA_IN") && (( DATA_GB >= 1 )) && break
        msg "Please give a size like 100G, or none."; DATA_SET=0
        (( INTERACTIVE )) || die "bad --data-disk"
    done
    check_resources "$RAM_MB" "$CPUS" "$(( DISK_GB + DATA_GB ))"

    # --- account
    if [[ $MODE != iso ]]; then
        while :; do
            [[ -n $USERNAME ]] || ask USERNAME "User name to create in the VM"
            if [[ $KIND == windows && ( ${USERNAME,,} == administrator || ${USERNAME,,} == guest ) ]]; then msg "Choose a name other than $USERNAME."; USERNAME=
            elif [[ $KIND == linux && ! $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then msg "Linux user names use lowercase letters, digits, - and _."; USERNAME=
            elif [[ -z $USERNAME || ${#USERNAME} -gt 20 ]]; then msg "The name must be 1 to 20 characters."; USERNAME=
            else break; fi
            (( INTERACTIVE )) || die "bad --user"
        done
        [[ -n $PASSWORD ]] || ask_secret PASSWORD "Password for $USERNAME"
    fi
    if [[ $MODE == cloud && -z $SSHKEY && $INTERACTIVE == 1 ]]; then
        ask SSHKEY "Paste an SSH public key, or a path to one, or press Enter to skip" " "
        SSHKEY=${SSHKEY# }
    fi
    if [[ -n $SSHKEY && -f $SSHKEY ]]; then SSHKEY=$(head -n1 "$SSHKEY"); fi

    # --- access
    if (( ! ALLOW_SET )); then
        if (( INTERACTIVE )); then
            if [[ $KIND == windows ]]; then
                msg "Which IP addresses may connect to this VM (Remote Desktop, remote-viewer and any port forwards)?"
            else
                msg "Which IP addresses may connect to this VM (SSH, remote-viewer and any port forwards)?"
            fi
            msg "Give IPs or subnets separated by commas, for example 203.0.113.5,198.51.100.0/24."
            while :; do
                ask ALLOW "Press Enter to allow everyone" "any"
                valid_allow "$ALLOW" && break
            done
        else ALLOW=any; fi
    fi
    valid_allow "$ALLOW" || die "bad --allow"
    ALLOW=$(split_allow "$ALLOW" | paste -sd, -)

    # --- start with the server?
    while :; do
        if [[ -z $AUTOSTART ]]; then
            if (( INTERACTIVE )); then
                ask AUTOSTART "Start this VM automatically whenever this server starts or restarts? (yes or no)" "yes"
            else AUTOSTART=yes; fi
        fi
        case ${AUTOSTART,,} in y|yes|on|true|1) AUTOSTART=yes; break ;; n|no|off|false|0) AUTOSTART=no; break ;; esac
        msg "Please answer yes or no."; AUTOSTART=
        (( INTERACTIVE )) || die "bad --autostart (use yes or no)"
    done
    # --- owner (may use "sudo vmctl snapshot" on this VM)
    while :; do
        if (( ! OWNER_SET )) && (( INTERACTIVE )); then
            ask OWNER "Which server user owns this VM and may take and restore its snapshots? Leave empty for root only" ""
        fi
        [[ ${OWNER,,} == none ]] && OWNER=
        [[ -z $OWNER ]] || id -u "$OWNER" >/dev/null 2>&1 && break
        msg "There is no user called $OWNER on this server."; OWNER=; OWNER_SET=0
        (( INTERACTIVE )) || die "bad --owner (no such user)"
    done
    local DATA_DISKS=
    (( DATA_GB > 0 )) && DATA_DISKS="data1:$DATA_GB"

    # --- allocate and reserve (under a lock, so two creates at once never get
    # the same address or ports; the record is removed again if we fail).
    local IP MAC SPICE_PORT SPICE_PASS RDP_PORT= SSH_PORT=
    local DISK="$STORE/disks/$NAME.qcow2" SEED= STATUS=creating CREATED
    CREATED=$(date -Is)
    step "Reserving an address and ports"
    exec 9>"$CONF_DIR/.lock"
    flock -n 9 || { msg "Another vmctl command is busy; waiting for it to finish"; flock 9; }
    vm_exists "$NAME" && die "a VM called $NAME was just created by someone else"
    msg "Picking a free private address"
    IP=$(next_ip)
    msg "Private address: $IP"
    MAC=$(make_mac "$NAME")
    msg "Network card address: $MAC"
    msg "Picking free ports"
    SPICE_PORT=$(next_port "$SPICE_BASE"); SPICE_PASS=$(rand_pass 12)
    msg "remote-viewer (SPICE) port: $SPICE_PORT"
    if [[ $KIND == windows ]]; then RDP_PORT=$(next_port "$RDP_BASE"); msg "Remote Desktop port: $RDP_PORT"
    else SSH_PORT=$(next_port "$SSH_BASE"); msg "SSH port: $SSH_PORT"; fi
    msg "Saving the VM record and its port forwards"
    save_vm "$NAME"
    {
        echo "# proto hostport guestport allowed-sources label"
        [[ -n $RDP_PORT ]] && { echo "tcp $RDP_PORT 3389 $ALLOW rdp"; echo "udp $RDP_PORT 3389 $ALLOW rdp"; }
        [[ -n $SSH_PORT ]] && echo "tcp $SSH_PORT 22 $ALLOW ssh"
    } >"$(vm_fwd "$NAME")"
    chmod 600 "$(vm_fwd "$NAME")"
    CREATE_PENDING=$NAME
    trap create_abort EXIT
    flock -u 9

    step "Summary"
    msg "Name: $NAME"
    msg "System: $OS_LABEL"
    msg "RAM: $((RAM_MB / 1024)) GB, cores: $CPUS, disk: $DISK_GB GB"
    msg "Private address: $IP"
    msg "remote-viewer (SPICE) port: $SPICE_PORT"
    [[ -n $RDP_PORT ]] && msg "Remote Desktop port: $RDP_PORT"
    [[ -n $SSH_PORT ]] && msg "SSH port: $SSH_PORT"
    if (( DATA_GB > 0 )); then msg "Data disk: $DATA_GB GB"; else msg "Data disk: none"; fi
    msg "Starts automatically with the server: $AUTOSTART"
    [[ $OS == tiny11 ]] && msg "Shared folder (NVDA comes from here; a drive in Windows): $(share_dir "$NAME")"
    msg "Allowed to connect: $ALLOW"
    (( YES )) || confirm "Create this VM?" || die "cancelled"

    # --- media
    local INSTALL_ISO= VIRTIO_ISO="$STORE/isos/virtio-win.iso"
    case $MODE in
        winiso)
            step "Getting installation media"
            INSTALL_ISO=$(get_windows_iso "$OS")
            local flavor= winfsp=
            if [[ $OS == tiny11 ]]; then
                flavor=tiny11
                prep_tiny11_iso "$INSTALL_ISO"
                winfsp=$(winfsp_msi) || die "could not get the WinFsp installer"
                step "Setting up the shared folder"
                make_share "$NAME"
                ensure_share_wrapper
                set_env "$NAME" SHARE_DIR "$SHARE_DIR"   # so a failed create removes it again
                stage_nvda_on_host "$SHARE_DIR"
            fi
            download "$VIRTIO_URL" "$VIRTIO_ISO"
            SEED="$STORE/seed/$NAME-unattend.iso"
            msg "Building the unattended-install disc:"
            build_windows_seed "$NAME" "$USERNAME" "$PASSWORD" "$VIRTIO_ISO" "$SEED" "$flavor" "$winfsp" ;;
        iso)
            step "Getting installation media"
            if [[ -n $ISO_PATH ]]; then [[ -f $ISO_PATH ]] || die "no such file: $ISO_PATH"; INSTALL_ISO=$ISO_PATH
            else
                if [[ -z $ISO_URL && $DISTRO == custom ]]; then
                    local ans
                    while :; do
                        ask ans "Paste an ISO download URL or type the path of an ISO on this server"
                        if [[ $ans =~ ^https?:// ]]; then ISO_URL=$ans; break
                        elif [[ -f $ans ]]; then INSTALL_ISO=$ans; break; fi
                        msg "That is neither a URL nor an existing file."
                    done
                fi
                if [[ -z $INSTALL_ISO ]]; then
                    [[ -n $ISO_URL ]] || ISO_URL=$(linux_iso_url "$DISTRO") || die "could not find the current $DISTRO ISO; use --iso-url"
                    INSTALL_ISO="$STORE/isos/$(basename "${ISO_URL%%\?*}")"
                    download "$ISO_URL" "$INSTALL_ISO"
                fi
            fi ;;
        cloud)
            step "Getting the cloud image"
            local base; base="$STORE/isos/cloud-$DISTRO-$(basename "$CLOUD_URL")"
            # Refresh cached cloud images older than 30 days.
            [[ -f $base ]] && [[ -n $(find "$base" -mtime +30) ]] && rm -f "$base"
            download "$CLOUD_URL" "$base"
            SEED="$STORE/seed/$NAME-cidata.iso"
            msg "Writing the cloud-init settings (user $USERNAME, password, ${SSHKEY:+SSH key, }guest agent${DATA_DISKS:+, data disk at /data})"
            build_cloud_seed "$NAME" "$USERNAME" "$PASSWORD" "$SSHKEY" "$SEED" "$DATA_DISKS"
            msg "Built the cloud-init disc ($(basename "$SEED"))" ;;
    esac

    # --- disks
    step "Creating the VM"
    if [[ $MODE == cloud ]]; then
        msg "Copying the $OS_LABEL image to a new system disk ($DISK)"
        copy_disk "$STORE/isos/cloud-$DISTRO-$(basename "$CLOUD_URL")" "$DISK"
        msg "Growing the system disk to $DISK_GB GB"
        qemu-img resize -q "$DISK" "${DISK_GB}G"
        msg "  Done."
    else
        make_disk "$DISK" "$DISK_GB" "system disk"
    fi
    if (( DATA_GB > 0 )); then make_disk "$(data_disk_path "$NAME" data1)" "$DATA_GB" "data disk"; fi

    # --- record + network + firewall (before boot so DHCP hands out the fixed IP)
    STATUS=installing
    [[ $MODE != winiso ]] && STATUS=ready
    save_vm "$NAME"
    msg "Reserving private address $IP for network card $MAC"
    "${VIRSH[@]}" net-update "$NET_NAME" add-last ip-dhcp-host \
        "<host mac='$MAC' name='$NAME' ip='$IP'/>" --live --config >/dev/null
    msg "Opening the firewall for port $SPICE_PORT (remote-viewer)${RDP_PORT:+ and $RDP_PORT (Remote Desktop)}${SSH_PORT:+ and $SSH_PORT (SSH)}, allowed: $ALLOW"
    fw_vm_add "$NAME"
    apply_forwards

    # --- virt-install
    local args=(--connect qemu:///system --name "$NAME" --memory "$RAM_MB" --vcpus "$CPUS"
                --cpu host-passthrough --machine q35
                --network "network=$NET_NAME,model=virtio,mac=$MAC"
                --graphics "spice,listen=0.0.0.0,port=$SPICE_PORT,password=$SPICE_PASS,defaultMode=insecure,image.compression=auto_glz"
                --sound ich9 --channel spicevmc
                --channel unix,target.type=virtio,name=org.qemu.guest_agent.0
                --memballoon virtio --rng /dev/urandom
                --import --noautoconsole)
    case $MODE in
        winiso)
            args+=(--osinfo "$(pick_osinfo "$WIN_OSINFO")"
                   --boot uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=yes,firmware.feature1.name=enrolled-keys,firmware.feature1.enabled=yes
                   --tpm emulator,model=tpm-crb,version=2.0
                   --serial "file,path=$(vm_plog "$NAME")"
                   --video qxl
                   --disk "path=$DISK,format=qcow2,bus=virtio,cache=none,discard=unmap,boot.order=1"
                   --disk "path=$INSTALL_ISO,device=cdrom,bus=sata,readonly=on,boot.order=2"
                   --disk "path=$SEED,device=cdrom,bus=sata,readonly=on")
            # Tiny11: the shared folder (virtiofs needs the VM's RAM shareable).
            [[ $OS == tiny11 ]] && args+=(--memorybacking source.type=memfd,access.mode=shared
                   --filesystem "type=mount,accessmode=passthrough,driver.type=virtiofs,source.dir=$SHARE_DIR,target.dir=$SHARE_TAG,binary.path=$SHARE_WRAPPER")
            ;;
        iso)
            args+=(--osinfo detect=on,require=off
                   --boot uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no
                   --video virtio --console pty,target.type=serial
                   --disk "path=$DISK,format=qcow2,bus=virtio,cache=none,discard=unmap,boot.order=1"
                   --disk "path=$INSTALL_ISO,device=cdrom,bus=sata,readonly=on,boot.order=2") ;;
        cloud)
            args+=(--osinfo "$(pick_osinfo "${osinfo_c[@]}")"
                   --boot uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no
                   --video virtio --console pty,target.type=serial
                   --disk "path=$DISK,format=qcow2,bus=virtio,cache=none,discard=unmap,boot.order=1"
                   --disk "path=$SEED,device=cdrom,bus=sata,readonly=on") ;;
    esac
    # Windows Setup installs onto "disk 0", which can turn out to be the data
    # disk, so for Windows the watcher attaches the data disk after setup.
    (( DATA_GB > 0 )) && [[ $MODE != winiso ]] && \
        args+=(--disk "path=$(data_disk_path "$NAME" data1),format=qcow2,bus=virtio,cache=none,discard=unmap,serial=vmctl-data1")
    local attached="system disk"
    [[ -n $DATA_DISKS && $MODE != winiso ]] && attached+=", data disk"
    case $MODE in
        winiso) attached+=", Windows installation disc ($(basename "$INSTALL_ISO")), setup disc (answer file + drivers)"
                [[ $OS == tiny11 ]] && attached+=", shared folder $SHARE_DIR"
                msg "Defining the VM: UEFI with Secure Boot, TPM 2.0, $CPUS cores, $((RAM_MB / 1024)) GB RAM, sound, VirtIO network" ;;
        iso)    attached+=", installer disc ($(basename "$INSTALL_ISO"))"
                msg "Defining the VM: UEFI, $CPUS cores, $((RAM_MB / 1024)) GB RAM, sound, VirtIO network, serial console" ;;
        cloud)  attached+=", cloud-init disc"
                msg "Defining the VM: UEFI, $CPUS cores, $((RAM_MB / 1024)) GB RAM, sound, VirtIO network, serial console" ;;
    esac
    msg "Attaching: $attached"
    [[ -n $DATA_DISKS && $MODE == winiso ]] && \
        msg "The data disk is attached after Windows has installed, so Windows Setup cannot install onto it"
    # virt-install always asks for an auto-allocated SPICE TLS port when a port
    # is given, which libvirt refuses without TLS certificates. So: print the
    # XML, drop tlsPort, define and start it ourselves.
    local xml; xml=$(mktemp)
    if ! virt-install "${args[@]}" --print-xml >"$xml" \
        || ! sed -i -e 's/ tlsPort="-1"//' \
                    -e 's|\(<source path="[^"]*-progress\.log"\)/>|\1 append="on"/>|' "$xml" \
        || ! "${VIRSH[@]}" define "$xml" >/dev/null; then
        rm -f "$xml"
        die "creating the VM failed"    # the EXIT trap (create_abort) cleans up
    fi
    rm -f "$xml"
    if [[ $AUTOSTART == yes ]]; then
        msg "Turning on automatic start: $NAME will start whenever this server starts"
        "${VIRSH[@]}" autostart "$NAME" >/dev/null
    else
        msg "Automatic start is off: start $NAME yourself after the server restarts (vmctl start $NAME)"
        "${VIRSH[@]}" autostart --disable "$NAME" >/dev/null
    fi
    msg "Starting the VM"
    "${VIRSH[@]}" start "$NAME" >/dev/null || die "starting the VM failed"
    CREATE_PENDING=; trap - EXIT
    msg "Writing the remote-viewer connection file ($(vm_vv "$NAME"))"
    write_vv "$NAME"

    if [[ $MODE == winiso ]]; then
        # UEFI shows "Press any key to boot from CD or DVD" for a few seconds.
        msg "Pressing Enter for the firmware's 'Press any key to boot from CD or DVD' prompt"
        local i; for (( i = 0; i < 25; i++ )); do "${VIRSH[@]}" send-key "$NAME" KEY_ENTER >/dev/null 2>&1 || true; sleep 1; done
        msg "Starting the install watcher: it finishes the install in the background, even if you close this terminal"
        start_watcher "$NAME"
    fi

    step "VM $NAME created"
    cmd_info "$NAME"
    if [[ $MODE == winiso ]]; then
        msg ""
        msg "Windows is now installing by itself. This usually takes 20 to 60 minutes."
        msg "It reboots a few times, installs the VirtIO tools and NVDA, then powers off;"
        msg "vmctl then removes the install discs and starts it again automatically."
        msg "You can listen in or watch with remote-viewer at any time using the file above."
        msg "Follow the progress from any terminal with: vmctl progress $NAME"
        if [[ $OS == tiny11 ]]; then
            msg ""
            msg "Shared folder: $SHARE_DIR on this server is a drive in Windows (usually Z:)."
            msg "NVDA is installed from it and its installer is then deleted. Put other installers"
            msg "there (for example Firefox or Brave) and run them from that drive in Windows."
        fi
        msg ""
        want_watch "$NAME" "the Windows install" "vmctl progress $NAME" "The install carries on by itself." \
            && cmd_progress "$NAME"
    elif [[ $MODE == iso ]]; then
        msg ""
        msg "Connect with remote-viewer now to run the installer. Sound is on, so speech-enabled"
        msg "installers (for example Debian's, by pressing s at the boot menu) will talk."
        msg "During installation, include an SSH server so the SSH port above works afterwards."
        msg "For 'vmctl console $NAME' to work, the installed system needs console=ttyS0 on its kernel command line."
        if [[ -n $DATA_DISKS ]]; then
            msg "The data disk is attached as a second, empty disk. Install the system on the FIRST disk."
            msg "After installing (with the qemu-guest-agent package), run 'vmctl disk setup $NAME' to format it"
            msg "and mount it at /data permanently, or see 'vmctl disk help' for doing it by hand."
        fi
        msg ""
        if want_watch "$NAME" "the installer start up" "vmctl boot $NAME" "The VM keeps running."; then
            trap 'echo; msg "Stopped watching. $NAME keeps running. Watch again with: vmctl boot $NAME"; exit 0' INT
            msg "Following the installer's boot. Press Ctrl+C to stop watching."
            follow_boot "$NAME" 300
            [[ -n $BOOT_RESULT ]] && print_connect_hint "$NAME" "$BOOT_RESULT"
            trap - INT
        fi
    else
        msg ""
        msg "The VM is booting and cloud-init is setting up $USERNAME. This usually takes 1 to 5 minutes."
        msg ""
        if want_watch "$NAME" "the setup" "vmctl boot $NAME" "Setup carries on by itself."; then
            trap 'echo; msg "Stopped watching. Setup carries on by itself. Watch again with: vmctl boot $NAME"; exit 0' INT
            msg "Following the setup until the sign-in prompt shows. Press Ctrl+C to stop watching."
            follow_boot "$NAME" 600
            [[ -n $BOOT_RESULT ]] && print_connect_hint "$NAME" "$BOOT_RESULT"
            trap - INT
        fi
    fi
}

# After a create: ask whether to follow the install now. Returns 0 to follow;
# otherwise says how to follow it later. Uses NOWAIT from cmd_create.
want_watch() {   # want_watch NAME "what" "command" "carries-on sentence"
    local name=$1 what=$2 cmd=$3 later=$4 reply
    if (( NOWAIT )); then
        msg "To watch $what later, type: $cmd"; return 1
    fi
    (( INTERACTIVE )) || return 0
    while :; do
        ask reply "Do you want to watch $what now? (yes or no)" "yes"
        case ${reply,,} in y|yes) return 0 ;; n|no) break ;; esac
        msg "Please answer yes or no."
    done
    msg "Not watching. $later"
    msg "To watch it at any time, type: $cmd"
    return 1
}

disk_written_gb() {   # GB the VM has written to its system disk since it was started
    "${VIRSH[@]}" domblkstat "$1" vda 2>/dev/null | awk '$2=="wr_bytes" {printf "%.1f", $3/1073741824; f=1} END {if (!f) print "0.0"}'
}

current_stage() {   # last "STAGE n/6 ..." line Windows sent over COM1
    local f l=; f=$(vm_plog "$1")
    [[ -f $f ]] && l=$({ grep -a 'STAGE [0-9]/[0-9]' "$f" || true; } | tail -n1 | tr -d '\r')
    if [[ $l =~ STAGE\ ([0-9])/([0-9])\ (.*)$ ]]; then
        echo "Stage ${BASH_REMATCH[1]} of ${BASH_REMATCH[2]}: ${BASH_REMATCH[3]}"
    elif [[ $(disk_written_gb "$1") != 0.[0-2] ]]; then
        # Windows Setup itself (WinPE) has no serial driver, so stage 2 is
        # recognised from the host side: the installer is writing to the disk.
        echo "Stage 2 of 6: Windows Setup is partitioning the disk and copying Windows files"
    else
        echo "Stage 1 of 6: booting the Windows installer"
    fi
}

# Follow a Windows install from the terminal. Windows writes each step to its
# COM1 serial port (saved by the host to the progress log); this prints those
# steps as they happen, plus a short heartbeat every 2 minutes with time and
# disk activity. Plain lines only - no redrawn bars, so screen readers read
# each update once.
cmd_progress() {
    local name=${1-}; [[ -n $name ]] || die "usage: vmctl progress NAME"
    load_vm "$name"
    [[ $KIND == windows ]] || die "$name is not a Windows VM; only Windows installs are tracked"
    if [[ $STATUS == ready ]]; then
        msg "$name has finished installing."
        [[ -n ${SETUP_RESULT:-} ]] && msg "Windows setup: $SETUP_RESULT"
        return 0
    fi
    local plog seen=0 n line st start now last_beat result= waited=0 stuck_warned=0 stage2_shown=0 last_ocr=0
    plog=$(vm_plog "$name")
    start=$(date -d "$CREATED" +%s 2>/dev/null || date +%s)
    last_beat=$(date +%s)
    trap 'echo; msg "Stopped watching. The install carries on by itself. Watch again with: vmctl progress $name"; exit 0' INT
    msg "Following the Windows install of $name. Press Ctrl+C to stop watching; the install keeps going."
    msg "Windows reports 6 stages. It restarts several times along the way; that is normal."
    msg "Text on the VM's screen is read out when it changes (checked every 30 seconds)."
    ensure_ocr || true
    reset_screen_state
    events_mark "$name"
    msg "$(current_stage "$name")"
    [[ $(current_stage "$name") == "Stage 1 of 6"* ]] || stage2_shown=1
    seen=$( { [[ -f $plog ]] && wc -l <"$plog"; } || echo 0)   # stages so far are summarised by the line above
    while :; do
        if [[ -f $plog ]]; then
            n=$(wc -l <"$plog")
            if (( n > seen )); then
                while IFS= read -r line; do
                    line=${line//$'\r'/}; line=${line#*\[vmctl\] }
                    [[ -n ${line// } ]] || continue
                    if [[ $line =~ ^STAGE\ ([0-9])/([0-9])\ (.*)$ ]]; then
                        msg "Stage ${BASH_REMATCH[1]} of ${BASH_REMATCH[2]}: ${BASH_REMATCH[3]}"
                    else
                        msg "  $line"
                    fi
                done < <(sed -n "$((seen + 1)),${n}p" "$plog" | { grep -a '\[vmctl\]' || true; })
                seen=$n
                last_beat=$(date +%s)
            fi
        fi
        if (( $(date +%s) - last_ocr >= 30 )) && [[ $(vm_state "$name") == running ]]             && [[ $(current_stage "$name") == "Stage "[123]" "* ]]; then
            local before=$LAST_SCREEN
            report_screen "$name"
            [[ $LAST_SCREEN != "$before" ]] && last_beat=$(date +%s)
            last_ocr=$(date +%s)
        fi
        if (( ! stage2_shown )) && [[ $(current_stage "$name") == "Stage 2 of 6"* ]]; then
            msg "$(current_stage "$name")"
            stage2_shown=1
        fi
        show_events "$name"
        st=$(sed -n 's/^STATUS=//p' "$(vm_env "$name")")
        now=$(date +%s)
        case $st in
            ready)
                show_events "$name"
                follow_boot "$name"
                for (( waited = 0; waited < 18; waited++ )); do
                    show_events "$name"
                    # shellcheck source=/dev/null
                    result=$( . "$(vm_env "$name")"; echo "${SETUP_RESULT-}")
                    [[ -n $result ]] && break
                    (( waited == 0 )) && msg "  Waiting for Windows to confirm the setup result..."
                    sleep 10
                done
                msg ""
                msg "Windows installation of $name is complete after $(( ($(date +%s) - start) / 60 )) minutes."
                msg "Setup result: ${result:-not reported yet (see C:\\vmctl\\setup.log in the VM)}"
                print_connect_hint "$name" "${BOOT_RESULT:-network}"
                break ;;
            install-timeout|install-failed)
                show_events "$name"
                warn "the install did not finish (status $st). Listen in or look with remote-viewer: vmctl viewer $name"
                break ;;
            *)
                if (( ! stuck_warned && now - start > 600 )) && [[ $(vm_state "$name") == running ]]                     && [[ $(current_stage "$name") == "Stage "[12]" "* && $(disk_written_gb "$name") == 0.* ]]; then
                    warn "after 10 minutes almost nothing has been written to the disk, so Windows Setup may have stopped with an error."
                    msg "  Look or listen with remote-viewer: vmctl viewer $name"
                    stuck_warned=1
                fi
                if (( now - last_beat >= 120 )); then
                    msg "  Still working: $(( (now - start) / 60 )) minutes so far, $(disk_written_gb "$name") GB written to the virtual disk, VM is $(vm_state "$name")."
                    last_beat=$now
                fi ;;
        esac
        sleep 10
    done
    trap - INT
}

# Runs under systemd-run: waits for the Windows VM to power itself off at the
# end of setup.ps1, then ejects the install media and starts it for real.
start_watcher() {   # (re)start the background install watcher for a VM
    systemctl reset-failed "vmctl-install-$1" >/dev/null 2>&1 || true
    systemctl is-active -q "vmctl-install-$1" && return 0
    systemd-run --quiet --unit "vmctl-install-$1" --description "vmctl: finish Windows install of $1" \
        "$SELF" _watch-install "$1"
}

setup_reported_done() {   # did setup.ps1 reach its last stage? (it says so over COM1)
    grep -aq 'STAGE 6/6' "$(vm_plog "$1")" 2>/dev/null
}

# Has Windows Setup copied Windows onto the system disk yet? Measured by the
# space the disk image really takes: a blank, partitioned and formatted disk
# takes about 1.3 GB, a copied Windows 10 GB and more.
win_files_copied() {
    local kb; kb=$(du -k "$STORE/disks/$1.qcow2" 2>/dev/null | cut -f1 || true)
    (( ${kb:-0} > 4 * 1048576 ))
}

# Until Windows is on the disk, every boot has to start the installer from
# the DVD, and the firmware only does that after "Press any key to boot from
# CD or DVD". Windows Setup sometimes restarts the VM before it copies any
# files (seen with a 1000 GB disk: it partitions + formats, then reboots);
# nobody answered the prompt and the VM stopped at "No bootable option or
# device was found". So after every restart before the files are copied,
# press Enter for 20 s - only then: on Setup's "Installing Windows" page
# Enter hits Cancel ("Are you sure you want to quit?"). If the firmware gave
# up anyway, reset the VM. After the files are copied no keys are pressed,
# so Setup's own reboot boots from the disk.
press_dvd_prompt() { local i; for (( i = 0; i < 20; i++ )); do "${VIRSH[@]}" send-key "$1" KEY_ENTER >/dev/null 2>&1 || true; sleep 1; done; }

watch_installer_boot() {   # watch_installer_boot NAME   (returns 1 when it gave up)
    local name=$1 next_ocr=0 now txt kicks=0 evf evpid seen=0 n rc=0
    # One listener for the whole phase: separate short listens miss restarts
    # that happen in between (while the screen is being read, for example).
    evf=$(mktemp)
    "${VIRSH[@]}" event "$name" --event reboot --loop >"$evf" 2>/dev/null &
    evpid=$!
    while ! win_files_copied "$name"; do
        [[ $("${VIRSH[@]}" domstate "$name" 2>/dev/null || echo gone) == running ]] || break
        sleep 2
        n=$(grep -c "'reboot'" "$evf" || true)
        if (( ${n:-0} > seen )); then
            win_files_copied "$name" && break
            event "$name" "The VM restarted before Windows was copied onto the disk; pressing Enter so it starts the Windows installer from the DVD again"
            press_dvd_prompt "$name"
            seen=$(grep -c "'reboot'" "$evf" || true)
            next_ocr=$(( $(date +%s) + 30 ))
            continue
        fi
        now=$(date +%s)
        (( now >= next_ocr )) || continue
        next_ocr=$(( now + 20 ))
        txt=$(screen_text "$name" 2>/dev/null | tr '\n' ' ' || true)
        if [[ $txt == *"No bootable"* || $txt == *"Boot Manager"* || $txt == *"Interactive Shell"* \
              || $txt == *"Press any key to boot from CD"* ]]; then
            if (( kicks >= 5 )); then
                event "$name" "The VM still does not start the Windows installer after 5 tries; giving up. Look with remote-viewer: vmctl viewer $name"
                rc=1; break
            fi
            kicks=$((kicks + 1))
            event "$name" "The VM stopped at the firmware without starting the Windows installer. Restarting it and starting the installer from the DVD (try $kicks of 5)"
            "${VIRSH[@]}" reset "$name" >/dev/null 2>&1 || true
            press_dvd_prompt "$name"
            seen=$(grep -c "'reboot'" "$evf" || true)
            next_ocr=$(( $(date +%s) + 30 ))
        fi
    done
    kill "$evpid" 2>/dev/null || true
    wait "$evpid" 2>/dev/null || true
    rm -f "$evf"
    (( rc == 0 )) || return 1
    win_files_copied "$name" || return 0
    event "$name" "Windows Setup has copied Windows onto the system disk ($(disk_used "$STORE/disks/$name.qcow2") so far)"
}

cmd_watch_install() {
    local name=$1 deadline st t src restarts=0 copied=0
    load_vm "$name"
    deadline=$(( $(date +%s) + INSTALL_TIMEOUT_MIN * 60 ))
    event "$name" "Install watcher started: waiting for Windows to power off at the end of setup"
    while :; do
        st=$("${VIRSH[@]}" domstate "$name" 2>/dev/null || echo gone)
        [[ $st == gone ]] && exit 0
        if (( ! copied )) && [[ $st == running ]]; then
            if ! watch_installer_boot "$name"; then set_status "$name" install-failed; exit 1; fi
            if win_files_copied "$name"; then copied=1; fi
            st=$("${VIRSH[@]}" domstate "$name" 2>/dev/null || echo gone)
        fi
        if [[ $st == "shut off" ]]; then
            setup_reported_done "$name" && break
            # Powered off before setup finished (host restart, someone pressed
            # power...): Windows setup carries on from where it was when started.
            if (( restarts >= 5 )); then
                event "$name" "The VM keeps powering off before setup finishes; giving up. Look with remote-viewer: vmctl viewer $name"
                set_status "$name" install-failed; exit 1
            fi
            restarts=$((restarts + 1))
            event "$name" "The VM powered off before Windows setup finished; starting it again so setup can continue"
            "${VIRSH[@]}" start "$name" >/dev/null 2>&1 || true
        fi
        if (( $(date +%s) > deadline )); then
            event "$name" "The install did not finish within $INSTALL_TIMEOUT_MIN minutes"
            set_status "$name" install-timeout; exit 1
        fi
        sleep 15
    done
    event "$name" "The VM powered off at the end of setup"
    while read -r t src; do
        [[ -n $t ]] || continue
        if [[ $src == - ]]; then continue; fi
        event "$name" "Ejecting $(basename "$src") from drive $t"
        "${VIRSH[@]}" change-media "$name" "$t" --eject --config >/dev/null 2>&1 || true
    done < <("${VIRSH[@]}" domblklist "$name" --details | awk '$2=="cdrom" {print $3, $4}')
    load_vm "$name"
    if [[ -n ${SEED:-} && -f $SEED ]]; then
        event "$name" "Deleting the setup disc from the server (it contained the account password)"
        rm -f "$SEED"
    fi
    local d tgt
    for d in ${DATA_DISKS:-}; do
        if tgt=$(attach_data_disk "$name" "${d%%:*}"); then
            event "$name" "Attaching the ${d#*:} GB data disk as $tgt now that Windows is installed"
        else
            event "$name" "Could not attach the data disk ${d%%:*}; add it later with: vmctl disk add $name"
        fi
    done
    event "$name" "Marking the install as complete"
    set_status "$name" ready
    event "$name" "Starting the VM again, now without the install discs"
    "${VIRSH[@]}" start "$name" >/dev/null

    # Read setup.ps1's result through the guest agent so 'vmctl info' can say
    # whether NVDA really got installed.
    local i out=
    event "$name" "Waiting for the guest agent in Windows to answer"
    for (( i = 0; i < 60; i++ )); do agent_up "$name" && break; sleep 10; done
    event "$name" "Reading the setup result from Windows"
    # The agent answers a little before Windows can run programs, so retry.
    for (( i = 0; i < 12; i++ )); do
        out=$(guest_exec "$name" 30 cmd.exe /c 'type C:\vmctl-done.txt' 2>/dev/null | tr -d '\0' | tr -cd '[:print:]') || true
        [[ -n $out ]] && break
        sleep 10
    done
    [[ -n $out ]] || out="unknown (guest agent did not answer; see C:\\vmctl\\setup.log in the VM)"
    echo "SETUP_RESULT=$(printf '%q' "$out")" >>"$(vm_env "$name")"
    event "$name" "Setup result: $out"
    if [[ -n ${SHARE_DIR:-} && -f $SHARE_DIR/nvda-setup.exe && $out == *"NVDA installed: True"* ]]; then
        rm -f "$SHARE_DIR/nvda-setup.exe" "$SHARE_DIR/nvda-version.txt"
        event "$name" "Removed the NVDA installer from the shared folder (the folder stays: $SHARE_DIR)"
    fi
    if [[ -n ${DATA_DISKS:-} ]]; then
        event "$name" "Formatting the data disk inside Windows (NTFS, label Data)"
        out=$(guest_exec "$name" 300 powershell.exe -NoProfile -Command "$(windows_disk_ps)" 2>&1) || true
        if [[ -n $out ]]; then
            while IFS= read -r d; do [[ -n $d ]] && event "$name" "$d"; done <<<"$out"
        else
            event "$name" "No blank data disk found to format (it may already be set up); check with: vmctl disk setup $name"
        fi
    fi
}

# ---------------------------------------------------------------- screen reading
# The host takes a screenshot of the VM and reads its text with OCR
# (tesseract). This is how boot-time messages that only ever appear on the
# screen - disk checks, Automatic Repair, update progress, blue screens,
# Setup errors - reach the terminal.

ocr_available() { command -v tesseract >/dev/null && python3 -c 'import PIL' 2>/dev/null; }

ensure_ocr() {
    ocr_available && return 0
    msg "Installing the screen reader helper (tesseract OCR); details go to /var/log/vmctl-install.log."
    case $(pkg_mgr) in
        apt)    DEBIAN_FRONTEND=noninteractive apt-get install -y -q tesseract-ocr python3-pil ;;
        dnf)    dnf install -y tesseract python3-pillow ;;
        zypper) zypper --non-interactive install tesseract-ocr tesseract-ocr-traineddata-english python3-Pillow ;;
        pacman) pacman -S --needed --noconfirm tesseract tesseract-data-eng python-pillow ;;
    esac >>/var/log/vmctl-install.log 2>&1 || true
    ocr_available || { warn "OCR is not available, so screen text cannot be shown"; return 1; }
}

screen_text() {   # prints the text on the VM's screen, one cleaned line per line
    local name=$1 tmp
    ocr_available || return 1
    tmp=$(mktemp -d)
    if ! "${VIRSH[@]}" screenshot "$name" "$tmp/screen" >/dev/null 2>&1; then rm -rf "$tmp"; return 1; fi
    python3 - "$tmp/screen" <<'PY' || true
import re, subprocess, sys
from PIL import Image, ImageChops, ImageOps
rgb = Image.open(sys.argv[1]).convert("RGB")
rgb = rgb.resize((rgb.width * 2, rgb.height * 2), Image.LANCZOS)
im = rgb.convert("L")
# Only the near-white pixels, as black on white: picks white text (the
# Windows lock-screen clock, for example) off busy wallpapers.
r, g, b = rgb.split()
white = ImageChops.darker(r, ImageChops.darker(g, b)).point(lambda v: 0 if v > 200 else 255)
seen, out = set(), []
# Read the screen as-is, inverted, and as white-text-only: boot screens are
# light text on dark, highlighted menu items are dark on light.
for variant in (im, ImageOps.invert(im), white):
    path = sys.argv[1] + ".png"
    variant.save(path)
    # TSV output gives a confidence (0-100) per word: drop words tesseract is
    # unsure of and lines that are mostly guesses (small or blurry text).
    tsv = subprocess.run(["tesseract", path, "-", "tsv"], capture_output=True, text=True).stdout
    lines = {}
    for row in tsv.splitlines()[1:]:
        f = row.split("\t")
        if len(f) < 12 or f[0] != "5" or not f[11].strip():
            continue
        try:
            conf = float(f[10])
        except ValueError:
            continue
        lines.setdefault((f[2], f[3], f[4]), []).append((conf, f[11].strip()))
    text = []
    for words in lines.values():
        # Drop unsure words first (a spinner glyph before "26% complete", say),
        # then judge the line by what is left.
        kept = [(c, w) for c, w in words if c >= 40]
        if not kept or sum(c for c, _ in kept) / len(kept) < 65:
            continue
        text.append(" ".join(w for _, w in kept))
    for line in text:
        line = " ".join(line.split())
        # A spinner next to "35% complete" is often read as a letter ("Y 35%").
        line = re.sub(r"^\S\s+(?=\d+%)", "", line)
        if not re.search(r"[A-Za-z]{3,}", line) and not re.fullmatch(r"\d{1,2}:\d{2}", line):
            continue                      # logos, icons and stray marks (but keep a clock)
        if sum(c.isalnum() for c in line) < 0.6 * len(line.replace(" ", "")):
            continue                      # mostly symbols: OCR noise
        if len(set(line.replace(" ", "").lower())) <= 3:
            continue                      # "SSS SS SS": a progress bar or border read as letters
        low = line.lower()
        if any(w in low for w in ("bdsdxe", "display output is not active", "firmware development", "tiano", "liano", "\\efi\\", "0x800")):
            continue                      # firmware text; reported from the serial log instead
        key = re.sub(r"[^a-z0-9]", "", line.lower())
        if key and key not in seen:
            seen.add(key)
            out.append(line)
print("\n".join(out))
PY
    rm -rf "$tmp"
}

# Plain-language notes for screens that look scary or stuck but usually are not.
screen_notes() {
    local t=${1,,}
    case $t in
        *"scanning and repairing"*|*chkdsk*|*"checking file system"*|*"disk check"*)
            echo "Windows is checking and repairing the disk. This can take a long time on a big disk; let it finish and do not force the VM off." ;;
    esac
    case $t in
        *"automatic repair"*|*"diagnosing your pc"*|*"attempting repairs"*)
            echo "Windows is running Automatic Repair. If it ends on a blue 'Automatic Repair' or 'Recovery' screen with options, connect with remote-viewer to choose one." ;;
    esac
    case $t in
        *"working on updates"*|*"updates are underway"*|*"don't turn off"*|*"don’t turn off"*|*"do not turn off"*|*"keep your pc on"*|*"configuring updates"*|*"getting windows ready"*)
            echo "Windows is applying updates or finishing setup. This is normal; let it finish." ;;
    esac
    case $t in
        *"ran into a problem"*|*"stop code"*)
            echo "Windows crashed (blue screen). It normally restarts by itself; the stop code above tells you why." ;;
    esac
    case $t in
        *"no bootable"*|*"boot device"*|*"bootmgr is missing"*|*"operating system not found"*)
            echo "The VM cannot find anything to boot from. The disk may be damaged, or the install media may still be needed." ;;
    esac
    case $t in
        *fsck*|*"recovering journal"*)
            echo "Linux is checking the disk (fsck). Let it finish; on a big disk this can take a while." ;;
    esac
    case $t in
        *"emergency mode"*|*"root password for maintenance"*|*"give root password"*)
            echo "Linux stopped in emergency mode. Connect with 'vmctl console' or remote-viewer to fix it (often a disk or /etc/fstab problem)." ;;
    esac
    case $t in
        *"a start job is running"*)
            echo "Linux is waiting for a service to start (usually up to 90 seconds). This is normal if the network or a disk is slow." ;;
    esac
    case $t in
        *"kernel panic"*)
            echo "The Linux kernel crashed (kernel panic). Connect with remote-viewer to read the full message." ;;
    esac
    case $t in
        *error*|*0xc0*|*0x8007*|*failed*)
            echo "There is an error message on the screen (shown above)." ;;
    esac
}

# Lines worth reading out from a scrolling Linux boot log.
IMPORTANT_BOOT='fsck|recovering journal|emergency|root password|maintenance|a start job is running|timed out|kernel panic|\[ *failed *\]|i/o error|corrupt|read-only file system'

# Print the screen text if it changed since last time (state in LAST_SCREEN).
LAST_SCREEN=
LAST_TXT=
LOG_SHOWN=0
SEEN_LINES=
LAST_SHOWN_LINES=
reset_screen_state() { LAST_SCREEN=; LAST_TXT=; LOG_SHOWN=0; SEEN_LINES=; LAST_SHOWN_LINES=; }

report_screen() {   # report_screen NAME [prefix]
    local name=$1 prefix=${2:-"  Screen: "} txt key note total logs imp line k
    txt=$(screen_text "$name") || return 0
    LAST_TXT=$txt
    key=$(tr -cd '[:alnum:]\n' <<<"${txt,,}" | sort | tr -d '\n')   # same lines in another order = same screen
    [[ -n $key && $key != "$LAST_SCREEN" ]] || return 0
    LAST_SCREEN=$key
    # Nothing new if every line was already in the last screen read out (a
    # spinner briefly hiding "83% complete" should not repeat the screen).
    local lines; lines=$(tr -cd '[:alnum:]\n' <<<"${txt,,}" | sed '/^$/d' | sort -u)
    if [[ -n $LAST_SHOWN_LINES ]] && [[ -z $(comm -23 <(printf '%s\n' "$lines") <(printf '%s\n' "$LAST_SHOWN_LINES")) ]]; then
        return 0
    fi
    LAST_SHOWN_LINES=$lines
    total=$(grep -c . <<<"$txt" || true)
    logs=$(grep -Eci '^[[( -]*[0-9?]+ ?\.[0-9]+|systemd(-[a-z]+)?\[|^\[ *(ok|failed|depend) *\]|audit|apparmor|^[a-z0-9_-]+( [0-9a-f:.]+)?: ' <<<"$txt" || true)
    if (( total > 6 && logs * 10 >= total * 4 )); then
        # A scrolling boot log: one summary line, then only the lines that matter.
        if (( ! LOG_SHOWN )); then
            msg "${prefix}Linux boot messages are scrolling by (the kernel and services are starting)."
            LOG_SHOWN=1
        fi
        imp=$(grep -Ei "$IMPORTANT_BOOT" <<<"$txt" | head -n 5 || true)
        while IFS= read -r line; do
            [[ -n $line ]] || continue
            k=$(tr -cd '[:alnum:]' <<<"${line,,}")
            grep -Fqx "$k" <<<"$SEEN_LINES" && continue
            SEEN_LINES+=$k$'\n'
            msg "  Boot message: $line"
        done <<<"$imp"
        [[ -n $imp ]] || return 0
        txt=$imp
        while IFS= read -r note; do
            [[ -n $note && $note != "There is an error message"* ]] && msg "  Note: $note"
        done < <(screen_notes "$txt")
        return 0
    fi
    msg "${prefix}$(head -n 8 <<<"$txt" | paste -sd'|' | sed 's/|/ \/ /g')"
    # The generic "error on screen" note only for short, dialog-like screens.
    while IFS= read -r note; do
        [[ -n $note ]] || continue
        [[ $note == "There is an error message"* ]] && (( total > 12 )) && continue
        msg "  Note: $note"
    done < <(screen_notes "$txt")
}

# Firmware (UEFI) lines from the serial log, in plain words.
firmware_line() {
    local l=$1
    case $l in
        *"BdsDxe: starting"*)
            l=${l#*\"}; msg "  Firmware: starting ${l%%\"*}" ;;
        *"BdsDxe: failed to load"*)
            l=${l#*\"}; l=${l%%\"*}
            case $l in
                *"Misc Device"*|*DVD*|*CDROM*) ;;            # empty or non-bootable drive: normal
                *) msg "  Firmware: could not boot from $l" ;;
            esac ;;
        *"No bootable option"*|*"No bootable device"*)
            msg "  Firmware: no bootable device found"; msg "  Note: the VM has nothing to boot from; the disk may be damaged." ;;
    esac
}

vm_ready() {   # 0 when the guest answers on the network (agent, or its login service port)
    local name=$1 port=22
    [[ $KIND == windows ]] && port=3389
    "${VIRSH[@]}" qemu-agent-command "$name" '{"execute":"guest-ping"}' >/dev/null 2>&1 && return 0
    [[ -n ${IP:-} ]] && timeout 2 bash -c "exec 3<>/dev/tcp/$IP/$port" 2>/dev/null
}

# What kind of login screen is showing, judged from the screen text:
#   windows     Windows lock / sign-in screen (clock + date, or password / sign-in options)
#   linux-gui   graphical Linux login (GDM, LightDM, SDDM...)
#   linux-text  text console "hostname login:" prompt
#   installer   a Linux installer menu or welcome screen
login_kind() {
    local t=${1,,}
    [[ -n $t ]] || return 0
    if [[ $KIND == windows ]]; then
        if grep -Eq '(^|[^0-9])[0-9]{1,2}:[0-9]{2}([^0-9]|$)' <<<"$t" \
            && grep -Eq 'monday|tuesday|wednesday|thursday|friday|saturday|sunday' <<<"$t"; then
            echo windows; return
        fi
        grep -Eq 'password|sign-in options|sign in|other user|(^| )pin( |$)' <<<"$t" && echo windows
        return 0
    fi
    if grep -Eq 'login: *_?$' <<<"$t"; then echo linux-text; return; fi
    # whole-line matches only, so scrolling boot messages ("Starting User Login
    # Management...") are not mistaken for a login screen
    if grep -Eq 'not listed' <<<"$t"         || grep -Eqx '(password:?|log ?in|sign in|username:?|select user|login)' <<<"$t"; then echo linux-gui; return; fi
    if [[ ${MODE:-} == iso ]] && grep -Eq 'install|live|try or install|boot menu|start [a-z]' <<<"$t"; then echo installer; fi
}

print_connect_hint() {   # print_connect_hint NAME KIND-OF-SCREEN
    local name=$1 what=$2 hp label proto gp allow rdp= ssh=
    load_vm "$name"
    if [[ -f $(vm_fwd "$name") ]]; then
        while read -r proto hp gp allow label; do
            [[ ${proto:-} == tcp && $label == rdp ]] && rdp=$hp
            [[ ${proto:-} == tcp && $label == ssh ]] && ssh=$hp
        done <"$(vm_fwd "$name")"
    fi
    msg ""
    case $what in
        windows)
            msg "The Windows sign-in screen is showing on $name. You can sign in now:"
            msg "  Remote Desktop: $PUBLIC_HOST:${rdp:-?}  user .\\${USERNAME:-your-user}"
            msg "  Type the user name with .\\ in front, or Windows may reject it as a Microsoft account."
            msg "  NVDA speaks on the sign-in screen and after you sign in."
            msg "  Or use remote-viewer with $(vm_vv "$name")"
            viewer_win_hint ;;
        linux-gui)
            msg "A graphical login screen is showing on $name. Sign in with remote-viewer:"
            msg "  open $(vm_vv "$name")  (or remote-viewer spice://$PUBLIC_HOST:$SPICE_PORT, password $SPICE_PASS)"
            msg "  On GNOME, press Super+Alt+S to turn the Orca screen reader on or off."
            viewer_win_hint
            [[ -n $ssh ]] && msg "  SSH also works if it is installed: ssh -p $ssh ${USERNAME:-user}@$PUBLIC_HOST"
            return 0 ;;
        linux-text)
            msg "A text login prompt is showing on $name. Sign in with:"
            [[ -n $ssh ]] && msg "  SSH: ssh -p $ssh ${USERNAME:-user}@$PUBLIC_HOST"
            msg "  the serial console on this server: vmctl console $name"
            msg "  or remote-viewer: $(vm_vv "$name")"
            viewer_win_hint ;;
        installer)
            msg "The installer is on $name's screen. Connect with remote-viewer to install:"
            msg "  open $(vm_vv "$name")  (or remote-viewer spice://$PUBLIC_HOST:$SPICE_PORT, password $SPICE_PASS)"
            msg "  Sound is on, so speech-enabled installers will talk to you there."
            viewer_win_hint ;;
        network)
            msg "$name is answering on the network, but no sign-in screen was recognised (the screen may be blank)."
            [[ -n $rdp ]] && msg "  Remote Desktop: $PUBLIC_HOST:$rdp  user .\\${USERNAME:-your-user}"
            [[ -n $ssh ]] && msg "  SSH: ssh -p $ssh ${USERNAME:-user}@$PUBLIC_HOST"
            [[ $KIND == linux ]] && msg "  serial console on this server: vmctl console $name"
            msg "  remote-viewer: $(vm_vv "$name")"
            viewer_win_hint ;;
    esac
}

# Follow a running VM until a login / sign-in screen (or installer) shows,
# reading out firmware messages, screen text and notes on the way.
# Sets BOOT_RESULT to the kind of screen found ("" on timeout / power-off).
BOOT_RESULT=
BOOT_STALE_KEY=   # screen before a reboot: not a sign-in screen until the screen has changed
follow_boot() {   # follow_boot NAME [SECONDS]
    local name=$1 limit=${2:-$((BOOT_WATCH_MIN * 60))}
    local plog seen start now last_news last_ocr=0 st line n ready_since=0 kind stale=$BOOT_STALE_KEY
    load_vm "$name"
    BOOT_RESULT=
    plog=$(vm_plog "$name")
    seen=$( { [[ -f $plog ]] && wc -l <"$plog"; } || echo 0)
    start=$(date +%s); last_news=$start
    reset_screen_state
    while :; do
        now=$(date +%s)
        st=$(vm_state "$name")
        case $st in
            running) ;;
            "shut off") msg "$name has powered off."; return 0 ;;
            paused)  msg "$name is paused (for example because the host disk is full)."; return 0 ;;
            crashed) msg "$name crashed. Try: vmctl start $name"; return 0 ;;
        esac
        show_events "$name"
        if [[ -f $plog ]]; then
            n=$(wc -l <"$plog")
            if (( n > seen )); then
                while IFS= read -r line; do
                    if [[ $line == *"[vmctl]"* ]]; then msg "  ${line#*\[vmctl\] }"; else firmware_line "$line"; fi
                done < <(sed -n "$((seen + 1)),${n}p" "$plog" | tr -d '\r\033' | sed 's/\[[0-9;=]*[A-Za-z]//g')
                seen=$n; last_news=$now
            fi
        fi
        if (( now - last_ocr >= 5 )); then
            local before=$LAST_SCREEN
            report_screen "$name"
            [[ $LAST_SCREEN != "$before" ]] && last_news=$now
            last_ocr=$now
            [[ -n $stale && -n $LAST_SCREEN && $LAST_SCREEN != "$stale" ]] && stale=
            kind=$(login_kind "$LAST_TXT")
            if [[ -z $stale && -n $kind ]]; then BOOT_RESULT=$kind; return 0; fi
        fi
        if [[ -z $stale ]] && (( ready_since == 0 )) && vm_ready "$name"; then
            ready_since=$now
            msg "  $name is answering on the network; waiting for the sign-in screen."
            ocr_available || { BOOT_RESULT=network; return 0; }
        fi
        if (( ready_since && now - ready_since >= 120 )); then BOOT_RESULT=network; return 0; fi
        if (( now - last_news >= 60 )); then
            msg "  Still booting: $(( (now - start) / 60 )) minutes so far, nothing new on the screen."
            last_news=$now
        fi
        if (( now - start >= limit )); then
            msg "$name has not reached a sign-in screen after $(( limit / 60 )) minutes. The last screen text is above."
            msg "Keep watching with: vmctl boot $name --minutes 60   or look with remote-viewer: vmctl viewer $name"
            return 0
        fi
        sleep 2
    done
}

# vmctl boot NAME [--minutes N]: start if needed, then follow until sign-in.
cmd_boot() {
    local name=${1-}; [[ -n $name ]] || die "usage: vmctl boot NAME [--minutes N]"
    shift
    local limit=$((BOOT_WATCH_MIN * 60)) t0
    [[ ${1-} == --minutes ]] && limit=$(( ${2:?minutes} * 60 ))
    load_vm "$name"
    ensure_ocr || true
    if [[ $(vm_state "$name") != running ]]; then
        "${VIRSH[@]}" start "$name" >/dev/null || die "could not start $name"
        msg "Started $name."
    fi
    trap 'echo; msg "Stopped watching. $name keeps running."; exit 0' INT
    events_mark "$name"
    msg "Following the boot of $name until a sign-in screen shows. Screen text is read out as it changes. Ctrl+C stops watching."
    t0=$(date +%s)
    follow_boot "$name" "$limit"
    [[ -n $BOOT_RESULT ]] && { msg "  (boot took $(( $(date +%s) - t0 )) seconds)"; print_connect_hint "$name" "$BOOT_RESULT"; }
    trap - INT
}

# Reset a user's password inside the VM through the QEMU guest agent.
cmd_password() {   # vmctl password NAME [USER] [--password PASS]
    local name=${1-} user= pass= b64 r
    [[ -n $name ]] || die "usage: vmctl password NAME [USER] [--password PASS]"
    shift
    while (( $# )); do
        case $1 in
            --password) pass=$2; shift ;;
            *) user=$1 ;;
        esac
        shift
    done
    load_vm "$name"
    [[ $(vm_state "$name") == running ]] || die "$name must be running (vmctl start $name)"
    "${VIRSH[@]}" qemu-agent-command "$name" '{"execute":"guest-ping"}' >/dev/null 2>&1 \
        || die "the guest agent in $name is not answering, so the password cannot be changed from here"
    [[ -n $user ]] || user=${USERNAME:-}
    [[ -n $user ]] || ask user "User name whose password to reset"
    [[ -n $pass ]] || ask_secret pass "New password for $user"
    b64=$(printf '%s' "$pass" | base64 -w0)
    if ! r=$("${VIRSH[@]}" qemu-agent-command "$name" \
            "$(jq -nc --arg u "$user" --arg p "$b64" '{execute:"guest-set-user-password",arguments:{username:$u,password:$p,crypted:false}}')" 2>&1); then
        die "could not change the password: $r"
    fi
    msg "The password for $user on $name has been changed."
    [[ $KIND == windows ]] && msg "Sign in with Remote Desktop as .\\$user (the .\\ means the account on that VM)."
    return 0
}

cmd_screen() {
    local name=${1-} txt; [[ -n $name ]] || die "usage: vmctl screen NAME"
    load_vm "$name"
    [[ $(vm_state "$name") == running ]] || die "$name is not running"
    ensure_ocr || exit 1
    txt=$(screen_text "$name") || die "could not take a screenshot of $name"
    if [[ -z $txt ]]; then
        msg "No readable text on $name's screen (it may be blank, a logo, or a picture)."
    else
        msg "Text on $name's screen:"
        sed 's/^/  /' <<<"$txt"
        local note; while IFS= read -r note; do [[ -n $note ]] && msg "Note: $note"; done < <(screen_notes "$txt")
    fi
}

cmd_start() {   # vmctl start NAME [--no-watch]
    local name=${1:?usage: vmctl start NAME [--no-watch]}
    load_vm "$name"
    if [[ ${2-} == --no-watch ]]; then
        "${VIRSH[@]}" start "$name" >/dev/null; msg "Started $name."
    else
        cmd_boot "$name"
    fi
}

cmd_reboot() {   # vmctl reboot NAME [--no-watch]
    local name=${1:?usage: vmctl reboot NAME [--no-watch]} i
    load_vm "$name"
    BOOT_STALE_KEY=$(screen_text "$name" 2>/dev/null | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]') || true
    "${VIRSH[@]}" reboot "$name" >/dev/null
    msg "Asked $name to restart."
    [[ ${2-} == --no-watch ]] && return 0
    # Wait for the guest to go away first, or the old session would count as "booted".
    for (( i = 0; i < 90; i++ )); do vm_ready "$name" || break; sleep 2; done
    cmd_boot "$name"
}

# ---------------------------------------------------------------- other commands
vm_state() { "${VIRSH[@]}" domstate "$1" 2>/dev/null || echo "missing"; }

cmd_list() {
    local e name n=0
    for e in "$VMS_DIR"/*.env; do
        name=$(basename "$e" .env)
        ( load_vm "$name"
          local ports="SPICE port $SPICE_PORT" proto hp gp allow label
          if [[ -f $(vm_fwd "$name") ]]; then
              while read -r proto hp gp allow label; do
                  [[ -n ${proto:-} && ${proto:0:1} != '#' ]] || continue
                  case $label in rdp) [[ $proto == tcp ]] && ports+=", RDP port $hp" ;; ssh) ports+=", SSH port $hp" ;;
                      *) ports+=", forward $proto $hp to $gp" ;; esac
              done <"$(vm_fwd "$name")"
          fi
          local extra=
          [[ $STATUS == installing ]] && extra=" Install progress: $(current_stage "$name")."
          msg "$name: $(vm_state "$name"), $OS_LABEL, status $STATUS, address $IP, $ports, $(snap_count "$name") snapshots.$extra" )
        n=$((n + 1))
    done
    (( n )) || msg "No VMs yet. Create one with: vmctl create"
}

cmd_info() {
    local name=$1 proto hp gp allow label
    load_vm "$name"
    msg "$name ($OS_LABEL): $(vm_state "$name"), install status $STATUS"
    msg "  RAM $((RAM_MB / 1024)) GB, $CPUS cores, disk $DISK_GB GB ($(disk_used "$DISK") used on the server), private address $IP"
    [[ -n ${SETUP_RESULT:-} ]] && msg "  Windows setup: $SETUP_RESULT"
    [[ $STATUS == installing ]] && msg "  Install progress: $(current_stage "$name")  (follow it with: vmctl progress $name)"
    msg "  remote-viewer: open $(vm_vv "$name")"
    msg "    or run: remote-viewer spice://$PUBLIC_HOST:$SPICE_PORT  (password $SPICE_PASS)"
    msg "    remote-viewer for Windows: $VIEWER_WIN_URL"
    grep -q '^SPICE_CLOSED=1' "$(vm_env "$name")" && msg "    (the remote-viewer port is currently closed in the firewall; vmctl viewer $name --open)"
    if [[ -f $(vm_fwd "$name") ]]; then
        while read -r proto hp gp allow label; do
            [[ -n ${proto:-} && ${proto:0:1} != '#' ]] || continue
            case $label in
                rdp) [[ $proto == tcp ]] && msg "  Remote Desktop: $PUBLIC_HOST:$hp  (user .\\${USERNAME:-?}, with the .\\ in front)" ;;
                ssh) msg "  SSH: ssh -p $hp ${USERNAME:-user}@$PUBLIC_HOST" ;;
                *)   msg "  Forward: $PUBLIC_HOST:$hp $proto -> VM port $gp (allowed: $allow)" ;;
            esac
        done <"$(vm_fwd "$name")"
    fi
    [[ $KIND == linux ]] && msg "  Serial console on this server: vmctl console $name"
    local d
    for d in ${DATA_DISKS:-}; do
        if [[ $KIND == windows ]]; then msg "  Data disk ${d%%:*}: ${d#*:} GB ($(disk_used "$(data_disk_path "$name" "${d%%:*}")") used on the server, drive labelled Data in Windows)"
        else msg "  Data disk ${d%%:*}: ${d#*:} GB ($(disk_used "$(data_disk_path "$name" "${d%%:*}")") used on the server), mounted at $(data_disk_mount "${d%%:*}")"; fi
    done
    [[ -n ${SHARE_DIR:-} ]] && msg "  Shared folder: $SHARE_DIR on this server, $(share_where)"
    msg "  Starts automatically with the server: ${AUTOSTART:-yes}"
    local sc newest; sc=$(snap_count "$name"); newest=$(snap_names "$name" | tail -1)
    msg "  Snapshots: $sc${newest:+ (newest: $newest)}, daily ${SNAP_AUTO:-yes} at $SNAP_TIME keeping ${SNAP_KEEP:-$SNAP_KEEP_DEFAULT}, owner: ${OWNER:-none (root only)}"
    msg "  Allowed to connect: $ALLOW"
}

cmd_viewer() {
    local name=${1-}; [[ -n $name ]] || die "usage: vmctl viewer NAME [--out FILE | --print | --new-password | --open | --close]"
    shift
    load_vm "$name"
    local out= action=write
    while (( $# )); do
        case $1 in
            --out) out=$2; shift ;;
            --print) action=print ;;
            --new-password) action=rotate ;;
            --open) action=open ;;
            --close) action=close ;;
            *) die "unknown option $1" ;;
        esac
        shift
    done
    case $action in
        rotate)
            SPICE_PASS=$(rand_pass 12)
            local x; x=$(mktemp)
            "${VIRSH[@]}" dumpxml "$name" | awk '/<graphics type=.spice./,/<\/graphics>/' >"$x"
            sed -i -E "s/passwd='[^']*'/passwd='$SPICE_PASS'/" "$x"
            grep -q "passwd=" "$x" || sed -i -E "0,/<graphics /s//<graphics passwd='$SPICE_PASS' /" "$x"
            if [[ $(vm_state "$name") == running ]]; then "${VIRSH[@]}" update-device "$name" "$x" --live --config >/dev/null
            else "${VIRSH[@]}" update-device "$name" "$x" --config >/dev/null; fi
            rm -f "$x"
            sed -i "s/^SPICE_PASS=.*/SPICE_PASS=$SPICE_PASS/" "$(vm_env "$name")"
            write_vv "$name"
            msg "New remote-viewer password set; old .vv files no longer work. New file: $(vm_vv "$name")" ;;
        close)
            fw_vm_del "$name" spice
            grep -q '^SPICE_CLOSED=1' "$(vm_env "$name")" || echo SPICE_CLOSED=1 >>"$(vm_env "$name")"
            apply_forwards
            msg "remote-viewer port $SPICE_PORT for $name is now closed in the firewall." ;;
        open)
            sed -i '/^SPICE_CLOSED=1/d' "$(vm_env "$name")"
            fw_vm_add "$name"; apply_forwards
            msg "remote-viewer port $SPICE_PORT for $name is open again." ;;
        print) write_vv "$name"; cat "$(vm_vv "$name")" ;;
        write)
            write_vv "$name"
            if [[ -n $out ]]; then install -m 600 "$(vm_vv "$name")" "$out"; msg "Wrote $out"
            else msg "Wrote $(vm_vv "$name")"; fi
            msg "Copy it to your computer, for example:"
            local sp; sp=$(sshd -T 2>/dev/null | awk '$1 == "port" {print $2; exit}' || true)
            [[ ${sp:-22} == 22 ]] && sp= || sp="-P $sp "
            msg "  scp ${sp}root@$PUBLIC_HOST:${out:-$(vm_vv "$name")} ."
            msg "then open it with remote-viewer (virt-viewer)."
            viewer_win_hint ;;
    esac
}

cmd_forward() {
    local sub=${1-}; shift || true
    case $sub in
        add)
            local name=${1-} hp=${2-} gp=${3-} proto=tcp allow=
            [[ -n $name && -n $hp && -n $gp ]] || die "usage: vmctl forward add NAME HOSTPORT|auto GUESTPORT [tcp|udp|both] [--allow LIST]"
            shift 3
            while (( $# )); do
                case $1 in tcp|udp|both) proto=$1 ;; --allow) allow=$2; shift ;; *) die "unknown option $1" ;; esac
                shift
            done
            load_vm "$name"
            [[ -n $allow ]] || allow=$ALLOW
            valid_allow "$allow" || die "bad --allow"
            allow=$(split_allow "$allow" | paste -sd, -)
            [[ $gp =~ ^[0-9]+$ ]] && (( gp >= 1 && gp <= 65535 )) || die "guest port must be 1-65535"
            if [[ $hp == auto ]]; then hp=$(next_port 20000)
            else
                [[ $hp =~ ^[0-9]+$ ]] && (( hp >= 1 && hp <= 65535 )) || die "host port must be 1-65535 or auto"
                port_free "$hp" || die "host port $hp is already in use on this server or by another VM"
            fi
            local p ps=("$proto"); [[ $proto == both ]] && ps=(tcp udp)
            for p in "${ps[@]}"; do echo "$p $hp $gp $allow fwd" >>"$(vm_fwd "$name")"; done
            fw_vm_add "$name"; apply_forwards
            msg "Forwarding $PUBLIC_HOST port $hp ($proto) to $name port $gp. Allowed: $allow" ;;
        del|delete|remove)
            local name=${1-} hp=${2-} proto=${3-}
            [[ -n $name && -n $hp ]] || die "usage: vmctl forward del NAME HOSTPORT [tcp|udp]"
            load_vm "$name"
            local f; f=$(vm_fwd "$name")
            awk -v hp="$hp" -v pr="$proto" '!/^#/ && $2==hp && (pr=="" || $1==pr) {found=1} END {exit !found}' "$f" \
                || die "$name has no forward on host port $hp"
            awk -v hp="$hp" -v pr="$proto" '/^#/ || !($2==hp && (pr=="" || $1==pr))' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
            fw_vm_del "$name" "(tcp|udp):$hp"
            fw_vm_add "$name"; apply_forwards
            msg "Removed forward of port $hp from $name." ;;
        list|"")
            local name=${1-} f any=0 proto hp gp allow label
            for f in "$VMS_DIR"/*.fwd; do
                [[ -z $name || $(basename "$f" .fwd) == "$name" ]] || continue
                while read -r proto hp gp allow label; do
                    [[ -n ${proto:-} && ${proto:0:1} != '#' ]] || continue
                    msg "$(basename "$f" .fwd): host port $hp $proto to VM port $gp ($label), allowed: $allow"; any=1
                done <"$f"
            done
            (( any )) || msg "No port forwards." ;;
        *) die "usage: vmctl forward add|del|list ..." ;;
    esac
}

cmd_disk() {   # vmctl disk add|setup|list|help NAME ...
    local sub=${1-} name=${2-}
    [[ -n $sub && -n $name ]] || die "usage: vmctl disk add NAME SIZE | setup NAME | list NAME | help NAME"
    load_vm "$name"
    case $sub in
        add)
            local size_in=${3-} gb id n=1 path target t xml free_gb
            [[ -n $size_in ]] || ask size_in "Size of the new data disk, for example 100G"
            gb=$(to_gb "$size_in") && (( gb >= 1 )) || die "please give a size like 100G"
            free_gb=$(( $(df -Pk "$STORE" | awk 'NR==2 {print $4}') / 1048576 ))
            (( gb <= free_gb )) || { warn "$gb GB requested but only $free_gb GB is free in $STORE"; confirm "Disks only use space as data is written." || die "cancelled"; }
            while [[ " ${DATA_DISKS:-} " == *" data$n:"* ]]; do n=$((n + 1)); done
            id=data$n; path=$(data_disk_path "$name" "$id")
            make_disk "$path" "$gb" "data disk"
            set_env "$name" DATA_DISKS "${DATA_DISKS:+$DATA_DISKS }$id:$gb"
            if [[ $STATUS == installing && $KIND == windows ]]; then
                # Never during Windows Setup: it could pick this disk to install on.
                msg "It will be attached and formatted as a Data drive as soon as Windows has finished installing."
                return 0
            fi
            if [[ $(vm_state "$name") == running ]]; then
                msg "Attaching it to the running VM (and to its saved settings, so it stays after restarts)"
            else
                msg "Attaching it to the VM's saved settings (it will be there from the next start)"
            fi
            target=$(attach_data_disk "$name" "$id") || { rm -f "$path"; set_env "$name" DATA_DISKS "${DATA_DISKS:-}"; die "attaching the disk failed"; }
            msg "Attached as $target"
            if [[ $(vm_state "$name") == running ]] && agent_up "$name"; then
                msg "Formatting and mounting it inside the VM:"
                setup_data_disks_in_guest "$name" || { warn "could not set it up automatically"; manual_disk_help "$name"; }
            else
                msg "When the VM is running (with its guest agent), run: vmctl disk setup $name"
            fi ;;
        setup)
            [[ $(vm_state "$name") == running ]] || die "$name must be running (vmctl start $name)"
            if ! agent_up "$name"; then
                warn "the guest agent in $name is not answering, so this cannot be done from here."
                manual_disk_help "$name"
                return 0
            fi
            msg "Formatting (only blank disks) and mounting the data disks inside $name:"
            setup_data_disks_in_guest "$name" || { warn "setting up the data disks failed (see the message above)"; manual_disk_help "$name"; } ;;
        list)
            local d
            [[ -n ${DATA_DISKS:-} ]] || { msg "$name has no data disks."; return 0; }
            for d in $DATA_DISKS; do
                if [[ $KIND == windows ]]; then msg "${d%%:*}: ${d#*:} GB, $(data_disk_path "$name" "${d%%:*}") (drive labelled Data in Windows)"
                else msg "${d%%:*}: ${d#*:} GB, $(data_disk_path "$name" "${d%%:*}"), mounted at $(data_disk_mount "${d%%:*}")"; fi
            done ;;
        grow|resize)
            local id=${3-} size=${4-}
            [[ -n $id && -n $size ]] || die "usage: vmctl disk grow NAME system|data1|data2... SIZE  (for example: vmctl disk grow $name system 200G)"
            shift 4
            if [[ $id == system ]]; then cmd_edit "$name" --disk "$size" "$@"
            else cmd_edit "$name" --data-disk "$id=$size" "$@"; fi ;;
        expand) expand_guest_flow "$name" ;;
        help) manual_disk_help "$name" ;;
        *) die "usage: vmctl disk add NAME SIZE | grow NAME ID SIZE | expand NAME | setup NAME | list NAME | help NAME" ;;
    esac
}

# ---------------------------------------------------------------- edit (RAM, CPUs, disk sizes)
# Disks only grow: qemu-img/blockresize make the qcow2 bigger (it stays thin,
# taking space only as the VM writes), then the guest agent grows the
# partition and filesystem inside the VM so the space can be used.

disk_vsize_gb() {   # disk_vsize_gb FILE -> virtual size in GB (rounded down)
    local b
    b=$(qemu-img info -U --output=json "$1" 2>/dev/null | jq -r '."virtual-size" // empty') || return 1
    [[ -n $b ]] || return 1
    echo $(( b / 1073741824 ))
}

disk_target() {   # disk_target NAME FILE -> vda, vdb... (as the VM sees it now)
    "${VIRSH[@]}" domblklist "$1" 2>/dev/null | awk -v p="$2" '$2 == p {print $1; f = 1; exit} END {exit !f}'
}

data_disk_gb() {   # data_disk_gb ID (VM loaded) -> size in the record, or nothing
    local d
    for d in ${DATA_DISKS:-}; do [[ ${d%%:*} == "$1" ]] && { echo "${d#*:}"; return 0; }; done
    return 1
}

all_vm_disks_gb() {   # what every vmctl disk together could grow to
    local e total=0
    for e in "$VMS_DIR"/*.env; do
        total=$(( total + $( ( load_vm "$(basename "$e" .env)"; t=${DISK_GB:-0}
                              for d in ${DATA_DISKS:-}; do t=$(( t + ${d#*:} )); done; echo "$t" ) ) ))
    done
    echo "$total"
}

# grow_disk NAME ID GB (VM loaded): make the disk image bigger and update the record.
grow_disk() {
    local name=$1 id=$2 gb=$3 path target what d new=
    path=$(disk_of "$name" "$id")
    [[ -f $path ]] || die "the disk file $path is missing"
    what="system disk"; [[ $id == system ]] || what="data disk $id"
    if [[ $(vm_state "$name") == running ]]; then
        target=$(disk_target "$name" "$path") || die "cannot find the $what in the running $name"
        "${VIRSH[@]}" blockresize "$name" "$target" "${gb}G" >/dev/null || die "growing the $what failed"
        msg "Grew the $what to $gb GB while $name is running (it sees the bigger disk at once)."
    else
        qemu-img resize -q "$path" "${gb}G" || die "growing the $what failed"
        msg "Grew the $what to $gb GB."
    fi
    msg "  It takes $(disk_used "$path") on the server now and only grows as data is written."
    if [[ $id == system ]]; then
        set_env "$name" DISK_GB "$gb"; DISK_GB=$gb
    else
        for d in ${DATA_DISKS:-}; do
            if [[ ${d%%:*} == "$id" ]]; then new+=" $id:$gb"; else new+=" $d"; fi
        done
        new=${new# }; set_env "$name" DATA_DISKS "$new"; DATA_DISKS=$new
    fi
    event "$name" "Grew the $what to $gb GB"
}

# PowerShell: grow every lettered partition to the end of its disk (C: is the
# last partition, Data drives are the only partition on their disk).
windows_expand_ps() {
    cat <<'EOF'
$ProgressPreference = 'SilentlyContinue'
$script:bad = 0
Update-HostStorageCache
Get-Partition | Where-Object { "$($_.DriveLetter)" -match '^[A-Z]$' } | ForEach-Object {
    $p = $_
    try {
        $s = Get-PartitionSupportedSize -DiskNumber $p.DiskNumber -PartitionNumber $p.PartitionNumber -ErrorAction Stop
        if ($s.SizeMax -gt $p.Size + 100MB) {
            Resize-Partition -DiskNumber $p.DiskNumber -PartitionNumber $p.PartitionNumber -Size $s.SizeMax -ErrorAction Stop
            "drive $($p.DriveLetter): grown from $([math]::Round($p.Size / 1GB)) GB to $([math]::Round($s.SizeMax / 1GB)) GB"
        } else {
            "drive $($p.DriveLetter): already uses its whole disk ($([math]::Round($p.Size / 1GB)) GB)"
        }
    } catch {
        "drive $($p.DriveLetter): could not be grown: $($_.Exception.Message)"
        $script:bad = 1
    }
}
exit $script:bad
EOF
}

# POSIX sh run inside a Linux guest: grows the partition (plain or LVM) under /
# and its filesystem, plus the data disks given as arguments. Changes nothing
# when the root partition is not the last one on its disk, or is encrypted.
linux_expand_script() {
    cat <<'EOF'
bad=0
say() { echo "$*"; }
grow_part() {   # grow_part DEVICE: grow a partition to the end of its disk
    dev=$(readlink -f "$1"); n=$(basename "$dev")
    [ -e "/sys/class/block/$n/partition" ] || return 0          # a whole disk
    num=$(cat "/sys/class/block/$n/partition")
    dn=$(basename "$(readlink -f "/sys/class/block/$n/..")"); disk=/dev/$dn
    start=$(cat "/sys/class/block/$n/start")
    for s in /sys/class/block/"$dn"/"$dn"*/start; do
        if [ "$(cat "$s")" -gt "$start" ]; then
            say "$dev is not the last partition on $disk (another one, often swap, comes after it), so it cannot be grown automatically."
            return 1
        fi
    done
    if command -v growpart >/dev/null 2>&1; then
        out=$(growpart "$disk" "$num" 2>&1) || { case $out in *NOCHANGE*) return 0 ;; esac; say "$out"; return 1; }
    else
        sfdisk --relocate gpt-bak-std "$disk" >/dev/null 2>&1 || true
        echo ', +' | sfdisk --force --no-reread -N "$num" "$disk" >/dev/null 2>&1 || { say "sfdisk could not grow $dev"; return 1; }
        partx -u "$disk" 2>/dev/null || partprobe "$disk" 2>/dev/null || true
    fi
    say "partition $dev now reaches the end of $disk"
}
grow_fs() {   # grow_fs DEVICE MOUNTPOINT TYPE
    case $3 in
        ext2|ext3|ext4) resize2fs "$1" >/dev/null 2>&1 || { say "resize2fs $1 failed"; return 1; } ;;
        xfs) xfs_growfs "$2" >/dev/null 2>&1 || { say "xfs_growfs $2 failed"; return 1; } ;;
        btrfs) btrfs filesystem resize max "$2" >/dev/null 2>&1 || { say "btrfs resize of $2 failed"; return 1; } ;;
        *) say "the $3 filesystem on $2 cannot be grown automatically"; return 1 ;;
    esac
}
src=$(findmnt -no SOURCE / | sed 's/\[.*//'); fs=$(findmnt -no FSTYPE /)
if lvs --noheadings -o vg_name "$src" >/dev/null 2>&1; then
    vg=$(lvs --noheadings -o vg_name "$src" | tr -d ' ')
    for pv in $(pvs --noheadings -o pv_name -S vg_name="$vg" | tr -d ' '); do
        case $(basename "$(readlink -f "$pv")") in dm-*) say "the disk under / is encrypted, so it cannot be grown automatically"; bad=1; continue ;; esac
        grow_part "$pv" && pvresize "$pv" >/dev/null 2>&1 || bad=1
    done
    out=$(lvextend -r -l +100%FREE "$src" 2>&1) || case $out in *"matches existing size"*|*"not larger than existing"*) ;; *) say "$out"; bad=1 ;; esac
else
    case $(basename "$(readlink -f "$src")") in
        dm-*) say "/ is on an encrypted or mapped device, so it cannot be grown automatically"; bad=1 ;;
        *) if grow_part "$src"; then grow_fs "$src" / "$fs" || bad=1; else bad=1; fi ;;
    esac
fi
say "/ is now $(df -h --output=size / | tail -n1 | tr -d ' ') ($(df -h --output=avail / | tail -n1 | tr -d ' ') free)"
for id in "$@"; do
    dev=/dev/disk/by-id/virtio-vmctl-$id
    [ -e "$dev" ] || { say "data disk $id is not attached"; continue; }
    t=$(blkid -o value -s TYPE "$dev" 2>/dev/null || true)
    [ -n "$t" ] || { say "data disk $id is not formatted yet (run: vmctl disk setup)"; continue; }
    mnt=$(findmnt -no TARGET "$dev" | head -n1)
    [ -n "$mnt" ] || { say "data disk $id is not mounted"; continue; }
    grow_fs "$dev" "$mnt" "$t" && say "data disk $id at $mnt is now $(df -h --output=size "$mnt" | tail -n1 | tr -d ' ')" || bad=1
done
exit $bad
EOF
}

expand_in_guest() {   # expand_in_guest NAME (VM loaded, running, agent up) -> 1 when something failed
    local name=$1 out d ids=() rc=0
    if [[ $KIND == windows ]]; then
        out=$(guest_exec "$name" 900 powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand "$(windows_expand_ps | ps_encode)") || rc=1
        out=$(grep -v -e '^#< CLIXML' -e '^<Objs ' <<<"$out" || true)
    else
        for d in ${DATA_DISKS:-}; do ids+=("${d%%:*}"); done
        out=$(guest_exec "$name" 600 /bin/sh -c "$(linux_expand_script)" sh "${ids[@]}") || rc=1
    fi
    [[ -n $out ]] && sed 's/^/  /' <<<"$out"
    (( rc == 0 )) && event "$name" "Grew the partitions inside the VM to use the new disk space"
    return "$rc"
}

manual_expand_help() {
    if [[ $KIND == windows ]]; then
        msg "  In Windows: open Disk Management (diskmgmt.msc), choose drive C: (or the Data drive), then Extend Volume, and accept the maximum size."
    else
        msg "  Inside the VM, as root: grow the partition with growpart (for example: growpart /dev/vda 1),"
        msg "  then the filesystem: resize2fs (ext4), xfs_growfs / (XFS) or btrfs filesystem resize max / ."
        msg "  With LVM: pvresize the partition, then lvextend -r -l +100%FREE on the root volume."
    fi
}

# Grow partitions/filesystems inside the VM, offering to start it first.
expand_guest_flow() {   # expand_guest_flow NAME
    local name=$1
    load_vm "$name"
    [[ $STATUS == installing ]] && die "$name is still installing; try again when it has finished"
    step "Letting $name use the new disk space (growing its partitions inside the VM)"
    if [[ $(vm_state "$name") != running ]]; then
        if (( INTERACTIVE )) && yes_no "$name is off. Start it now so the space can be added inside it?"; then
            "${VIRSH[@]}" start "$name" >/dev/null || die "could not start $name"
            msg "Started $name."
        else
            msg "When $name is running, run: vmctl disk expand $name"
            return 0
        fi
    fi
    if ! agent_up "$name"; then
        msg "Waiting for the guest agent in $name (up to 10 minutes)."
        if ! share_wait_agent "$name"; then
            warn "the guest agent in $name is not answering, so this cannot be done from here."
            manual_expand_help; return 1
        fi
    fi
    if expand_in_guest "$name"; then msg "Done: $name can use the new space."
    else warn "not everything could be grown inside $name (see above)"; manual_expand_help; return 1; fi
}

usage_edit() {
    cat <<'EOF'
vmctl edit NAME [options]         (no options: a numbered menu asks what to change)
  --ram SIZE           memory, e.g. 16G or 12288M
  --cpus N             CPU cores
  --disk SIZE          new size of the system disk, e.g. 200G
  --data-disk ID=SIZE  new size of a data disk, e.g. data1=500G (see: vmctl disk list NAME)
  --restart            if the VM is running, restart it now so new RAM/CPUs take effect
  --no-restart         keep it running; new RAM/CPUs take effect at its next start
  -y, --yes            do not ask for confirmation
Disks can only grow (shrinking would destroy data). They stay thin: growing one takes no
space on the server until the VM writes data. Afterwards vmctl grows the partition and
filesystem inside the VM (Windows: C: and the Data drive; Linux: / and /data) through the
guest agent. If the VM is off it offers to start it; or later run: vmctl disk expand NAME
EOF
}

cmd_edit() {   # vmctl edit NAME [--ram SIZE] [--cpus N] [--disk SIZE] [--data-disk ID=SIZE]... [--restart|--no-restart] [-y]
    local name= ram_in= cpus_in= disk_in= restart= yes=0 dd=() x
    while (( $# )); do
        case $1 in
            --ram) ram_in=${2:?--ram needs a size}; shift ;;
            --cpus) cpus_in=${2:?--cpus needs a number}; shift ;;
            --disk) disk_in=${2:?--disk needs a size}; shift ;;
            --data-disk) dd+=("${2:?--data-disk needs ID=SIZE}"); shift ;;
            --restart) restart=yes ;;
            --no-restart) restart=no ;;
            -y|--yes) yes=1 ;;
            -h|--help) usage_edit; return 0 ;;
            -*) die "unknown option $1 (see: vmctl edit --help)" ;;
            *) [[ -z $name ]] || die "too many names"; name=$1 ;;
        esac
        shift
    done
    [[ -n $name ]] || { usage_edit; die "which VM? (vmctl edit NAME)"; }
    load_vm "$name"
    [[ $STATUS == installing ]] && die "$name is still installing; change it when the install has finished"

    # What it has now. The disk sizes come from the images themselves.
    local cur_disk new_ram=$RAM_MB new_cpus=$CPUS new_disk d id gb
    cur_disk=$(disk_vsize_gb "$DISK") || cur_disk=$DISK_GB
    new_disk=$cur_disk
    local -A cur_data=() new_data=()
    for d in ${DATA_DISKS:-}; do
        id=${d%%:*}
        cur_data[$id]=$(disk_vsize_gb "$(data_disk_path "$name" "$id")") || cur_data[$id]=${d#*:}
        new_data[$id]=${cur_data[$id]}
    done

    set_ram() { local mb; mb=$(to_mb "$1") && (( mb >= 512 )) || die "please give a RAM size like 8G (at least 512M)"; new_ram=$mb; }
    set_cpus() { [[ $1 =~ ^[0-9]+$ ]] && (( $1 >= 1 && $1 <= 255 )) || die "please give a number of CPU cores (1 or more)"; new_cpus=$1; }
    set_size() {   # set_size ID SIZE
        local g cur
        g=$(to_gb "$2") || die "please give a disk size like 200G"
        if [[ $1 == system ]]; then cur=$cur_disk; else
            [[ -n ${cur_data[$1]-} ]] || die "$name has no data disk $1 (see: vmctl disk list $name)"; cur=${cur_data[$1]}; fi
        (( g >= cur )) || die "disks can only grow: the $([[ $1 == system ]] && echo "system disk" || echo "data disk $1") is $cur GB, so the new size must be $cur GB or more (making it smaller would destroy data)"
        if [[ $1 == system ]]; then new_disk=$g; else new_data[$1]=$g; fi
    }
    [[ -n $ram_in ]] && set_ram "$ram_in"
    [[ -n $cpus_in ]] && set_cpus "$cpus_in"
    [[ -n $disk_in ]] && set_size system "$disk_in"
    for x in "${dd[@]}"; do
        [[ $x == *=* ]] || die "--data-disk needs ID=SIZE, for example data1=500G"
        set_size "${x%%=*}" "${x#*=}"
    done

    # No options: ask what to change.
    if [[ -z $ram_in$cpus_in$disk_in && ${#dd[@]} -eq 0 ]]; then
        (( INTERACTIVE )) || { usage_edit; die "nothing to change"; }
        local c opts acts ans ids
        while :; do
            opts=("RAM: $((new_ram / 1024)) GB$( (( new_ram != RAM_MB )) && echo " (was $((RAM_MB / 1024)) GB)" || true)"
                  "CPU cores: $new_cpus$( (( new_cpus != CPUS )) && echo " (was $CPUS)" || true)"
                  "System disk: $new_disk GB$( (( new_disk != cur_disk )) && echo " (was $cur_disk GB)" || true)")
            acts=(ram cpus system)
            for id in "${!new_data[@]}"; do
                opts+=("Data disk $id: ${new_data[$id]} GB$( (( new_data[$id] != cur_data[$id] )) && echo " (was ${cur_data[$id]} GB)" || true)")
                acts+=("$id")
            done
            opts+=("Apply the changes" "Cancel"); acts+=(apply cancel)
            menu c "What do you want to change on $name? Pick one, then pick Apply when you are done." "${opts[@]}"
            case ${acts[c-1]} in
                ram)  ask ans "New RAM size, for example 16G" "$((new_ram / 1024))G"; ( set_ram "$ans" ) && set_ram "$ans" ;;
                cpus) ask ans "New number of CPU cores (this server has $(nproc) threads)" "$new_cpus"; ( set_cpus "$ans" ) && set_cpus "$ans" ;;
                system) ask ans "New system disk size, for example $((cur_disk + 100))G (it can only grow)" "${new_disk}G"; ( set_size system "$ans" ) && set_size system "$ans" ;;
                apply) break ;;
                cancel) msg "Nothing was changed."; return 0 ;;
                *) id=${acts[c-1]}; ask ans "New size of data disk $id, for example $((cur_data[$id] + 100))G (it can only grow)" "${new_data[$id]}G"
                   ( set_size "$id" "$ans" ) && set_size "$id" "$ans" ;;
            esac
        done
        yes=0
    fi

    # What changes.
    local hw=0 grow=() changes=() grow_gb=0
    (( new_ram != RAM_MB )) && { hw=1; changes+=("RAM from $((RAM_MB / 1024)) GB to $((new_ram / 1024)) GB"); }
    (( new_cpus != CPUS )) && { hw=1; changes+=("CPU cores from $CPUS to $new_cpus"); }
    (( new_disk != cur_disk )) && { grow+=("system:$new_disk"); grow_gb=$(( grow_gb + new_disk - cur_disk )); changes+=("system disk from $cur_disk GB to $new_disk GB"); }
    for id in "${!new_data[@]}"; do
        (( new_data[$id] != cur_data[$id] )) || continue
        grow+=("$id:${new_data[$id]}"); grow_gb=$(( grow_gb + new_data[$id] - cur_data[$id] ))
        changes+=("data disk $id from ${cur_data[$id]} GB to ${new_data[$id]} GB")
    done
    (( ${#changes[@]} )) || { msg "Nothing to change: $name already has those settings."; return 0; }

    # Will it fit?
    local st problems=() avail free total fs_gb p
    st=$(vm_state "$name")
    if (( hw )); then
        avail=$(( $(awk '/^MemAvailable:/ {print $2}' /proc/meminfo) / 1024 ))
        [[ $st == running ]] && avail=$(( avail + RAM_MB ))
        (( new_cpus <= $(nproc) )) || problems+=("$new_cpus cores requested but this server has only $(nproc) CPU threads.")
        (( new_ram <= avail - RESERVE_RAM_MB )) || problems+=("$((new_ram / 1024)) GB RAM requested but only about $((avail / 1024)) GB is available and $((RESERVE_RAM_MB / 1024)) GB is kept for the server.")
    fi
    if (( grow_gb > 0 )); then
        free=$(( $(df -Pk "$STORE" | awk 'NR==2 {print $4}') / 1048576 ))
        (( grow_gb <= free )) || problems+=("the disks grow by $grow_gb GB but only $free GB is free in $STORE.")
    fi
    msg "Changes for $name:"
    for p in "${changes[@]}"; do msg "  $p"; done
    if (( grow_gb > 0 )); then
        total=$(( $(all_vm_disks_gb) + grow_gb ))
        fs_gb=$(( $(df -Pk "$STORE" | awk 'NR==2 {print $2}') / 1048576 ))
        msg "Disks stay thin: this takes no space on the server until $name writes data."
        (( total > fs_gb )) && msg "Note: all VM disks together could grow to $total GB, but the server's disk holds $fs_gb GB. If they all fill up, the VMs pause until space is freed."
    fi
    if (( ${#problems[@]} )); then
        for p in "${problems[@]}"; do warn "$p"; done
        (( yes )) || confirm "The VM may run slowly or affect other services on this server." || die "cancelled"
    elif (( ! yes )); then
        confirm "Apply these changes?" || die "cancelled"
    fi

    # RAM and CPUs: into the saved settings (used from the next start).
    if (( hw )); then
        step "Changing RAM and CPU cores"
        if (( new_ram != RAM_MB )); then
            # Order matters: the current size may never be above the maximum.
            if (( new_ram > RAM_MB )); then
                "${VIRSH[@]}" setmaxmem "$name" "${new_ram}M" --config >/dev/null && "${VIRSH[@]}" setmem "$name" "${new_ram}M" --config >/dev/null
            else
                "${VIRSH[@]}" setmem "$name" "${new_ram}M" --config >/dev/null && "${VIRSH[@]}" setmaxmem "$name" "${new_ram}M" --config >/dev/null
            fi || die "changing the RAM failed"
            set_env "$name" RAM_MB "$new_ram"
            msg "RAM set to $((new_ram / 1024)) GB."
            event "$name" "RAM changed from $((RAM_MB / 1024)) GB to $((new_ram / 1024)) GB"
        fi
        if (( new_cpus != CPUS )); then
            # One socket with N cores: Windows 10/11 Home and Pro use at most 2 sockets.
            virt-xml --connect qemu:///system "$name" --edit --vcpus "$new_cpus,sockets=1,cores=$new_cpus,threads=1" \
                >>/var/log/vmctl-install.log 2>&1 || die "changing the CPU cores failed (see /var/log/vmctl-install.log)"
            set_env "$name" CPUS "$new_cpus"
            msg "CPU cores set to $new_cpus."
            event "$name" "CPU cores changed from $CPUS to $new_cpus"
        fi
    fi

    # Disks: bigger images now (also while running), then the space inside the VM.
    if (( ${#grow[@]} )); then
        step "Growing the disks"
        for x in "${grow[@]}"; do grow_disk "$name" "${x%%:*}" "${x#*:}"; done
    fi

    local need_restart=0 expanded=0
    (( hw )) && [[ $st == running ]] && need_restart=1
    if (( ${#grow[@]} )); then
        if [[ $st == running ]]; then
            step "Letting $name use the new disk space (growing its partitions inside the VM)"
            if agent_up "$name"; then
                if expand_in_guest "$name"; then expanded=1; else warn "not everything could be grown inside $name (see above)"; manual_expand_help; fi
            else
                warn "the guest agent in $name is not answering."
                (( need_restart )) && msg "It is tried again after the restart." || { msg "When it answers, run: vmctl disk expand $name"; manual_expand_help; }
            fi
        fi
    fi

    if (( need_restart )); then
        if [[ -z $restart ]]; then
            restart=no
            (( INTERACTIVE )) && yes_no "$name is running. Restart it now so it gets the new RAM and CPU cores? It shuts down cleanly first." && restart=yes
        fi
        if [[ $restart == yes ]]; then
            step "Restarting $name"
            power_off_clean "$name" "$( (( yes )) && echo force || echo ask)" || die "$name is still running; the new RAM and CPU cores take effect at its next full shutdown and start"
            if (( ${#grow[@]} && ! expanded )); then
                "${VIRSH[@]}" start "$name" >/dev/null || die "could not start $name; start it with: vmctl start $name"
                msg "Started $name."
                expand_guest_flow "$name" || true
            elif (( INTERACTIVE )); then cmd_boot "$name"
            else "${VIRSH[@]}" start "$name" >/dev/null && msg "Started $name."; fi
        else
            msg "$name keeps running with its old RAM and CPU cores; the new ones take effect after a full shutdown and start"
            msg "(a restart from inside the VM is not enough): vmctl stop $name, then vmctl start $name"
        fi
    elif (( ${#grow[@]} )) && [[ $st != running ]]; then
        expand_guest_flow "$name" || true
    elif (( hw )); then
        msg "The new settings are used from the next start of $name."
    fi
    return 0
}

# ---------------------------------------------------------------- full cleanup
# Offered when the last VM is deleted.

purge_isos() {   # remove every downloaded installer, driver disc and cloud image
    local f n=0
    msg "Removing the downloaded ISOs and images from $STORE/isos:"
    for f in "$STORE"/isos/* "$STORE"/isos/.*.part; do
        [[ -f $f ]] || continue
        msg "  Deleting $(basename "$f") ($(human_mb "$(stat -c %s "$f")") MB)"
        rm -f "$f"; n=$((n + 1))
    done
    (( n )) && msg "  Done: $n file(s) removed. They are downloaded again when needed." || msg "  There were no downloaded files."
}

remove_network() {   # remove the private VM network and everything set up for it
    msg "Removing the private VM network and its firewall rules:"
    if "${VIRSH[@]}" net-info "$NET_NAME" >/dev/null 2>&1; then
        msg "  Stopping network $NET_NAME (bridge $BRIDGE)"
        "${VIRSH[@]}" net-destroy "$NET_NAME" >/dev/null 2>&1 || true
        msg "  Deleting network $NET_NAME from libvirt"
        "${VIRSH[@]}" net-undefine "$NET_NAME" >/dev/null 2>&1 || true
    else
        msg "  Network $NET_NAME was already gone"
    fi
    rm -f /var/lib/libvirt/dnsmasq/"$BRIDGE".* /var/lib/libvirt/dnsmasq/"$NET_NAME".*
    case $(fw_mode) in
        ufw)
            msg "  Deleting the VM network's firewall rules (ufw rules marked vmctl:net)"
            ufw_delete_comment 'vmctl:net' ;;
        iptables)
            msg "  Deleting vmctl's iptables chains (VMCTL-IN, VMCTL-FWD)"
            iptables -D FORWARD -j VMCTL-FWD 2>/dev/null || true
            iptables -D INPUT -j VMCTL-IN 2>/dev/null || true
            iptables -F VMCTL-FWD 2>/dev/null || true; iptables -X VMCTL-FWD 2>/dev/null || true
            iptables -F VMCTL-IN 2>/dev/null || true; iptables -X VMCTL-IN 2>/dev/null || true ;;
    esac
    if nft list table ip vmctl >/dev/null 2>&1; then
        msg "  Deleting vmctl's NAT and port-forward table (nftables table ip vmctl)"
        nft delete table ip vmctl
    fi
    rm -f "$NFT_FILE"
    if [[ -f /etc/sysctl.d/90-vmctl.conf ]]; then
        # Only vmctl's own setting file; forwarding stays on until the next
        # boot, since other software (Docker, for example) may rely on it.
        msg "  Removing vmctl's IP forwarding setting (/etc/sysctl.d/90-vmctl.conf)"
        rm -f /etc/sysctl.d/90-vmctl.conf
    fi
    msg "  Done. 'vmctl create' sets the network and firewall rules up again."
}

yes_no() {   # yes_no "Question"  -> 0 for yes (default answer: no)
    local a
    read -r -p "$1 (yes or no) [default: no]: " a || return 1
    [[ ${a,,} == y || ${a,,} == yes ]]
}

cmd_delete() {
    local name=${1-} force=0 keep_shared=0 purge_iso= purge_net= ans
    [[ -n $name ]] || die "usage: vmctl delete NAME [--force] [--purge-isos] [--purge-network] [--purge]"
    shift
    while (( $# )); do
        case $1 in
            --force) force=1 ;;
            --purge-isos) purge_iso=yes ;;
            --purge-network) purge_net=yes ;;
            --purge) purge_iso=yes; purge_net=yes ;;
            --keep-shared) keep_shared=1 ;;   # internal: a failed create cleaning up
            *) die "unknown option $1" ;;
        esac
        shift
    done
    load_vm "$name"
    if (( ! force )); then
        msg "This permanently deletes $name and its disk ($DISK)."
        if share_is_own "$name"; then msg "Its shared folder ($SHARE_DIR) and everything in it is deleted too."
        elif [[ -n ${SHARE_DIR:-} ]]; then msg "Its shared folder ($SHARE_DIR) is not deleted."; fi
        (( INTERACTIVE )) || die "refusing to delete without a terminal; use --force"
        read -r -p "Type the VM name to confirm: " ans
        [[ $ans == "$name" ]] || die "cancelled"
    fi
    systemctl stop "vmctl-install-$name" >/dev/null 2>&1 || true
    if "${VIRSH[@]}" dominfo "$name" >/dev/null 2>&1; then
        "${VIRSH[@]}" destroy "$name" >/dev/null 2>&1 || true
        "${VIRSH[@]}" undefine "$name" --nvram --tpm >/dev/null 2>&1 \
            || "${VIRSH[@]}" undefine "$name" --nvram >/dev/null
    fi
    "${VIRSH[@]}" net-update "$NET_NAME" delete ip-dhcp-host "<host mac='$MAC' name='$name' ip='$IP'/>" --live --config >/dev/null 2>&1 || true
    fw_vm_del "$name"
    local d
    for d in ${DATA_DISKS:-}; do rm -f "$(data_disk_path "$name" "${d%%:*}")"; done
    rm -rf "$(snap_root "$name")"   # its snapshots lived inside the disks just removed
    # The shared folder: only ever the folder vmctl made for this VM, never
    # one the owner picked (sudo vmctl share add NAME FOLDER).
    if share_is_own "$name" && [[ -d $SHARE_DIR ]]; then
        rm -rf -- "$SHARE_DIR"
        rmdir "$(dirname "$SHARE_DIR")" 2>/dev/null || true   # vmshare/ when it is now empty
        msg "Deleted the shared folder $SHARE_DIR."
    fi
    rm -f "$DISK" "${SEED:-/nonexistent}" "$(vm_env "$name")" "$(vm_fwd "$name")" "$(vm_vv "$name")" \
          "$(vm_plog "$name")" "$(vm_elog "$name")"
    apply_forwards
    msg "Deleted $name."

    # Was that the last VM? Then offer to clear the shared things too.
    (( keep_shared )) && return 0
    local left=("$VMS_DIR"/*.env)
    (( ${#left[@]} == 0 )) || return 0
    local iso_mb=0 f
    for f in "$STORE"/isos/*; do [[ -f $f ]] && iso_mb=$(( iso_mb + $(stat -c %s "$f") / 1048576 )); done
    if [[ -z $purge_iso && -z $purge_net ]] && (( INTERACTIVE )); then
        msg ""
        msg "$name was the last VM on this server."
        if (( iso_mb > 0 )); then
            yes_no "Remove the downloaded ISOs and images too ($iso_mb MB in $STORE/isos)?" && purge_iso=yes
        fi
        yes_no "Remove the private VM network and its firewall rules too?" && purge_net=yes
    fi
    [[ $purge_iso == yes ]] && purge_isos
    [[ $purge_net == yes ]] && remove_network
    if [[ $purge_iso != yes && $purge_net != yes ]]; then
        msg "Kept the downloaded ISOs and the private network for the next VM."
    fi
    return 0
}

cmd_eject() {
    local name=${1-} t; [[ -n $name ]] || die "usage: vmctl eject NAME"
    load_vm "$name"
    for t in $("${VIRSH[@]}" domblklist "$name" --details | awk '$2=="cdrom" {print $3}'); do
        "${VIRSH[@]}" change-media "$name" "$t" --eject --live --config >/dev/null 2>&1 \
            || "${VIRSH[@]}" change-media "$name" "$t" --eject --config >/dev/null 2>&1 || true
    done
    msg "Ejected the install discs from $name."
}

# ---------------------------------------------------------------- snapshots
# A snapshot is taken with the VM switched off: every disk gets an internal
# qcow2 snapshot "vmctl-<snap>", and the UEFI settings (nvram) and TPM state
# are copied next to it in $STORE/snapshots/<vm>/<snap>/, so Windows comes back
# exactly as it was. No libvirt snapshot metadata is used.
#
# Owners: a VM's OWNER may run "sudo vmctl snapshot ..." on that VM only
# (/etc/sudoers.d/vmctl-snapshot allows exactly that command for everyone;
# vmctl itself checks the owner). Root and members of sudo/wheel/admin may
# use every command on every VM.

CALLER=root
SNAPS_UNIT=/etc/systemd/system/vmctl-snapshots.service
SNAPS_TIMER=/etc/systemd/system/vmctl-snapshots.timer
SNAPS_SUDOERS=/etc/sudoers.d/vmctl-snapshot

set_caller() {   # who is really running vmctl: root, or a plain user through sudo
    local g
    CALLER=root
    [[ -n ${SUDO_USER-} && $SUDO_USER != root ]] || return 0
    for g in $(id -nG "$SUDO_USER" 2>/dev/null); do
        case $g in sudo|wheel|admin) return 0 ;; esac   # an admin: full access, like root
    done
    CALLER=$SUDO_USER
}

is_admin() { [[ $CALLER == root ]]; }

snap_root()  { printf '%s/snapshots/%s' "$STORE" "$1"; }
snap_dir()   { printf '%s/snapshots/%s/%s' "$STORE" "$1" "$2"; }
snap_valid() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$ ]]; }

# The VM must exist and belong to the caller. Loads the VM record.
snap_vm() {
    load_vm "$1"
    SNAP_AUTO=${SNAP_AUTO:-yes} SNAP_KEEP=${SNAP_KEEP:-$SNAP_KEEP_DEFAULT}
    is_admin || [[ -n $OWNER && $OWNER == "$CALLER" ]] \
        || die "$1 is not your VM. You can only use snapshots on VMs you own (ask the server admin)."
}

my_vms() {   # names of the VMs the caller may use, one per line
    local e name owner
    for e in "$VMS_DIR"/*.env; do
        name=$(basename "$e" .env)
        if is_admin; then printf '%s\n' "$name"; continue; fi
        owner=$(sed -n 's/^OWNER=//p' "$e" /dev/null | head -1)
        [[ $owner == "$CALLER" ]] && printf '%s\n' "$name"
    done
    return 0
}

disk_of() {   # disk_of NAME ID  (system | data1 | data2 ...)  -> path
    if [[ $2 == system ]]; then printf '%s' "$DISK"; else data_disk_path "$1" "$2"; fi
}

vm_disk_ids() {   # vm_disk_ids [with_data]  -> "system" plus the data disk IDs
    local d out=system
    if [[ ${1-} == with_data ]]; then
        for d in ${DATA_DISKS:-}; do out+=" ${d%%:*}"; done
    fi
    printf '%s' "$out"
}

vm_nvram() { "${VIRSH[@]}" dumpxml "$1" 2>/dev/null | sed -n 's|.*<nvram[^>]*>\(.*\)</nvram>.*|\1|p' | head -1; }
vm_tpm_dir() {
    local u; u=$("${VIRSH[@]}" domuuid "$1" 2>/dev/null) || return 0
    [[ -n $u && -d /var/lib/libvirt/swtpm/$u ]] && printf '/var/lib/libvirt/swtpm/%s' "$u"
    return 0
}

has_internal_snap() {   # has_internal_snap FILE TAG
    [[ -f $1 ]] || return 1
    qemu-img snapshot -l -U "$1" 2>/dev/null | awk -v t="$2" 'NR > 2 && $2 == t { f = 1 } END { exit !f }'
}

snap_meta() {   # snap_meta NAME SNAP: sets M_SNAP M_CREATED M_EPOCH M_KIND M_NOTE M_DISKS M_STATE M_BY
    local f; f=$(snap_dir "$1" "$2")/meta.env
    M_SNAP= M_CREATED= M_EPOCH=0 M_KIND= M_NOTE= M_DISKS= M_STATE= M_BY=
    [[ -f $f ]] || return 1
    # shellcheck source=/dev/null
    . "$f"
}

snap_names() {   # snap_names NAME [auto|manual]: oldest first
    local d s kind=${2-}
    for d in "$(snap_root "$1")"/*/; do
        s=$(basename "$d")
        snap_meta "$1" "$s" || continue
        [[ -z $kind || $M_KIND == "$kind" ]] || continue
        printf '%s %s\n' "$M_EPOCH" "$s"
    done | sort -n | cut -d' ' -f2
}

snap_count() { snap_names "$1" | grep -c . || true; }

snap_describe() {   # one readable line about a snapshot (snap_meta must have run)
    local what="system disk" pend=
    [[ $M_DISKS == *data* ]] && what="system and data disks"
    [[ -f $(snap_dir "$NAME" "$M_SNAP")/.delete ]] && pend=" (will be removed at the next nightly run)"
    printf '%s: taken %s, %s, %s%s%s' "$M_SNAP" "$(date -d "@$M_EPOCH" '+%Y-%m-%d %H:%M')" \
        "$([[ $M_KIND == auto ]] && echo "daily automatic" || echo "made by ${M_BY:-root}")" \
        "$what" "${M_NOTE:+, note: $M_NOTE}" "$pend"
}

SNAP_LOCK_FD=
snap_lock() {
    exec {SNAP_LOCK_FD}>"/run/vmctl-snap-$1.lock"
    flock -n "$SNAP_LOCK_FD" || { msg "Another snapshot job for $1 is running; waiting for it to finish."; flock "$SNAP_LOCK_FD"; }
}
snap_unlock() { [[ -n $SNAP_LOCK_FD ]] && exec {SNAP_LOCK_FD}>&-; SNAP_LOCK_FD=; return 0; }

free_gb() { df -BG --output=avail "$1" 2>/dev/null | tail -1 | tr -dc '0-9'; }

disk_stamp() {   # modification times of the VM's disks (loaded VM); changes when the VM wrote anything
    local id f out=
    for id in $(vm_disk_ids with_data); do
        f=$(disk_of "$NAME" "$id"); [[ -f $f ]] && out+="$id:$(stat -c %Y "$f") "
    done
    printf '%s' "$out"
}
save_stamp() { install -d -m 700 "$(snap_root "$NAME")"; disk_stamp >"$(snap_root "$NAME")/.stamp"; }

# power_off_clean NAME MODE   MODE: ask (interactive), force (pull the plug if it
# does not shut down), skip (give up). Returns 0 once the VM is off.
power_off_clean() {
    local name=$1 mode=$2 st i
    st=$(vm_state "$name")
    [[ $st == "shut off" ]] && return 0
    if [[ $st != running ]]; then
        [[ $mode == skip ]] && return 1
        msg "$name is $st; switching it off."
        "${VIRSH[@]}" destroy "$name" >/dev/null 2>&1 || true
        [[ $(vm_state "$name") == "shut off" ]]; return
    fi
    msg "Shutting down $name cleanly (up to $(( SNAP_SHUTDOWN_TIMEOUT / 60 )) minutes)."
    if [[ $KIND == windows ]] && agent_up "$name"; then
        # A full shutdown (not "fast startup", which leaves the disks half open).
        guest_exec "$name" 20 reg.exe add 'HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Power' \
            /v HiberbootEnabled /t REG_DWORD /d 0 /f >/dev/null 2>&1 || true
        guest_exec "$name" 10 shutdown.exe /s /t 0 >/dev/null 2>&1 || "${VIRSH[@]}" shutdown "$name" >/dev/null 2>&1 || true
    else
        "${VIRSH[@]}" shutdown "$name" >/dev/null 2>&1 || true
    fi
    for (( i = 0; i < SNAP_SHUTDOWN_TIMEOUT; i += 5 )); do
        sleep 5
        [[ $(vm_state "$name") == "shut off" ]] && { msg "$name is switched off."; return 0; }
        (( i > 0 && i % 60 == 0 )) && msg "  Still shutting down ($(( i / 60 )) minutes so far)."
        # Ask again now and then: a guest that was still booting ignores the first request.
        (( i > 0 && i % 60 == 0 )) && { "${VIRSH[@]}" shutdown "$name" >/dev/null 2>&1 || true; }
    done
    case $mode in
        skip) msg "$name did not shut down within $(( SNAP_SHUTDOWN_TIMEOUT / 60 )) minutes."; return 1 ;;
        ask)  yes_no "$name did not shut down. Switch it off hard (like pulling the plug; unsaved work inside is lost)?" || return 1 ;;
    esac
    msg "Switching $name off hard."
    "${VIRSH[@]}" destroy "$name" >/dev/null 2>&1 || true
    [[ $(vm_state "$name") == "shut off" ]]
}

start_again() {   # start_again NAME WAS-STATE
    [[ $2 == running ]] || return 0
    step "Starting $1 again"
    if "${VIRSH[@]}" start "$1" >/dev/null 2>&1; then msg "Started $1."; event "$1" "Started again after the snapshot job"
    else warn "could not start $1 again; start it with: vmctl start $1"; event "$1" "Could NOT start again after the snapshot job"; return 1; fi
}

# The VM is off and locked from here on. snap_take_off NAME SNAP KIND NOTE IDS
snap_take_off() {
    local name=$1 snap=$2 kind=$3 note=$4 ids=$5 dir id f done_ids= nv tpm
    dir=$(snap_dir "$name" "$snap")
    install -d -m 700 "$(snap_root "$name")" "$dir"
    step "Saving the disks"
    for id in $ids; do
        f=$(disk_of "$name" "$id")
        [[ -f $f ]] || { warn "disk $id ($f) is missing; skipped"; continue; }
        if ! qemu-img snapshot -c "vmctl-$snap" "$f"; then
            for id in $done_ids; do qemu-img snapshot -d "vmctl-$snap" "$(disk_of "$name" "$id")" 2>/dev/null || true; done
            rm -rf "$dir"
            warn "saving disk $f failed; nothing was kept"
            return 1
        fi
        done_ids+="$id "
        msg "Saved the $([[ $id == system ]] && echo "system disk" || echo "data disk $id")."
    done
    nv=$(vm_nvram "$name")
    if [[ -n $nv && -f $nv ]]; then
        if cp -p "$nv" "$dir/VARS.fd"; then msg "Saved the UEFI settings."; else warn "could not save the UEFI settings"; fi
    fi
    tpm=$(vm_tpm_dir "$name")
    if [[ -n $tpm ]]; then
        if tar -C "$(dirname "$tpm")" --numeric-owner -cpf "$dir/tpm.tar" "$(basename "$tpm")"; then msg "Saved the TPM state."
        else rm -f "$dir/tpm.tar"; warn "could not save the TPM state"; fi
    fi
    "${VIRSH[@]}" dumpxml "$name" >"$dir/domain.xml" 2>/dev/null || true
    {
        printf 'M_SNAP=%q\n' "$snap"
        printf 'M_CREATED=%q\n' "$(date -Is)"
        printf 'M_EPOCH=%q\n' "$(date +%s)"
        printf 'M_KIND=%q\n' "$kind"
        printf 'M_NOTE=%q\n' "$note"
        printf 'M_DISKS=%q\n' "${done_ids% }"
        printf 'M_STATE=%q\n' "$SNAP_WAS"
        printf 'M_BY=%q\n' "$CALLER"
    } >"$dir/meta.env"
    chmod 600 "$dir/meta.env"
    event "$name" "Snapshot $snap saved (${done_ids% })"
}

# Remove a snapshot while the VM is off and locked.
snap_delete_off() {
    local name=$1 snap=$2 id f
    snap_meta "$name" "$snap" || true
    for id in system ${M_DISKS:-}; do
        f=$(disk_of "$name" "$id")
        has_internal_snap "$f" "vmctl-$snap" && { qemu-img snapshot -d "vmctl-$snap" "$f" || return 1; }
    done
    rm -rf "$(snap_dir "$name" "$snap")"
    event "$name" "Snapshot $snap removed"
}

new_snap_name() {   # new_snap_name NAME PREFIX
    local base n=2 s
    base="${2}$(date +%Y-%m-%d-%H%M)"; s=$base
    while [[ -e $(snap_dir "$1" "$s") ]]; do s="$base-$n"; n=$((n + 1)); done
    printf '%s' "$s"
}

snap_take() {   # vmctl snapshot take NAME [SNAP] [--note TEXT] [--with-data] [--yes]
    local name= snap= note= data=0 yes=0 ids gb
    while (( $# )); do
        case $1 in
            --note) note=${2-}; shift ;;
            --with-data) data=1 ;;
            -y|--yes) yes=1 ;;
            -*) die "unknown option $1 (see: vmctl snapshot help)" ;;
            *) if [[ -z $name ]]; then name=$1; elif [[ -z $snap ]]; then snap=$1; else die "too many names"; fi ;;
        esac
        shift
    done
    [[ -n $name ]] || die "usage: vmctl snapshot take NAME [SNAP-NAME] [--note TEXT] [--with-data]"
    snap_vm "$name"
    [[ $STATUS == installing ]] && die "$name is still installing; take a snapshot once the install has finished."
    if [[ -z $snap ]] && (( INTERACTIVE && ! yes )); then
        ask snap "Name for the snapshot (letters, digits, dots, dashes)" "$(new_snap_name "$name" "")"
    fi
    [[ -n $snap ]] || snap=$(new_snap_name "$name" "")
    snap_valid "$snap" || die "the snapshot name may only use letters, digits, dots, dashes and underscores (up to 40)"
    [[ $snap == auto-* ]] && die "names starting with auto- are kept for the daily snapshots"
    [[ -e $(snap_dir "$name" "$snap") ]] && die "$name already has a snapshot called $snap"
    note=$(printf '%s' "$note" | tr -d '\000-\037' | cut -c1-200)
    if [[ -z $note ]] && (( INTERACTIVE && ! yes )); then ask note "A short note to remember why (optional, press Enter to skip)" ""; fi
    note=$(printf '%s' "$note" | tr -d '\000-\037' | cut -c1-200)
    if [[ -n ${DATA_DISKS:-} ]] && (( ! data && INTERACTIVE && ! yes )); then
        yes_no "Also save the data disk (so a restore can put back the files on it too)?" && data=1
    fi
    ids=$(vm_disk_ids "$( (( data )) && echo with_data)")
    gb=$(free_gb "$STORE/disks")
    (( ${gb:-0} >= SNAP_MIN_FREE_GB )) || die "only ${gb:-0} GB free on the server disk; a snapshot needs at least $SNAP_MIN_FREE_GB GB"
    SNAP_WAS=$(vm_state "$name")
    [[ $SNAP_WAS == running || $SNAP_WAS == "shut off" ]] || die "$name is $SNAP_WAS; start or stop it first"
    if [[ $SNAP_WAS == running ]] && (( ! yes )); then
        msg "$name will shut down for about a minute while the snapshot is taken, then start again."
        (( INTERACTIVE )) || die "not running interactively; add --yes to confirm the short shutdown"
        confirm "Shut down $name now?" || die "cancelled"
    fi
    snap_lock "$name"
    if [[ $SNAP_WAS == running ]]; then
        step "Shutting down $name"
        power_off_clean "$name" ask || { start_again "$name" running >/dev/null 2>&1 || true; snap_unlock; die "$name did not shut down; no snapshot taken"; }
    fi
    local ok=0
    snap_take_off "$name" "$snap" manual "$note" "$ids" && ok=1
    save_stamp
    start_again "$name" "$SNAP_WAS" || true
    snap_unlock
    (( ok )) || die "the snapshot was not taken"
    msg ""
    msg "Snapshot $snap of $name is saved. To go back to it later: sudo vmctl snapshot restore $name $snap"
}

snap_restore() {   # vmctl snapshot restore NAME SNAP [--with-data|--no-data] [--yes] [--no-watch]
    local name= snap= data= yes=0 watch=1 ids=system id f dir was nv tpm want have regrown=0
    while (( $# )); do
        case $1 in
            --with-data) data=1 ;;
            --no-data) data=0 ;;
            -y|--yes) yes=1 ;;
            --no-watch) watch=0 ;;
            -*) die "unknown option $1 (see: vmctl snapshot help)" ;;
            *) if [[ -z $name ]]; then name=$1; elif [[ -z $snap ]]; then snap=$1; else die "too many names"; fi ;;
        esac
        shift
    done
    [[ -n $name ]] || die "usage: vmctl snapshot restore NAME SNAP-NAME"
    snap_vm "$name"
    [[ $STATUS == installing ]] && die "$name is still installing"
    if [[ -z $snap ]]; then
        (( INTERACTIVE )) || die "usage: vmctl snapshot restore NAME SNAP-NAME"
        snap=$(pick_snap "$name") || die "$name has no snapshots yet"
    fi
    snap_valid "$snap" && snap_meta "$name" "$snap" || die "$name has no snapshot called $snap (see: vmctl snapshot list $name)"
    dir=$(snap_dir "$name" "$snap")
    msg "$(snap_describe)"
    if [[ $M_DISKS == *data* ]]; then
        if [[ -z $data ]]; then
            data=0
            (( INTERACTIVE && ! yes )) && yes_no "This snapshot also holds the data disk. Put the data disk back as it was too? Files saved there since then would be lost." && data=1
        fi
    else
        [[ $data == 1 ]] && msg "This snapshot only holds the system disk; the data disk stays as it is."
        data=0
    fi
    (( data )) && ids=$M_DISKS
    msg "Restoring puts $name back to $(date -d "@$M_EPOCH" '+%Y-%m-%d %H:%M'). Everything changed on the $([[ $data == 1 ]] && echo "system and data disks" || echo "system disk") since then is lost."
    (( data )) || [[ -z ${DATA_DISKS:-} ]] || msg "The data disk is not touched."
    if (( ! yes )); then
        (( INTERACTIVE )) || die "not running interactively; add --yes to confirm"
        confirm "Restore $name to snapshot $snap?" || die "cancelled"
    fi
    for id in $ids; do
        has_internal_snap "$(disk_of "$name" "$id")" "vmctl-$snap" || die "disk $id no longer holds snapshot $snap; nothing was changed"
    done
    was=$(vm_state "$name")
    snap_lock "$name"
    step "Switching $name off"
    power_off_clean "$name" "$( (( yes )) && echo force || echo ask)" || { snap_unlock; die "$name is still running; nothing was changed"; }
    step "Putting the disks back"
    for id in $ids; do
        f=$(disk_of "$name" "$id")
        qemu-img snapshot -a "vmctl-$snap" "$f" || { snap_unlock; die "restoring $f failed"; }
        msg "Restored the $([[ $id == system ]] && echo "system disk" || echo "data disk $id")."
        # The snapshot also holds the disk size from back then; if the disk
        # was grown since, give it its current size again.
        want=$DISK_GB; [[ $id == system ]] || want=$(data_disk_gb "$id") || want=0
        have=$(disk_vsize_gb "$f") || have=$want
        if (( have < want )); then
            qemu-img resize -q "$f" "${want}G" && regrown=1 && msg "  It was $have GB in the snapshot; grown back to $want GB."
        fi
    done
    nv=$(vm_nvram "$name")
    if [[ -f $dir/VARS.fd && -n $nv ]]; then
        if [[ -f $nv ]]; then cat "$dir/VARS.fd" >"$nv"; else install -m 600 -o libvirt-qemu -g libvirt-qemu "$dir/VARS.fd" "$nv" 2>/dev/null || cp "$dir/VARS.fd" "$nv"; fi
        msg "Restored the UEFI settings."
    fi
    tpm=$(vm_tpm_dir "$name")
    if [[ -f $dir/tpm.tar && -n $tpm ]]; then
        rm -rf "$tpm"
        if tar -C "$(dirname "$tpm")" --numeric-owner -xpf "$dir/tpm.tar"; then msg "Restored the TPM state."
        else warn "could not restore the TPM state"; fi
    fi
    rm -f "$dir/.delete"
    event "$name" "Restored to snapshot $snap (${ids})"
    save_stamp
    snap_unlock
    msg ""
    msg "$name is back at snapshot $snap."
    (( regrown )) && msg "Inside the VM the partitions are as small as they were then. When it is running, run: vmctl disk expand $name"
    local start=0
    [[ $was == running ]] && start=1
    (( ! start && INTERACTIVE )) && yes_no "Start $name now?" && start=1
    if (( start )); then
        if (( watch && INTERACTIVE )); then cmd_boot "$name"
        else "${VIRSH[@]}" start "$name" >/dev/null && msg "Started $name."; fi
    fi
    return 0
}

snap_delete() {   # vmctl snapshot delete NAME SNAP [--yes]
    local name= snap= yes=0 was
    while (( $# )); do
        case $1 in
            -y|--yes) yes=1 ;;
            -*) die "unknown option $1" ;;
            *) if [[ -z $name ]]; then name=$1; elif [[ -z $snap ]]; then snap=$1; else die "too many names"; fi ;;
        esac
        shift
    done
    [[ -n $name ]] || die "usage: vmctl snapshot delete NAME SNAP-NAME"
    snap_vm "$name"
    if [[ -z $snap ]]; then
        (( INTERACTIVE )) || die "usage: vmctl snapshot delete NAME SNAP-NAME"
        snap=$(pick_snap "$name") || die "$name has no snapshots"
    fi
    snap_valid "$snap" && snap_meta "$name" "$snap" || die "$name has no snapshot called $snap"
    msg "$(snap_describe)"
    if (( ! yes )); then
        (( INTERACTIVE )) || die "not running interactively; add --yes to confirm"
        confirm "Delete this snapshot for good?" || die "cancelled"
    fi
    was=$(vm_state "$name")
    if [[ $was != "shut off" ]]; then
        # qemu-img cannot change a disk the VM is using.
        if (( INTERACTIVE && ! yes )) && yes_no "$name has to be switched off for about a minute to remove it now. Do that now? (no = remove it at the next nightly run)"; then
            :
        else
            touch "$(snap_dir "$name" "$snap")/.delete"
            msg "Snapshot $snap will be removed at the next nightly snapshot run ($SNAP_TIME), while $name is briefly switched off anyway."
            return 0
        fi
    fi
    snap_lock "$name"
    if [[ $was == running ]]; then step "Shutting down $name"; power_off_clean "$name" ask || { snap_unlock; die "$name did not shut down; the snapshot is kept"; }; fi
    if snap_delete_off "$name" "$snap"; then msg "Deleted snapshot $snap."; else warn "could not remove $snap completely"; fi
    SNAP_WAS=$was; start_again "$name" "$was" || true
    snap_unlock
}

snap_list() {   # vmctl snapshot list [NAME]
    local names n s
    if [[ -n ${1-} ]]; then names=$1; snap_vm "$1"; else names=$(my_vms); fi
    [[ -n $names ]] || { msg "You do not own any VMs."; return 0; }
    for n in $names; do
        ( snap_vm "$n"
          local list; list=$(snap_names "$n")
          msg "$n: daily snapshots ${SNAP_AUTO}, keeping the last $SNAP_KEEP daily ones${OWNER:+, owner $OWNER}."
          if [[ -z $list ]]; then msg "  No snapshots yet."; else
              for s in $list; do snap_meta "$n" "$s"; msg "  $(snap_describe)"; done
          fi )
    done
}

pick_snap() {   # numbered list of a VM's snapshots; prints the chosen name
    local name=$1 list=() s c
    while read -r s; do [[ -n $s ]] && list+=("$s"); done < <(snap_names "$name")
    (( ${#list[@]} )) || return 1
    local labels=()
    for s in "${list[@]}"; do snap_meta "$name" "$s"; labels+=("$(snap_describe)"); done
    menu c "Which snapshot of $name?" "${labels[@]}" >&2
    printf '%s' "${list[c-1]}"
}

snap_daily() {   # vmctl snapshot daily NAME [on|off] [--keep N]
    local name= set= keep=
    while (( $# )); do
        case $1 in
            --keep) keep=${2-}; shift ;;
            on|yes|off|no) set=$1 ;;
            -*) die "unknown option $1" ;;
            *) [[ -z $name ]] && name=$1 || die "usage: vmctl snapshot daily NAME [on|off] [--keep N]" ;;
        esac
        shift
    done
    [[ -n $name ]] || die "usage: vmctl snapshot daily NAME [on|off] [--keep N]"
    snap_vm "$name"
    if [[ -z $set && -z $keep ]] && (( INTERACTIVE )); then
        msg "$name: daily snapshots are ${SNAP_AUTO}, keeping the last $SNAP_KEEP daily ones. They run at $SNAP_TIME (server time)."
        local c
        menu c "What do you want to do?" "Keep it like this" "Turn daily snapshots on" "Turn daily snapshots off" "Change how many daily snapshots are kept"
        case $c in 2) set=on ;; 3) set=off ;; 4) ask keep "How many daily snapshots to keep (1 to $SNAP_KEEP_MAX)" "$SNAP_KEEP" ;; esac
    fi
    if [[ -n $keep ]]; then
        [[ $keep =~ ^[0-9]+$ ]] && (( keep >= 1 && keep <= SNAP_KEEP_MAX )) || die "keep a number from 1 to $SNAP_KEEP_MAX"
        set_env "$name" SNAP_KEEP "$keep"; SNAP_KEEP=$keep
        msg "$name keeps the last $keep daily snapshots. Older ones are removed at the nightly run; snapshots you take yourself are never removed automatically."
    fi
    case ${set,,} in
        on|yes)  set_env "$name" SNAP_AUTO yes; SNAP_AUTO=yes ;;
        off|no)  set_env "$name" SNAP_AUTO no;  SNAP_AUTO=no ;;
    esac
    msg "$name: daily snapshots ${SNAP_AUTO}, at $SNAP_TIME (server time), keeping the last $SNAP_KEEP."
    [[ $SNAP_AUTO == yes ]] && msg "If $name is running then, it shuts down for about a minute and starts again."
    return 0
}

snap_time() {   # vmctl snapshot time [HH:MM]  (admins)
    is_admin || die "only the server admin can change when the daily snapshots run"
    local t=${1-}
    [[ -n $t ]] || { msg "Daily snapshots run at $SNAP_TIME (server time). Next run: $(systemctl show -P NextElapseUSecRealtime vmctl-snapshots.timer 2>/dev/null)"; return 0; }
    [[ $t =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "give the time as HH:MM, for example 04:00"
    if grep -q '^SNAP_TIME=' "$CONF"; then sed -i "s/^SNAP_TIME=.*/SNAP_TIME=$t/" "$CONF"; else printf 'SNAP_TIME=%s\n' "$t" >>"$CONF"; fi
    SNAP_TIME=$t
    ensure_snapshot_timer
    msg "Daily snapshots now run at $t (server time)."
}

# Called by vmctl-snapshots.timer: one VM at a time.
cmd_auto_snapshot() {
    local e name
    for e in "$VMS_DIR"/*.env; do
        name=$(basename "$e" .env)
        ( auto_snapshot_vm "$name" ) || logger -t vmctl "$name: daily snapshot failed" 2>/dev/null || true
    done
    return 0
}

auto_snapshot_vm() {
    local name=$1 s pending=() take=1 autos keep n gb
    load_vm "$name"
    SNAP_AUTO=${SNAP_AUTO:-yes} SNAP_KEEP=${SNAP_KEEP:-$SNAP_KEEP_DEFAULT}
    [[ $STATUS == installing ]] && return 0
    for s in $(snap_names "$name"); do [[ -f $(snap_dir "$name" "$s")/.delete ]] && pending+=("$s"); done
    [[ $SNAP_AUTO == yes ]] || take=0
    SNAP_WAS=$(vm_state "$name")
    # Switched off and nothing written since the last snapshot: nothing new to save.
    if (( take )) && [[ $SNAP_WAS == "shut off" && -f $(snap_root "$name")/.stamp && $(disk_stamp) == "$(cat "$(snap_root "$name")/.stamp")" ]]; then
        take=0; event "$name" "Daily snapshot skipped: switched off and unchanged since the last snapshot"
    fi
    gb=$(free_gb "$STORE/disks")
    if (( take )) && (( ${gb:-0} < SNAP_MIN_FREE_GB )); then
        take=0; event "$name" "Daily snapshot skipped: only ${gb:-0} GB free on the server disk"
    fi
    # Daily ones over the limit (counting the one about to be taken).
    autos=($(snap_names "$name" auto))
    keep=$SNAP_KEEP; (( take )) && keep=$(( keep - 1 ))
    local prune=()
    n=$(( ${#autos[@]} - keep ))
    (( n > 0 )) && prune=("${autos[@]:0:n}")
    (( take || ${#pending[@]} || ${#prune[@]} )) || return 0
    [[ $SNAP_WAS == running || $SNAP_WAS == "shut off" ]] || { event "$name" "Daily snapshot skipped: the VM is $SNAP_WAS"; return 0; }
    snap_lock "$name"
    if [[ $SNAP_WAS == running ]]; then
        event "$name" "Daily snapshot: shutting down for a minute"
        if ! power_off_clean "$name" skip; then
            event "$name" "Daily snapshot skipped: the VM did not shut down within $(( SNAP_SHUTDOWN_TIMEOUT / 60 )) minutes"
            start_again "$name" running >/dev/null 2>&1 || true   # in case it was half way down
            snap_unlock; return 1
        fi
    fi
    if (( take )); then
        CALLER=root
        snap_take_off "$name" "$(new_snap_name "$name" auto-)" auto "" system || event "$name" "Daily snapshot FAILED"
    fi
    for s in "${pending[@]}" "${prune[@]}"; do snap_delete_off "$name" "$s" || event "$name" "Could not remove snapshot $s"; done
    save_stamp
    start_again "$name" "$SNAP_WAS" || true
    snap_unlock
}

ensure_snapshot_timer() {
    local want="OnCalendar=*-*-* $SNAP_TIME:00"
    if [[ ! -f $SNAPS_UNIT ]]; then
        cat >"$SNAPS_UNIT" <<EOF
[Unit]
Description=vmctl daily VM snapshots
After=libvirtd.service

[Service]
Type=oneshot
ExecStart=$SELF _auto-snapshot
EOF
    fi
    if ! grep -qxF "$want" "$SNAPS_TIMER" 2>/dev/null; then
        cat >"$SNAPS_TIMER" <<EOF
[Unit]
Description=vmctl daily VM snapshots (time: SNAP_TIME in $CONF, or vmctl snapshot time HH:MM)

[Timer]
$want
Persistent=true

[Install]
WantedBy=timers.target
EOF
        systemctl daemon-reload
        systemctl enable vmctl-snapshots.timer >/dev/null 2>&1 || true
        systemctl restart vmctl-snapshots.timer >/dev/null 2>&1 || true
    fi
    if ! grep -q " share" "$SNAPS_SUDOERS" 2>/dev/null && command -v visudo >/dev/null; then
        local t; t=$(mktemp)
        cat >"$t" <<EOF
# vmctl: any user may run "sudo vmctl snapshot ..." and "sudo vmctl share ...".
# vmctl itself only lets a user touch the VMs they own (vmctl owner NAME USER).
ALL ALL=(root) NOPASSWD: $SELF snapshot, $SELF snapshot *, $SELF share, $SELF share *
EOF
        if visudo -cqf "$t"; then install -m 440 -o root -g root "$t" "$SNAPS_SUDOERS"; else warn "sudoers rule for snapshots and shares failed its check; not installed"; fi
        rm -f "$t"
    fi
    return 0
}

cmd_owner() {   # vmctl owner NAME [USER|none]
    local name=${1-} who=${2-}
    [[ -n $name ]] || die "usage: vmctl owner NAME [USER|none]"
    load_vm "$name"
    if [[ -z $who ]]; then msg "$name is owned by: ${OWNER:-nobody (only root and admins)}"; return 0; fi
    if [[ ${who,,} == none ]]; then set_env "$name" OWNER ""; msg "$name has no owner now; only root and admins can use its snapshots."; return 0; fi
    id -u "$who" >/dev/null 2>&1 || die "there is no user called $who on this server"
    set_env "$name" OWNER "$who"
    msg "$who now owns $name and can run: sudo vmctl snapshot   (take, list, restore, delete, daily settings)"
    msg "  and: sudo vmctl share   (give $name a folder from their home on this server)"
    if [[ -n ${SHARE_DIR:-} ]]; then
        msg "Its shared folder $SHARE_DIR is now shared as $who, from $name's next start. If $who cannot"
        msg "reach it, pick another one: sudo vmctl share add $name FOLDER"
    fi
}

usage_snapshot() {
    cat <<EOF
vmctl snapshot - save a VM and roll it back later (for example after an
update, a package or a program broke it)

  sudo vmctl snapshot                          menu: pick a VM, then what to do
  sudo vmctl snapshot list [NAME]              list snapshots
  sudo vmctl snapshot take NAME [SNAP-NAME] [--note TEXT] [--with-data] [--yes]
                                               save the VM now. A running VM shuts down for about
                                               a minute and starts again. --with-data also saves the
                                               data disk (otherwise only the system disk)
  sudo vmctl snapshot restore NAME SNAP-NAME [--with-data|--no-data] [--yes] [--no-watch]
                                               go back to a snapshot (the data disk is only put back
                                               when asked to and the snapshot holds it)
  sudo vmctl snapshot delete NAME SNAP-NAME [--yes]
  sudo vmctl snapshot daily NAME [on|off] [--keep N]
                                               daily automatic snapshots (default on, keep 10).
                                               Only daily ones are removed automatically; the
                                               ones you take yourself stay until you delete them
  sudo vmctl snapshot time [HH:MM]             (admin) when the daily run happens, now $SNAP_TIME
  sudo vmctl owner NAME [USER|none]            (admin) who owns a VM and may use its snapshots

A VM's shared folder (sudo vmctl share) is on the server, not in the VM's
disks, so snapshots do not include it and restoring one does not change it.
EOF
}

snap_menu() {
    local vms=() v c name
    while read -r v; do [[ -n $v ]] && vms+=("$v"); done < <(my_vms)
    (( ${#vms[@]} )) || die "you do not own any VMs (ask the server admin to run: vmctl owner NAME $CALLER)"
    if (( ${#vms[@]} == 1 )); then name=${vms[0]}; msg "VM: $name"
    else menu c "Which VM?" "${vms[@]}"; name=${vms[c-1]}; fi
    menu c "What do you want to do with $name?" "List its snapshots" "Take a snapshot now" \
        "Restore a snapshot (go back in time)" "Delete a snapshot" "Daily snapshot settings"
    case $c in
        1) snap_list "$name" ;;
        2) snap_take "$name" ;;
        3) snap_restore "$name" ;;
        4) snap_delete "$name" ;;
        5) snap_daily "$name" ;;
    esac
}

cmd_snapshot() {
    local sub=${1-}; shift || true
    case $sub in
        "")          (( INTERACTIVE )) || { usage_snapshot; return 1; }; snap_menu ;;
        list|ls)     snap_list "$@" ;;
        take|create|new) snap_take "$@" ;;
        restore|revert|rollback) snap_restore "$@" ;;
        delete|rm)   snap_delete "$@" ;;
        daily|auto)  snap_daily "$@" ;;
        time)        snap_time "$@" ;;
        help|-h|--help) usage_snapshot ;;
        *) usage_snapshot; return 1 ;;
    esac
}

usage() {
    cat <<EOF
vmctl $VMCTL_VERSION - create and manage virtual machines on this server

  vmctl create [options]         create a VM (asks questions; see vmctl create --help)
  vmctl check                    check this server (CPU virtualization, kernel modules, software, libvirt)
                                 and fix what is missing; also runs at the start of every create
  vmctl list                     list VMs with their state and ports
  vmctl info NAME                connection details for one VM
  vmctl progress NAME            follow a Windows install step by step (Ctrl+C stops watching)
  vmctl viewer NAME              write the remote-viewer connection file (.vv)
        --out FILE               ... to this path
        --print                  ... and print it
        --new-password           change the remote-viewer password (old files stop working)
        --close / --open         close or reopen the remote-viewer port in the firewall
  vmctl forward add NAME HOSTPORT|auto GUESTPORT [tcp|udp|both] [--allow LIST]
  vmctl forward del NAME HOSTPORT [tcp|udp]
  vmctl forward list [NAME]
  vmctl start NAME [--no-watch]  start a VM and read out its boot messages until it is ready
  vmctl reboot NAME [--no-watch] restart a VM and read out its boot messages
  vmctl boot NAME [--minutes N]  follow a VM that is already booting (disk checks, repairs, updates)
  vmctl screen NAME              read out the text currently on a VM's screen
  vmctl password NAME [USER]     reset a user's password inside the VM (asks for the new one)
  vmctl autostart NAME [on|off]  start the VM by itself whenever this server starts (or show the setting)
  vmctl edit NAME                change RAM, CPU cores or disk sizes (asks; see vmctl edit --help)
        --ram SIZE --cpus N --disk SIZE --data-disk ID=SIZE [--restart|--no-restart] [-y]
  vmctl disk add NAME SIZE       add a data disk (formatted and mounted inside the VM, kept after restarts)
  vmctl disk grow NAME ID SIZE   make a disk bigger (ID: system, data1...) and use the space inside the VM
  vmctl disk expand NAME         grow the partitions inside the VM to fill its disks (e.g. after a restore)
  vmctl disk setup NAME          format/mount data disks inside the VM (e.g. after installing Linux from an ISO)
  vmctl disk list NAME           show a VM's data disks
  vmctl disk help NAME           commands to set up the data disks by hand
  vmctl stop NAME                clean shutdown
  vmctl forcestop NAME           pull the plug
  vmctl console NAME             text console over the serial port (Ctrl+] to leave)
  vmctl eject NAME               remove install discs
  vmctl delete NAME [--force]    delete a VM, its disks, ports and firewall rules. When it is the
                                 last VM, asks whether to also remove the downloaded ISOs and the
                                 private network + its firewall rules (or say so up front with
                                 --purge-isos, --purge-network or --purge for both)
  vmctl apply                    rebuild port forwards (run at boot automatically)
  vmctl snapshot ...             save a VM and roll it back later; daily automatic snapshots
                                 (see: vmctl snapshot help). VM owners use: sudo vmctl snapshot
  vmctl share ...                give a VM a folder from this server (a drive in Windows, /mnt/vmshare
                                 in Linux; see: vmctl share help). VM owners use: sudo vmctl share
  vmctl owner NAME [USER|none]   which server user owns a VM and may use its snapshots and shared folder

Settings: $CONF
EOF
}

# ---------------------------------------------------------------- main
main() {
    local cmd=${1:-help}; shift || true
    case $cmd in help|-h|--help) usage; return ;; esac
    case "$cmd ${1-}" in "snapshot help"|"snapshot -h"|"snapshot --help") load_conf 2>/dev/null || true; usage_snapshot; return ;; esac
    case "$cmd ${1-}" in "share help"|"share -h"|"share --help") usage_share; return ;; esac
    case "$cmd ${1-}" in "edit help"|"edit -h"|"edit --help") usage_edit; return ;; esac
    need_root
    write_default_conf
    load_conf
    set_caller
    # A plain user coming in through the sudoers rule gets snapshots and the
    # shared folder of their own VMs and nothing else.
    is_admin || [[ $cmd == snapshot || $cmd == share ]] \
        || die "you can only use: sudo vmctl snapshot, sudo vmctl share (see: vmctl snapshot help, vmctl share help)"
    # Install anything missing before doing real work. Not at boot (apply) or
    # in the background watcher, which must never wait on a package install.
    case $cmd in create|check) CHECK_VERBOSE=1 ;; esac
    case $cmd in apply|_watch-install|_auto-snapshot) ;; *) ensure_deps; ensure_snapshot_timer ;; esac
    case $cmd in
        create)   cmd_create "$@" ;;
        list|ls)  cmd_list ;;
        info)     cmd_info "${1:?usage: vmctl info NAME}" ;;
        progress|watch) cmd_progress "${1:?usage: vmctl progress NAME}" ;;
        viewer)   cmd_viewer "$@" ;;
        forward|fwd) cmd_forward "$@" ;;
        start)    cmd_start "$@" ;;
        boot)     cmd_boot "$@" ;;
        screen)   cmd_screen "$@" ;;
        password|passwd) cmd_password "$@" ;;
        stop)     load_vm "${1:?NAME}"; "${VIRSH[@]}" shutdown "$1" >/dev/null; msg "Asked $1 to shut down." ;;
        reboot)   cmd_reboot "$@" ;;
        forcestop) load_vm "${1:?NAME}"; "${VIRSH[@]}" destroy "$1" >/dev/null; msg "Powered off $1." ;;
        console)  load_vm "${1:?NAME}"; exec virsh -c qemu:///system console "$1" ;;
        eject)    cmd_eject "$@" ;;
        delete|rm) cmd_delete "$@" ;;
        apply)    apply_forwards; resume_installs ;;
        autostart) cmd_autostart "$@" ;;
        check)    ensure_network; vmsg "Server check finished: ready to run virtual machines" ;;
        disk)     cmd_disk "$@" ;;
        edit)     cmd_edit "$@" ;;
        snapshot|snap) cmd_snapshot "$@" ;;
        owner)    cmd_owner "$@" ;;
        share)    cmd_share "$@" ;;
        _auto-snapshot) cmd_auto_snapshot ;;
        _watch-install) cmd_watch_install "$1" ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"; exit $?
