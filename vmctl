# write_setup_ps1 FILE [tiny11] - runs once at first logon inside Windows, then
# powers off. With tiny11, NVDA comes from the shared folder instead of the
# internet; everything else is the same script.
write_setup_ps1() {
  {
    cat <<'EOF'
# vmctl first-logon setup. Log: C:\vmctl\setup.log
# Every Report line also goes to the COM1 serial port, which the host saves to
# a file - that is how 'vmctl progress' follows the install from the terminal.
param([string]$Src)
$ErrorActionPreference = 'Continue'
$ProgressPreference = 'SilentlyContinue'
New-Item -ItemType Directory -Force -Path C:\vmctl | Out-Null
Start-Transcript -Path C:\vmctl\setup.log -Append | Out-Null
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

function Report([string]$m) {
    Write-Output $m
    try {
        $port = New-Object System.IO.Ports.SerialPort 'COM1', 115200
        $port.Open(); $port.WriteLine("[vmctl] $m"); $port.Close()
    } catch { }
}

# If Windows restarts before this script finishes, run it again at the next
# (automatic) sign-in. Cleared again at the end.
$runOnce = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce'
Set-ItemProperty $runOnce -Name vmctl-setup -Value "powershell -NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`" -Src $Src"

Report "STAGE 4/6 Signed in for the first time; installing drivers and tools"
Report "Trusting the VirtIO driver publishers"
$drv = Join-Path $Src 'vmctl-drivers'
$store = New-Object System.Security.Cryptography.X509Certificates.X509Store('TrustedPublisher', 'LocalMachine')
$store.Open('ReadWrite')
Get-ChildItem $drv -Recurse -Filter *.cat | ForEach-Object { (Get-AuthenticodeSignature $_.FullName).SignerCertificate } |
    Where-Object { $_ } | Sort-Object Thumbprint -Unique | ForEach-Object { $store.Add($_); Write-Output "  trusted: $($_.Subject)" }
$store.Close()

Report "Installing VirtIO drivers (network, memory balloon, serial, input, display)"
pnputil /add-driver "$drv\*.inf" /subdirs /install

Report "Installing the QEMU guest agent"
Start-Process -Wait msiexec.exe -ArgumentList '/i', (Join-Path $Src 'vmctl\qemu-ga-x86_64.msi'), '/qn', '/norestart'

Report "Installing the VirtIO guest tools bundle (SPICE agent)"
$gt = Join-Path $Src 'vmctl\virtio-win-guest-tools.exe'
if (Test-Path $gt) {
    $p = Start-Process -Wait -PassThru -FilePath $gt -ArgumentList '/install','/quiet','/norestart'
    if ($p.ExitCode -ne 0 -and $p.ExitCode -ne 3010) { Report "Guest tools bundle returned code $($p.ExitCode) (not fatal; the drivers are already installed)" }
}

# Data disks: any blank disk becomes an NTFS drive called "Data". Windows
# keeps its drive letter across restarts by itself.
Get-Disk | Where-Object PartitionStyle -eq 'RAW' | ForEach-Object {
    Report "Preparing the data disk ($([math]::Round($_.Size / 1GB)) GB): formatting it as NTFS"
    $v = $_ | Initialize-Disk -PartitionStyle GPT -PassThru | New-Partition -AssignDriveLetter -UseMaximumSize |
         Format-Volume -FileSystem NTFS -NewFileSystemLabel 'Data' -Confirm:$false
    Report "Data disk ready as drive $($v.DriveLetter): (label Data)"
}

Report "Turning on Remote Desktop and turning off sleep"
# Windows expires passwords after 42 days by default, which would lock this
# account out of Remote Desktop next month.
Set-LocalUser -Name $env:USERNAME -PasswordNeverExpires $true
Set-ItemProperty 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name fDenyTSConnections -Value 0
Enable-NetFirewallRule -Group '@FirewallAPI.dll,-28752' -ErrorAction SilentlyContinue
powercfg /change standby-timeout-ac 0
powercfg /change hibernate-timeout-ac 0
powercfg /change monitor-timeout-ac 0
# No hibernation/fast startup: a shut-down VM must have its disks fully closed,
# or restoring a snapshot of only the system disk could damage the data disk.
powercfg /hibernate off

Report "Waiting for the network"
$net = $false
for ($i = 0; $i -lt 60 -and -not $net; $i++) {
    try { Resolve-DnsName api.nvaccess.org -ErrorAction Stop | Out-Null; $net = $true } catch { Start-Sleep 5 }
}
if ($net) { Report "Network is up" } else { Report "WARNING: no internet connection after 5 minutes" }

EOF
    if [[ ${2-} == tiny11 ]]; then
        cat <<'EOF'
Report "Installing WinFsp and the VirtIO-FS service (the shared folder from the server)"
$p = Start-Process -Wait -PassThru msiexec.exe -ArgumentList '/i', (Join-Path $Src 'vmctl\winfsp.msi'), '/qn', '/norestart'
if ($p.ExitCode -ne 0 -and $p.ExitCode -ne 3010) { Report "WinFsp installer returned code $($p.ExitCode)" }
# The guest tools bundle may already have added the service; otherwise add it
# from the driver disc. It starts at every boot, so the drive always comes back.
$fsDir = Join-Path $env:ProgramFiles 'VirtIO-FS'
New-Item -ItemType Directory -Force -Path $fsDir | Out-Null
Copy-Item -Force (Join-Path $drv 'viofs\virtiofs.exe') $fsDir
New-Item -Force -Path 'HKLM:\SOFTWARE\VirtIO-FS' | Out-Null
Set-ItemProperty 'HKLM:\SOFTWARE\VirtIO-FS' -Name MountPoint -Value 'Z:'
if (Get-Service VirtioFsSvc -ErrorAction SilentlyContinue) {
    Set-Service VirtioFsSvc -StartupType Automatic
} else {
    New-Service -Name VirtioFsSvc -BinaryPathName "`"$fsDir\virtiofs.exe`"" -StartupType Automatic `
        -DisplayName 'Virtio FS Service' -DependsOn 'WinFsp.Launcher', 'VirtioFsDrv' | Out-Null
}
$share = $null
for ($i = 0; $i -lt 40 -and -not $share; $i++) {
    Start-Service VirtioFsSvc -ErrorAction SilentlyContinue
    $share = [IO.DriveInfo]::GetDrives() | Where-Object {
        $_.IsReady -and (Test-Path (Join-Path $_.RootDirectory.FullName 'vmctl-shared-folder.txt')) } | Select-Object -First 1
    if (-not $share) { Start-Sleep 3 }
}
if ($share) { Report "The shared folder from the server is drive $($share.Name)" }
else { Report "WARNING: the shared folder from the server did not show up (VirtioFsSvc: $((Get-Service VirtioFsSvc -ErrorAction SilentlyContinue).Status))" }

Report "STAGE 5/6 Installing NVDA from the shared folder"
$nvdaOk = $false
if ($share) {
    $root = $share.RootDirectory.FullName
    $from = Join-Path $root 'nvda-setup.exe'
    $vf = Join-Path $root 'nvda-version.txt'
    $ver = ''
    if (Test-Path $vf) { $ver = (Get-Content $vf -TotalCount 1).Trim() }
    if (Test-Path $from) {
        Report "Installing NVDA $ver from the shared folder"
        $exe = 'C:\vmctl\nvda-setup.exe'
        Copy-Item -Force $from $exe
        # --enable-start-on-logon=True: NVDA also runs on the Windows sign-in screen.
        $p = Start-Process -Wait -PassThru -FilePath $exe -ArgumentList '--install-silent','--enable-start-on-logon=True'
        # "Start NVDA after I sign in" is per user: this user and every future user.
        # The value is NVDA's Ease of Access name, nvda_nvda_v1 - not "nvda".
        $acc = 'Software\Microsoft\Windows NT\CurrentVersion\Accessibility'
        $at = (Get-ItemProperty "HKLM:\$acc" -ErrorAction SilentlyContinue).Configuration
        if (-not $at) { $at = 'nvda_nvda_v1' }
        New-Item -Force -Path "HKCU:\$acc" | Out-Null
        Set-ItemProperty -Path "HKCU:\$acc" -Name Configuration -Value $at
        & reg.exe load 'HKU\vmctlDefault' 'C:\Users\Default\NTUSER.DAT' | Out-Null
        & reg.exe add "HKU\vmctlDefault\$acc" /v Configuration /t REG_SZ /d $at /f | Out-Null
        [gc]::Collect()
        & reg.exe unload 'HKU\vmctlDefault' | Out-Null
        $nvdaOk = (Test-Path "${env:ProgramFiles(x86)}\NVDA\nvda.exe") -or (Test-Path "$env:ProgramFiles\NVDA\nvda.exe")
        Remove-Item -Force -ErrorAction SilentlyContinue $exe
        if ($nvdaOk) {
            Report "NVDA $ver installed; it starts at sign-in and on the sign-in screen"
            Remove-Item -Force -ErrorAction SilentlyContinue $from, $vf
            Report "Deleted the NVDA installer from the shared folder (the folder itself stays)"
        } else { Report "WARNING: the NVDA installer finished (code $($p.ExitCode)) but nvda.exe was not found" }
    } else { Report "WARNING: nvda-setup.exe is not in the shared folder (the server could not download it)" }
}
if (-not $nvdaOk) { Report "WARNING: NVDA could NOT be installed. Put nvda-setup.exe in the shared folder on the server and run it from that drive" }

EOF
    else
        cat <<'EOF'
Report "STAGE 5/6 Downloading and installing NVDA"
$api = 'https://api.nvaccess.org/nvdaUpdateCheck?versionType=stable'
$info = $null
for ($i = 0; $i -lt 20 -and -not $info; $i++) {
    try { $info = (Invoke-WebRequest -UseBasicParsing -Uri $api -TimeoutSec 30).Content } catch { Start-Sleep 15 }
}
$nvdaOk = $false
if ($info) {
    $kv = @{}
    foreach ($line in ($info -split "`n")) { if ($line -match '^\s*(\w+):\s*(.+?)\s*$') { $kv[$Matches[1]] = $Matches[2] } }
    $exe = 'C:\vmctl\nvda-setup.exe'
    $got = $false
    for ($i = 0; $i -lt 5 -and -not $got; $i++) {
        try {
            Report "Downloading NVDA $($kv['version'])"
            Invoke-WebRequest -UseBasicParsing -Uri $kv['launcherUrl'] -OutFile $exe -TimeoutSec 600
            $sha = (Get-FileHash -Algorithm SHA1 $exe).Hash.ToLower()
            if ($kv['launcherHash'] -and $sha -ne $kv['launcherHash'].ToLower()) { throw "SHA1 mismatch: $sha" }
            $got = $true
        } catch { Report "NVDA download attempt failed: $_"; Start-Sleep 20 }
    }
    if ($got) {
        Report "Installing NVDA $($kv['version'])"
        # --enable-start-on-logon=True: NVDA also runs on the Windows sign-in screen.
        $p = Start-Process -Wait -PassThru -FilePath $exe -ArgumentList '--install-silent','--enable-start-on-logon=True'
        # "Start NVDA after I sign in" is per user: this user and every future user.
        # The value is NVDA's Ease of Access name, nvda_nvda_v1 (the same name
        # the installer writes to HKLM for the sign-in screen) - not "nvda".
        $acc = 'Software\Microsoft\Windows NT\CurrentVersion\Accessibility'
        $at = (Get-ItemProperty "HKLM:\$acc" -ErrorAction SilentlyContinue).Configuration
        if (-not $at) { $at = 'nvda_nvda_v1' }
        New-Item -Force -Path "HKCU:\$acc" | Out-Null
        Set-ItemProperty -Path "HKCU:\$acc" -Name Configuration -Value $at
        & reg.exe load 'HKU\vmctlDefault' 'C:\Users\Default\NTUSER.DAT' | Out-Null
        & reg.exe add "HKU\vmctlDefault\$acc" /v Configuration /t REG_SZ /d $at /f | Out-Null
        [gc]::Collect()
        & reg.exe unload 'HKU\vmctlDefault' | Out-Null
        $nvdaOk = (Test-Path "${env:ProgramFiles(x86)}\NVDA\nvda.exe") -or (Test-Path "$env:ProgramFiles\NVDA\nvda.exe")
        if ($nvdaOk) { Report "NVDA $($kv['version']) installed; it starts at sign-in and on the sign-in screen" }
        else { Report "WARNING: the NVDA installer finished (code $($p.ExitCode)) but nvda.exe was not found" }
    }
}
if (-not $nvdaOk) { Report "WARNING: NVDA could NOT be installed. Install it later from https://www.nvaccess.org/download/" }

EOF
    fi
    cat <<'EOF'
Report "STAGE 6/6 Finishing: turning off the one-time automatic sign-in and shutting down"
$wl = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
Set-ItemProperty $wl -Name AutoAdminLogon -Value '0'
Remove-ItemProperty $wl -Name DefaultPassword, AutoLogonCount -ErrorAction SilentlyContinue
Remove-ItemProperty $runOnce -Name vmctl-setup -ErrorAction SilentlyContinue
Remove-Item -Force -ErrorAction SilentlyContinue C:\Windows\Panther\unattend.xml, C:\Windows\Panther\Unattend\unattend.xml

"vmctl setup finished $(Get-Date -Format s); NVDA installed: $nvdaOk" | Out-File C:\vmctl-done.txt
Stop-Transcript | Out-Null
# Powering off tells vmctl on the host that the install is complete.
Stop-Computer -Force
EOF
  } >"$1"
}

build_windows_seed() {   # build_windows_seed NAME USER PASS VIRTIO_ISO OUT_ISO [tiny11 WINFSP_MSI]
    local name=$1 user=$2 pass=$3 virtio=$4 out=$5 flavor=${6-} winfsp=${7-} work mnt
    work=$(mktemp -d); mnt=$(mktemp -d)
    mkdir -p "$work/vmctl" "$work/vmctl-drivers" "$work/vmctl-drivers-pe"
    msg "  Mounting the VirtIO driver disc ($(basename "$virtio")) to copy drivers from it"
    mount -o loop,ro "$virtio" "$mnt"
    # Each driver lives in <driver>/<os>/amd64. (amd64/<os> holds ONLY the
    # storage drivers - using it leaves Windows with no network driver.)
    local d drv n=0
    for d in "$mnt"/*/; do
        drv=$(basename "$d")
        if [[ -d $d$WIN_DRV/amd64 ]]; then
            cp -r "$d$WIN_DRV/amd64" "$work/vmctl-drivers/$drv"; n=$((n + 1))
        elif [[ $WIN_DRV == w11 && -d ${d}w10/amd64 ]]; then
            cp -r "${d}w10/amd64" "$work/vmctl-drivers/$drv"; n=$((n + 1))   # e.g. qxldod has no w11 build
        fi
    done
    if (( n < 5 )) || [[ ! -d $work/vmctl-drivers/NetKVM ]]; then
        umount "$mnt"; rm -rf "$work" "$mnt"
        die "virtio-win.iso does not contain the expected $WIN_DRV drivers"
    fi
    # Windows Setup (WinPE) only gets the disk and network drivers: loading
    # everything there (sriov, viofs, fwcfg...) fails Setup with 0x80070001.
    # The rest are installed with pnputil after the first sign-in.
    for drv in viostor vioscsi NetKVM; do
        [[ -d $work/vmctl-drivers/$drv ]] && cp -r "$work/vmctl-drivers/$drv" "$work/vmctl-drivers-pe/"
    done
    msg "  Copied $n driver packages for Windows ($WIN_DRV); Windows Setup itself gets the disk and network drivers"
    cp "$mnt/virtio-win-guest-tools.exe" "$work/vmctl/"
    cp "$mnt/guest-agent/qemu-ga-x86_64.msi" "$work/vmctl/"
    msg "  Copied the QEMU guest agent and VirtIO guest tools installers"
    if [[ $flavor == tiny11 ]]; then
        cp "$winfsp" "$work/vmctl/winfsp.msi"
        msg "  Copied the WinFsp installer (Windows needs it to see the shared folder)"
    fi
    umount "$mnt"; rmdir "$mnt"
    msg "  Unmounted the VirtIO driver disc"
    msg "  Writing the answer file (autounattend.xml): disk layout, account $user, Remote Desktop, no BitLocker"
    write_autounattend "$work/autounattend.xml" "$name" "$user" "$pass"
    if [[ $flavor == tiny11 ]]; then
        msg "  Writing the first sign-in script (drivers, guest agent, Remote Desktop, shared folder, NVDA from the shared folder)"
    else
        msg "  Writing the first sign-in script (drivers, guest agent, Remote Desktop, NVDA)"
    fi
    write_setup_ps1 "$work/vmctl/setup.ps1" "$flavor"
    sed -i 's/$/\r/' "$work/autounattend.xml" "$work/vmctl/setup.ps1"
    mkiso "$out" VMCTL "$work"
    chmod 600 "$out"
    rm -rf "$work"
    msg "  Built the setup disc ($(basename "$out"))"
}

# ---------------------------------------------------------------- cloud-init
build_cloud_seed() {   # NAME USER PASS SSHKEY OUT [DATA_DISKS]
    local name=$1 user=$2 pass=$3 key=$4 out=$5 disks=${6-} work hash d
    work=$(mktemp -d)
    hash=$(printf '%s' "$pass" | openssl passwd -6 -stdin)
    {
        echo "#cloud-config"
        echo "hostname: $name"
        echo "manage_etc_hosts: true"
        echo "users:"
        echo "  - name: $user"
        echo "    groups: [sudo, adm]"
        echo "    shell: /bin/bash"
        echo "    sudo: 'ALL=(ALL) ALL'"
        echo "    lock_passwd: false"
        echo "    passwd: '$hash'"
        if [[ -n $key ]]; then
            echo "    ssh_authorized_keys:"
            echo "      - '${key//\'/\'\'}'"
        fi
        echo "ssh_pwauth: true"
        echo "package_update: true"
        echo "packages: [qemu-guest-agent, openssh-server]"
        echo "runcmd:"
        echo "  - [systemctl, enable, --now, qemu-guest-agent]"
        echo "  - [systemctl, enable, --now, serial-getty@ttyS0.service]"
        # Data disks: format, mount, and add to /etc/fstab so they stay mounted.
        for d in $disks; do
            echo "  - |"
            linux_disk_script "${d%%:*}" "$user" | sed 's/^/    /'
        done
    } >"$work/user-data"
    printf 'instance-id: %s-%s\nlocal-hostname: %s\n' "$name" "$(date +%s)" "$name" >"$work/meta-data"
    mkiso "$out" cidata "$work"
    chmod 600 "$out"
    rm -rf "$work"
}

