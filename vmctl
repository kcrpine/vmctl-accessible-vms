get_windows_iso() {   # prints path of the ISO to use
    local os=$1 iso="$STORE/isos/$1.iso" url ans
    if [[ -n ${ISO_PATH:-} ]]; then [[ -f $ISO_PATH ]] || die "no such file: $ISO_PATH"; echo "$ISO_PATH"; return; fi
    if [[ -n ${ISO_URL:-} ]]; then rm -f "$iso"; download "$ISO_URL" "$iso" >&2; echo "$iso"; return; fi
    if [[ -f $iso ]]; then msg "Using the cached $WIN_LABEL ISO ($iso)." >&2; echo "$iso"; return; fi
    if [[ -n $WIN_ISO_URL ]]; then download "$WIN_ISO_URL" "$iso" >&2; echo "$iso"; return; fi
    if [[ -z $WIN_MS_PAGE ]]; then
        msg "" >&2
        msg "$WIN_LABEL is not made or hosted by Microsoft, so vmctl cannot download it by itself." >&2
        msg "Either:" >&2
        msg "  1. Paste a download link for a $WIN_LABEL ISO here, or" >&2
        msg "  2. Copy the ISO to this server (for example with scp) and type its full path here." >&2
    else
        msg "Asking Microsoft for a $WIN_LABEL download link..." >&2
        if url=$(ms_consumer_url "$WIN_MS_PAGE"); then download "$url" "$iso" >&2; echo "$iso"; return; fi
        msg "" >&2
        msg "Microsoft will not give this server a $WIN_LABEL download link. It blocks many data-center IP addresses." >&2
        msg "Two ways around it:" >&2
        msg "  1. On your own computer, open https://www.microsoft.com/software-download/$WIN_MS_PAGE, choose the" >&2
        msg "     64-bit English ISO, copy the download link and paste it here. The link expires after 24 hours." >&2
        msg "  2. Copy an ISO to this server (for example with scp) and type its full path here." >&2
    fi
    (( INTERACTIVE )) || die "rerun with --iso-url URL or --iso-path FILE"
    while :; do
        ask ans "Paste a download URL or type a file path"
        if [[ $ans =~ ^https?:// ]]; then download "$ans" "$iso" >&2; echo "$iso"; return
        elif [[ -f $ans ]]; then echo "$ans"; return
        else msg "That is neither a URL nor an existing file." >&2; fi
    done
}

# ---------------------------------------------------------------- Tiny11
# Packages only Tiny11 VMs need, installed the first time one is created:
# virtiofsd (the shared folder), wimtools (reading the edition from the ISO),
# acl (the VM owner keeps access to files Windows writes into the folder).
ensure_tiny11_deps() {
    local miss=()
    [[ -x /usr/libexec/virtiofsd || -x /usr/lib/qemu/virtiofsd ]] || command -v virtiofsd >/dev/null || miss+=(virtiofsd)
    command -v wiminfo >/dev/null || miss+=(wimtools)
    command -v setfacl >/dev/null || miss+=(acl)
    command -v genisoimage >/dev/null || miss+=(genisoimage)   # rebuilding the ISO (UDF)
    (( ${#miss[@]} )) || { vmsg "  Tiny11 extras (virtiofsd, wimtools, acl, genisoimage) are installed"; return 0; }
    msg "Installing what Tiny11 VMs need: ${miss[*]}. Details go to /var/log/vmctl-install.log."
    case $(pkg_mgr) in
        apt)    DEBIAN_FRONTEND=noninteractive apt-get install -y -q "${miss[@]}" >>/var/log/vmctl-install.log 2>&1 ;;
        dnf)    dnf install -y "${miss[@]/wimtools/wimlib-utils}" >>/var/log/vmctl-install.log 2>&1 ;;
        zypper) zypper --non-interactive install "${miss[@]}" >>/var/log/vmctl-install.log 2>&1 ;;
        pacman) local p=("${miss[@]/wimtools/wimlib}"); pacman -S --needed --noconfirm "${p[@]/genisoimage/cdrtools}" >>/var/log/vmctl-install.log 2>&1 ;;
        *) false ;;
    esac || die "could not install ${miss[*]}; install them yourself (see /var/log/vmctl-install.log)"
    msg "  Installed."
}

# prep_tiny11_iso ISO - sets INSTALL_ISO to the ISO Windows Setup should boot,
# and WIN_IMAGE_VAL / WIN_KEY from the edition inside it.
prep_tiny11_iso() {
    local src=$1 out="$STORE/isos/tiny11-vmctl.iso" mnt wim found= names=() n i c pid label efi
    INSTALL_ISO=$src
    # Windows ISOs are UDF (xorriso and isoinfo only see a README stub), so
    # look inside through a read-only loop mount; the kernel reads UDF.
    mnt=$(mktemp -d)
    mount -o loop,ro "$src" "$mnt" 2>/dev/null || { rmdir "$mnt"; die "cannot open the Tiny11 ISO ($src)"; }

    # 1. Which Windows edition(s) are in it? Picks the install image and the
    # generic install key, so Setup does not stop to ask for either.
    for wim in "$mnt"/sources/install.wim "$mnt"/sources/install.esd "$mnt"/sources/install.swm ""; do
        [[ -f $wim ]] && break
    done
    [[ -n $wim ]] && mapfile -t names < <(wiminfo "$wim" 2>/dev/null | sed -n 's/^Name: *//p' || true)
    n=${#names[@]}
    if (( n == 0 )); then
        umount "$mnt"; rmdir "$mnt"
        if [[ -z $wim ]]; then die "this ISO has no sources/install.wim or install.esd; is it really a Tiny11 (Windows) ISO?"
        else die "could not read the Windows editions in this ISO (wiminfo $(basename "$wim") failed)"; fi
    fi
    i=1
    if (( n > 1 )); then
        if [[ -n ${EDITION:-} ]]; then
            i=0
            for c in "${!names[@]}"; do [[ ${names[c],,} == "${EDITION,,}" ]] && i=$((c + 1)); done
            if (( ! i )); then
                umount "$mnt"; rmdir "$mnt"
                die "the ISO has no edition called '$EDITION'; it has: $(printf '%s, ' "${names[@]}" | sed 's/, $//')"
            fi
        elif (( INTERACTIVE )); then
            # (not "menu i": menu has its own local i, which would hide ours)
            menu c "This ISO holds more than one Windows edition. Which one?" "${names[@]}"
            i=$c
        else
            for c in "${!names[@]}"; do [[ ${names[c]} == *Pro* ]] && { i=$((c + 1)); break; }; done
        fi
    fi
    WIN_IMAGE_VAL=$i
    WIN_KEY=
    case ${names[i-1]} in
        *"Pro N"*)  WIN_KEY=2B87N-8KFHP-DKV6R-Y2C8J-PKCKT ;;
        *Pro*)      WIN_KEY=VK7JG-NPHTM-C97JM-9MPGT-3V66T ;;
        *"Home N"*) WIN_KEY=4CPRK-NM3K3-X6XXQ-RXX86-WXCHW ;;
        *Home*)     WIN_KEY=YTMG3-N6DKC-DKB77-7M9GH-8HVX7 ;;
    esac
    msg "Edition to install: ${names[i-1]} (image $i of $n)${WIN_KEY:+, with the generic install key}"
    OS_LABEL="Tiny11 (${names[i-1]})"

    # 2. tiny11builder puts its own autounattend.xml in the root of the ISO.
    # Windows Setup reads the first answer file it finds, which could be that
    # one instead of the one on vmctl's setup disc, and then stops and waits
    # for answers. So boot a copy without it (rebuilt the same way the
    # dockur/windows project does it; -boot-info-table is left out because it
    # would write into the read-only source).
    found=$(find "$mnt" -maxdepth 1 -iname autounattend.xml -printf '%f\n' 2>/dev/null | sed -n 1p || true)
    if [[ -z $found ]]; then
        umount "$mnt"; rmdir "$mnt"
        return 0
    fi
    msg "This ISO has its own answer file ($found), which would get in the way of vmctl's."
    # The copy remembers which ISO it was made from (path, size, time).
    local id; id=$(stat -c '%n %s %Y' "$(readlink -f "$src")")
    if [[ -f $out && $(cat "$out.from" 2>/dev/null) == "$id" ]] && media_ok "$out"; then
        msg "  Using the copy without it that was made earlier ($out)."
        umount "$mnt"; rmdir "$mnt"
        INSTALL_ISO=$out
        return 0
    fi
    efi=efi/microsoft/boot/efisys.bin
    if [[ ! -f $mnt/$efi || ! -f $mnt/boot/etfsboot.com ]]; then
        umount "$mnt"; rmdir "$mnt"
        die "this ISO has no boot files (boot/etfsboot.com, $efi), so vmctl cannot make a copy without $found"
    fi
    label=$(blkid -o value -s LABEL "$src" 2>/dev/null || true)
    label=${label:-TINY11}
    msg "  Making a copy of the ISO without it ($out). This takes a few minutes."
    rm -f "$out" "$out.part" "$out.from"
    genisoimage -o "$out.part" -b boot/etfsboot.com -no-emul-boot -c BOOT.CAT -iso-level 4 -J -l -D -N \
        -joliet-long -relaxed-filenames -V "${label::30}" -udf -eltorito-alt-boot -eltorito-boot "$efi" \
        -no-emul-boot -allow-limited-size -m "$found" -quiet "$mnt" >>/var/log/vmctl-install.log 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        sleep 20
        kill -0 "$pid" 2>/dev/null || break
        msg "  $(human_mb "$(stat -c %s "$out.part" 2>/dev/null || echo 0)") MB written"
    done
    if ! wait "$pid" || ! media_ok "$out.part" "$out"; then
        rm -f "$out.part"; umount "$mnt"; rmdir "$mnt"
        die "making the copy of the Tiny11 ISO failed; see /var/log/vmctl-install.log"
    fi
    umount "$mnt"; rmdir "$mnt"
    mv "$out.part" "$out"
    echo "$id" >"$out.from"
    msg "  Done ($(human_mb "$(stat -c %s "$out")") MB)."
    INSTALL_ISO=$out
}

# The shared folder: in the owner's home when the VM has an owner (so they can
# copy installers into it without root), otherwise in the vmctl store.
share_dir() {   # share_dir NAME  (uses OWNER)
    local home=
    [[ -n ${OWNER:-} ]] && home=$(getent passwd "$OWNER" | cut -d: -f6)
    if [[ -n $home && -d $home ]]; then printf '%s/vmshare/%s' "$home" "$1"
    else printf '%s/shared/%s' "$STORE" "$1"; fi
}

SHARE_NOTE=vmctl-shared-folder.txt   # also how setup.ps1 finds the drive in Windows

make_share() {   # make_share NAME  -> sets SHARE_DIR
    local name=$1 grp
    SHARE_DIR=$(share_dir "$name")
    if [[ $SHARE_DIR == "$STORE/shared/"* ]]; then
        install -d -m 711 "$STORE/shared"
        install -d -m 700 "$SHARE_DIR"
    else
        grp=$(id -gn "$OWNER")
        [[ -d $(dirname "$SHARE_DIR") ]] || install -d -m 750 -o "$OWNER" -g "$grp" "$(dirname "$SHARE_DIR")"
        install -d -m 2770 -o "$OWNER" -g "$grp" "$SHARE_DIR"
        # Windows' files arrive owned by root; these let the owner still read,
        # change and delete them.
        setfacl -m "u:$OWNER:rwx" -m "d:u:$OWNER:rwx" -m "d:g:$grp:rwx" "$SHARE_DIR"
    fi
    if [[ $KIND == windows ]]; then
        cat >"$SHARE_DIR/$SHARE_NOTE" <<EOF
This folder is shared between the server and the VM $name.

On the server it is: $SHARE_DIR
In Windows it is a drive (usually Z:).

Put installers here (for example Firefox or Brave setup files) on the server,
then run them from this drive inside Windows.
EOF
        [[ ${OS:-} == tiny11 ]] && cat >>"$SHARE_DIR/$SHARE_NOTE" <<EOF
Tiny11 comes without a browser.

vmctl put the NVDA installer here during setup and deleted it once NVDA was
installed.
EOF
        echo "Deleting the VM (vmctl delete $name) also deletes this folder." >>"$SHARE_DIR/$SHARE_NOTE"
        sed -i 's/$/\r/' "$SHARE_DIR/$SHARE_NOTE"
    else
        cat >"$SHARE_DIR/$SHARE_NOTE" <<EOF
This folder is shared between the server and the VM $name.

On the server it is: $SHARE_DIR
In the VM it is /mnt/vmshare (and ~/vmshare for the VM's user).

Deleting the VM (vmctl delete $name) also deletes this folder.
EOF
    fi
    [[ -n ${OWNER:-} && $SHARE_DIR != "$STORE/shared/"* ]] && chown "$OWNER:$grp" "$SHARE_DIR/$SHARE_NOTE"
    msg "Shared folder: $SHARE_DIR ($(share_where))"
}

# stage_nvda_on_host DIR - the server downloads the newest NVDA into the shared
# folder (Tiny11 has no browser). Failing here is not fatal: setup reports
# that NVDA is missing, the same as when the in-Windows download fails.
stage_nvda_on_host() {
    local dir=$1 info ver url hash sum
    msg "Downloading NVDA into the shared folder"
    if ! info=$(curl -fsS --retry 5 --retry-delay 5 --retry-all-errors "$NVDA_API" | tr -d '\r'); then
        warn "could not ask NV Access for the newest NVDA; put nvda-setup.exe in $dir yourself"; return 0
    fi
    ver=$(sed -n 's/^ *version: *//p' <<<"$info")
    url=$(sed -n 's/^ *launcherUrl: *//p' <<<"$info")
    hash=$(sed -n 's/^ *launcherHash: *//p' <<<"$info")
    [[ -n $url ]] || { warn "NV Access did not return a download link; put nvda-setup.exe in $dir yourself"; return 0; }
    rm -f "$dir/nvda-setup.exe" "$dir/nvda-setup.exe.part"
    if ! ( download "$url" "$dir/nvda-setup.exe" ); then
        warn "the NVDA download failed; put nvda-setup.exe in $dir yourself"; return 0
    fi
    sum=$(sha1sum "$dir/nvda-setup.exe" | cut -d' ' -f1)
    if [[ -n $hash && ${sum,,} != "${hash,,}" ]]; then
        rm -f "$dir/nvda-setup.exe"
        warn "the NVDA download was damaged (checksum mismatch) and was removed; put nvda-setup.exe in $dir yourself"
        return 0
    fi
    printf '%s\r\n' "$ver" >"$dir/nvda-version.txt"
    [[ $dir == "$STORE/shared/"* || -z ${OWNER:-} ]] || chown "$OWNER:$(id -gn "$OWNER")" "$dir/nvda-setup.exe" "$dir/nvda-version.txt"
    msg "  NVDA $ver is in the shared folder (checksum verified)."
}

# winfsp_msi - prints the path of the cached WinFsp installer (Windows needs it
# for the shared folder), downloading the newest release when missing or old.
winfsp_msi() {
    local f="$STORE/isos/winfsp.msi" url
    [[ -f $f ]] && [[ -z $(find "$f" -mtime +90) ]] && { echo "$f"; return 0; }
    url=$(curl -fsS --retry 5 --retry-delay 5 "$WINFSP_API" \
          | jq -r '.assets[].browser_download_url | select(test("/winfsp-[0-9.]+\\.msi$"))' | head -n1) || true
    if [[ -z $url ]]; then
        [[ -f $f ]] && { echo "$f"; return 0; }
        die "could not find the WinFsp installer on GitHub (needed for the Tiny11 shared folder)"
    fi
    rm -f "$f"
    download "$url" "$f" >&2
    echo "$f"
}

# ---------------------------------------------------------------- shared folders
# One folder on this server per VM, shown inside it (virtiofs): a drive in
# Windows, /mnt/vmshare (and ~/vmshare) in Linux. VM owners manage it with
# "sudo vmctl share". libvirt starts $SHARE_WRAPPER instead of virtiofsd; it
# runs virtiofsd as the VM's owner, so the VM reaches only what that user
# could reach, and everything the VM writes belongs to that user.

ensure_share_deps() {
    local miss=()
    [[ -x /usr/libexec/virtiofsd || -x /usr/lib/qemu/virtiofsd ]] || command -v virtiofsd >/dev/null || miss+=(virtiofsd)
    command -v setfacl >/dev/null || miss+=(acl)
    (( ${#miss[@]} )) || return 0
    msg "Installing what shared folders need: ${miss[*]}. Details go to /var/log/vmctl-install.log."
    case $(pkg_mgr) in
        apt)    DEBIAN_FRONTEND=noninteractive apt-get install -y -q "${miss[@]}" >>/var/log/vmctl-install.log 2>&1 ;;
        dnf)    dnf install -y "${miss[@]}" >>/var/log/vmctl-install.log 2>&1 ;;
        zypper) zypper --non-interactive install "${miss[@]}" >>/var/log/vmctl-install.log 2>&1 ;;
        pacman) pacman -S --needed --noconfirm "${miss[@]}" >>/var/log/vmctl-install.log 2>&1 ;;
        *) false ;;
    esac || die "could not install ${miss[*]}; install them yourself (see /var/log/vmctl-install.log)"
    msg "  Installed."
}

# (Re)writes $SHARE_WRAPPER when it is missing or out of date. It lives in
# /usr/sbin because libvirt's AppArmor profile only lets it start programs
# from the usual system folders.
ensure_share_wrapper() {
    local t; t=$(mktemp)
    cat >"$t" <<'EOF'
#!/bin/bash
# Written by vmctl (do not edit; vmctl rewrites it). libvirt starts this
# instead of virtiofsd for the shared folder of a vmctl VM. It looks the
# folder up in the VM records and runs the real virtiofsd as the VM's owner:
# the VM can reach only what that server user can reach, and everything the
# VM writes there (also as root inside the VM) belongs to that user. A VM
# with no owner (only root and admins use it) gets virtiofsd as root.
real=
for r in /usr/libexec/virtiofsd /usr/lib/qemu/virtiofsd /usr/bin/virtiofsd; do
    [[ -x $r ]] && { real=$r; break; }
done
[[ -n $real ]] || { echo "vmctl-virtiofsd: virtiofsd is not installed" >&2; exit 1; }
dir= prev=
for a in "$@"; do
    case $a in --print-capabilities|--version|-V|--help|-h) exec "$real" "$@" ;; esac
    [[ $prev == --shared-dir ]] && dir=$a
    [[ $a == --shared-dir=* ]] && dir=${a#*=}
    prev=$a
done
[[ -n $dir ]] || { echo "vmctl-virtiofsd: no --shared-dir given" >&2; exit 1; }
found= owner= kind= guest=
for f in @VMS_DIR@/*.env; do
    [[ -f $f ]] || continue
    r=$( . "$f" >/dev/null 2>&1; [[ ${SHARE_DIR-} == "$dir" ]] && printf '%s|%s|%s' "${OWNER-}" "${KIND-}" "${SHARE_GUEST_ID-}" ) || continue
    found=1; IFS='|' read -r owner kind guest <<<"$r"; break
done
[[ -n $found ]] || { echo "vmctl-virtiofsd: $dir is not the shared folder of any vmctl VM" >&2; exit 1; }
[[ -n $owner ]] || exec "$real" "$@"
uid=$(id -u "$owner" 2>/dev/null) && gid=$(id -g "$owner" 2>/dev/null) \
    || { echo "vmctl-virtiofsd: the VM's owner $owner does not exist" >&2; exit 1; }
# Every user in the VM writes as the owner; Linux VMs see the owner's files
# as their own first user (uid 1000 unless vmctl found another one).
extra=(--translate-uid "squash-guest:0:$uid:4294967295" --translate-gid "squash-guest:0:$gid:4294967295")
if [[ $kind == linux ]]; then
    guest=${guest:-1000:1000}
    extra+=(--translate-uid "host:$uid:${guest%%:*}:1" --translate-gid "host:$gid:${guest#*:}:1")
fi
exec setpriv --reuid="$uid" --regid="$gid" --init-groups -- "$real" "$@" "${extra[@]}"
EOF
    sed -i "s|@VMS_DIR@|$VMS_DIR|" "$t"
    if cmp -s "$t" "$SHARE_WRAPPER"; then rm -f "$t"; return 0; fi
    install -m 755 -o root -g root "$t" "$SHARE_WRAPPER"
    rm -f "$t"
}

# Where a VM's shared folder appears inside it, for messages.
share_where() {   # share_where [short]  (uses KIND)
    if [[ $KIND == windows ]]; then echo "a drive in Windows (usually Z:)"
    else echo "/mnt/vmshare inside the VM${USERNAME:+ (also /home/$USERNAME/vmshare)}"; fi
}

# The VM must exist and belong to the caller (admins: any VM). Loads it.
share_vm() {
    load_vm "$1"
    is_admin || [[ -n $OWNER && $OWNER == "$CALLER" ]] \
        || die "$1 is not your VM. You can only give a shared folder to VMs you own (ask the server admin)."
}

# share_resolve_dir NAME FOLDER: prints the folder to share as a real path
# (no symlinks), after checking the caller may share it. Creates it (as the
# owner) when it does not exist yet.
share_resolve_dir() {
    local name=$1 in=$2 home= p e other
    [[ -n ${OWNER:-} ]] && home=$(getent passwd "$OWNER" | cut -d: -f6)
    case $in in
        "~")   in=$home ;;
        "~/"*) in=$home/${in#"~/"} ;;
    esac
    [[ -n $in ]] || die "no folder given"
    [[ $in == /* ]] || in=$PWD/$in   # sudo keeps the folder the user is in
    [[ $in != *[,\'\"\<\>\&$'\n']* ]] || die "the folder name must not contain any of these: , ' \" < > & (or a line break)"
    p=$(realpath -m -- "$in")
    if [[ -n $OWNER ]] && ! is_admin; then
        [[ -n $home && $p == "$home"/* ]] \
            || die "you can only share a folder inside your home folder ($home), and not the home folder itself"
    fi
    [[ $p != / && $p != "$STORE" && $p != /etc* && $p != /root ]] || die "$p cannot be shared"
    if [[ ! -e $p ]]; then
        msg "$p does not exist yet; creating it." >&2
        if [[ -n $OWNER ]]; then runuser -u "$OWNER" -- mkdir -p -- "$p" || die "could not create $p"
        else mkdir -p -- "$p"; fi
    fi
    [[ -d $p ]] || die "$p is not a folder"
    p=$(realpath -e -- "$p")
    if [[ -n $OWNER ]] && ! is_admin && [[ $p != "$home"/* ]]; then
        die "$in leads outside your home folder (through a link), so it cannot be shared"
    fi
    # The sharing runs as the VM's owner, so they must be able to open it.
    if [[ -n $OWNER ]] && ! runuser -u "$OWNER" -- test -r "$p" -a -x "$p" -a -w "$p"; then
        die "$OWNER (the owner of $name) cannot read and write $p, so the VM could not use it"
    fi
    # One folder may serve several VMs of the same owner, never VMs of
    # different owners (the folder decides as whom it is shared).
    for e in "$VMS_DIR"/*.env; do
        [[ $(basename "$e" .env) == "$name" ]] && continue
        other=$( . "$e" >/dev/null 2>&1; [[ ${SHARE_DIR-} == "$p" ]] && printf '%s|%s' "$NAME" "${OWNER-}" ) || continue
        [[ ${other#*|} == "${OWNER:-}" ]] \
            || die "$p is already the shared folder of ${other%%|*}, which has a different owner"
    done
    printf '%s' "$p"
}

# The shared folder in the VM's settings: running ones by default, saved
# ones with --inactive. Prints nothing when it has none.
share_xml_src() {   # share_xml_src NAME [--inactive]
    "${VIRSH[@]}" dumpxml "$@" 2>/dev/null | awk -v tag="$SHARE_TAG" '
        /<filesystem/ { inf = 1; src = ""; hit = 0 }
        inf && /<source dir=/ { s = $0; sub(/.*<source dir=\047/, "", s); sub(/\047.*/, "", s); src = s }
        inf && index($0, "<target dir=\047" tag "\047") { hit = 1 }
        /<\/filesystem>/ { if (hit) print src; inf = 0 }'
}

share_attach() {   # share_attach NAME DIR: into the VM's saved settings (used from its next start)
    local name=$1 dir=$2 vx=(virt-xml --connect qemu:///system "$1")
    if ! "${VIRSH[@]}" dumpxml "$name" --inactive | grep -q "<access mode='shared'/>"; then
        # virtiofs needs the VM's memory to be shareable with virtiofsd.
        "${vx[@]}" --edit --memorybacking source.type=memfd,access.mode=shared >>/var/log/vmctl-install.log 2>&1 \
            || die "could not change $name's memory settings (see /var/log/vmctl-install.log)"
    fi
    if [[ -n $(share_xml_src "$name" --inactive) ]]; then
        "${vx[@]}" --remove-device --filesystem "target.dir=$SHARE_TAG" >>/var/log/vmctl-install.log 2>&1 \
            || die "could not remove the old shared folder from $name's settings"
    fi
    "${vx[@]}" --add-device --filesystem \
        "type=mount,accessmode=passthrough,driver.type=virtiofs,source.dir=$dir,target.dir=$SHARE_TAG,binary.path=$SHARE_WRAPPER" \
        >>/var/log/vmctl-install.log 2>&1 || die "could not add the shared folder to $name's settings (see /var/log/vmctl-install.log)"
}

share_detach() {   # share_detach NAME: out of the saved settings (gone from the next start)
    [[ -n $(share_xml_src "$1" --inactive) ]] || return 0
    virt-xml --connect qemu:///system "$1" --remove-device --filesystem "target.dir=$SHARE_TAG" \
        >>/var/log/vmctl-install.log 2>&1 || die "could not remove the shared folder from $1's settings"
}

# guest_put NAME LOCAL-FILE GUEST-PATH: copy a file into the VM through the
# guest agent, 48 KB at a time.
guest_put() {
    local name=$1 src=$2 dst=$3 h chunk n want pad ok=1
    h=$("${VIRSH[@]}" qemu-agent-command "$name" \
        "$(jq -nc --arg p "$dst" '{execute:"guest-file-open",arguments:{path:$p,mode:"wb"}}')" 2>/dev/null \
        | jq -r '.return // empty') || return 1
    [[ $h =~ ^[0-9]+$ ]] || return 1
    while IFS= read -r chunk; do
        pad=${chunk//[^=]/}
        want=$(( ${#chunk} / 4 * 3 - ${#pad} ))
        n=$("${VIRSH[@]}" qemu-agent-command "$name" \
            "{\"execute\":\"guest-file-write\",\"arguments\":{\"handle\":$h,\"buf-b64\":\"$chunk\"}}" 2>/dev/null \
            | jq -r '.return.count // 0') || n=0
        [[ $n == "$want" ]] || { ok=0; break; }
    done < <(base64 -w 65536 "$src")
    "${VIRSH[@]}" qemu-agent-command "$name" "{\"execute\":\"guest-file-close\",\"arguments\":{\"handle\":$h}}" >/dev/null 2>&1 || ok=0
    (( ok ))
}

# PowerShell run through the guest agent: WinFsp + the VirtIO-FS service
# (C:\vmctl\winfsp.msi and virtiofs.exe were copied in first). Keeps the
# drive letter it had (Tiny11: Z:); otherwise Z:, or the last free letter.
share_windows_ps() {
    cat <<'EOF'
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
try {
    $tmp = 'C:\vmctl'
    if (-not (Get-Service 'WinFsp.Launcher' -ErrorAction SilentlyContinue)) {
        $p = Start-Process -Wait -PassThru msiexec.exe -ArgumentList '/i', "$tmp\winfsp.msi", '/qn', '/norestart'
        if ($p.ExitCode -ne 0 -and $p.ExitCode -ne 3010) { throw "the WinFsp installer failed (code $($p.ExitCode))" }
        'Installed WinFsp.'
    }
    $fsDir = Join-Path $env:ProgramFiles 'VirtIO-FS'
    New-Item -ItemType Directory -Force -Path $fsDir | Out-Null
    $svc = Get-Service VirtioFsSvc -ErrorAction SilentlyContinue
    if ($svc -and $svc.Status -ne 'Stopped') { Stop-Service VirtioFsSvc -Force }
    Copy-Item -Force "$tmp\virtiofs.exe" $fsDir
    $key = 'HKLM:\SOFTWARE\VirtIO-FS'
    if (-not (Test-Path $key)) { New-Item -Path $key | Out-Null }
    $mp = (Get-ItemProperty $key -ErrorAction SilentlyContinue).MountPoint
    if (-not $mp) {
        $used = (Get-PSDrive -PSProvider FileSystem).Name
        $mp = (90..68 | ForEach-Object { [string][char]$_ } | Where-Object { $used -notcontains $_ } | Select-Object -First 1) + ':'
        Set-ItemProperty $key -Name MountPoint -Value $mp
    }
    if ($svc) {
        Set-Service VirtioFsSvc -StartupType Automatic
    } else {
        New-Service -Name VirtioFsSvc -BinaryPathName "`"$fsDir\virtiofs.exe`"" -StartupType Automatic `
            -DisplayName 'Virtio FS Service' -DependsOn 'WinFsp.Launcher', 'VirtioFsDrv' | Out-Null
    }
    $ok = $false
    for ($i = 0; $i -lt 40 -and -not $ok; $i++) {
        Start-Service VirtioFsSvc -ErrorAction SilentlyContinue
        $ok = Test-Path "$mp\"
        if (-not $ok) { Start-Sleep 3 }
    }
    Remove-Item -Force -ErrorAction SilentlyContinue "$tmp\winfsp.msi", "$tmp\virtiofs.exe"
    if (-not $ok) { throw "the shared folder did not show up as $mp (VirtioFsSvc: $((Get-Service VirtioFsSvc).Status))" }
    "The shared folder is drive $mp"
} catch { "ERROR: $($_.Exception.Message)"; exit 1 }
EOF
}

# PowerShell's -EncodedCommand form (UTF-16LE, base64): no quoting trouble on
# the way through the guest agent and the Windows command line.
ps_encode() { iconv -f UTF-8 -t UTF-16LE | base64 -w0; }

share_windows_off_ps() {
    cat <<'EOF'
$ProgressPreference = 'SilentlyContinue'
Stop-Service VirtioFsSvc -Force -ErrorAction SilentlyContinue
Set-Service VirtioFsSvc -StartupType Manual -ErrorAction SilentlyContinue
'Disconnected the shared folder drive.'
EOF
}

# Shell script run as root inside a Linux VM: mount the shared folder at
# /mnt/vmshare now and at every boot, and link it into the user's home.
linux_share_script() {   # linux_share_script [USER]
    cat <<EOF
set -e
u='${1-}'
modprobe virtiofs 2>/dev/null || true
mkdir -p /mnt/vmshare
grep -q '^$SHARE_TAG ' /etc/fstab || echo '$SHARE_TAG /mnt/vmshare virtiofs defaults,nofail,x-gvfs-show 0 0' >>/etc/fstab
command -v systemctl >/dev/null && systemctl daemon-reload 2>/dev/null || true
mountpoint -q /mnt/vmshare || mount /mnt/vmshare
h=
if [ -n "\$u" ]; then
    h=\$(getent passwd "\$u" | cut -d: -f6)
    if [ -n "\$h" ] && [ -d "\$h" ] && [ ! -e "\$h/vmshare" ]; then
        ln -s /mnt/vmshare "\$h/vmshare" && chown -h "\$u:" "\$h/vmshare"
    fi
fi
echo "Mounted at /mnt/vmshare\${h:+ (also \$h/vmshare)}"
[ -n "\$u" ] && echo "guest-id=\$(id -u "\$u" 2>/dev/null):\$(id -g "\$u" 2>/dev/null)" || true
EOF
}

linux_share_off_script() {
    cat <<EOF
umount /mnt/vmshare 2>/dev/null || true
sed -i '/^$SHARE_TAG /d' /etc/fstab
command -v systemctl >/dev/null && systemctl daemon-reload 2>/dev/null || true
for l in /home/*/vmshare; do [ "\$(readlink "\$l")" = /mnt/vmshare ] && rm -f "\$l"; done
rmdir /mnt/vmshare 2>/dev/null || true
echo 'Unmounted the shared folder and removed it from /etc/fstab.'
EOF
}

share_manual_help() {   # what to do by hand when the guest agent is not there
    if [[ $KIND == windows ]]; then
        msg "  The guest agent in $NAME is not answering. Once Windows is running, run: sudo vmctl share setup $NAME"
    else
        msg "  Inside the VM, as root, run this once (it mounts the folder now and at every start):"
        linux_share_script "${USERNAME:-}" | grep -v guest-id | sed 's/^/    /'
        msg "  Or install qemu-guest-agent in the VM and run: sudo vmctl share setup $NAME"
    fi
}

share_wait_agent() {   # share_wait_agent NAME: up to 10 minutes
    local i
    for (( i = 0; i < 600; i += 5 )); do
        agent_up "$1" && return 0
        (( i > 0 && i % 60 == 0 )) && msg "  Still waiting for $1 to start ($(( i / 60 )) minutes so far)."
        sleep 5
    done
    return 1
}

# Set the shared folder up inside the running VM (safe to run again).
share_setup_guest() {   # share_setup_guest NAME  (VM loaded)  -> 1 when it could not
    local name=$1 out tmp mnt exe msi gid
    if [[ $KIND == windows ]]; then
        win_info "$OS"
        msi=$(winfsp_msi) || return 1
        tmp=$(mktemp -d); mnt=$(mktemp -d)
        local VIRTIO_ISO="$STORE/isos/virtio-win.iso"
        [[ -f $VIRTIO_ISO ]] || download "$VIRTIO_URL" "$VIRTIO_ISO"
        mount -o loop,ro "$VIRTIO_ISO" "$mnt" || { rmdir "$mnt"; rm -rf "$tmp"; warn "cannot open $VIRTIO_ISO"; return 1; }
        for exe in "$mnt/viofs/$WIN_DRV/amd64/virtiofs.exe" "$mnt/viofs/w11/amd64/virtiofs.exe" "$mnt/viofs/w10/amd64/virtiofs.exe" ""; do
            [[ -f $exe ]] && break
        done
        [[ -n $exe ]] && cp "$exe" "$tmp/virtiofs.exe"
        umount "$mnt"; rmdir "$mnt"
        [[ -f $tmp/virtiofs.exe ]] || { rm -rf "$tmp"; warn "virtio-win.iso has no viofs/virtiofs.exe"; return 1; }
        msg "  Copying WinFsp and the VirtIO-FS service into Windows"
        guest_exec "$name" 30 cmd.exe /c 'if not exist C:\vmctl mkdir C:\vmctl' >/dev/null 2>&1 || true
        if ! guest_put "$name" "$msi" 'C:\vmctl\winfsp.msi' || ! guest_put "$name" "$tmp/virtiofs.exe" 'C:\vmctl\virtiofs.exe'; then
            rm -rf "$tmp"; warn "copying the files into Windows failed"; return 1
        fi
        rm -rf "$tmp"
        msg "  Installing them and starting the shared folder drive (up to 2 minutes)"
        out=$(guest_exec "$name" 600 powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand "$(share_windows_ps | ps_encode)") \
            || { msg "  $out"; return 1; }
        msg "  $(grep -v -e '^#< CLIXML' -e '^<Objs ' <<<"$out" | tr '\n' ' ' || true)"
    else
        out=$(guest_exec "$name" 120 /bin/sh -c "$(linux_share_script "${USERNAME:-}")") \
            || { msg "  ${out:-the mount command failed}"; return 1; }
        msg "  $(grep -v '^guest-id=' <<<"$out" || true)"
        gid=$(sed -n 's/^guest-id=\([0-9]*:[0-9]*\)$/\1/p' <<<"$out")
        if [[ -n $gid && $gid != "${SHARE_GUEST_ID:-1000:1000}" ]]; then
            # The server shows the owner's files as this user's in the VM.
            set_env "$name" SHARE_GUEST_ID "$gid"
            msg "  (${USERNAME} is $gid in the VM; files in the folder show as theirs from the next restart.)"
        fi
    fi
    event "$name" "Shared folder set up inside the VM: $SHARE_DIR"
}

# After the settings changed: restart or start the VM if allowed, then set
# the folder up inside it. RESTART: yes, no or "" (ask).
share_finish() {   # share_finish NAME RESTART
    local name=$1 restart=$2 st live
    st=$(vm_state "$name")
    live=$(share_xml_src "$name")
    if [[ $st == running && $live == "$SHARE_DIR" ]]; then
        step "Setting the shared folder up inside $name"
    else
        if [[ $st == running ]]; then
            msg "$name has to be switched off and on again to connect it (about a minute or two)."
            if [[ -z $restart ]]; then
                restart=no
                (( INTERACTIVE )) && yes_no "Save your work inside $name first. Restart it now?" && restart=yes
            fi
        else
            msg "$name is $st."
            if [[ -z $restart ]]; then
                restart=no
                (( INTERACTIVE )) && yes_no "Start it now to finish setting up the shared folder inside it?" && restart=yes
            fi
        fi
        if [[ $restart != yes ]]; then
            msg "The shared folder connects the next time $name is switched off and started again"
            msg "(a restart from inside the VM is not enough). Then run: sudo vmctl share setup $NAME"
            return 0
        fi
        if [[ $st == running ]]; then
            step "Restarting $name"
            power_off_clean "$name" ask || die "$name is still running; nothing else was changed. Try again later."
        fi
        "${VIRSH[@]}" start "$name" >/dev/null || die "could not start $name"
        event "$name" "Started (shared folder $SHARE_DIR)"
        msg "Started $name. Waiting for it to finish booting."
        step "Setting the shared folder up inside $name"
    fi
    if ! share_wait_agent "$name"; then
        share_manual_help; return 0
    fi
    share_setup_guest "$name" || { warn "setting the shared folder up inside $name did not work"; share_manual_help; return 0; }
    msg "Done. Put files in $SHARE_DIR on the server; in $name they are in $(share_where)."
}

share_add() {   # vmctl share add NAME [FOLDER] [--restart|--no-restart]
    local name= folder= restart= old def dir
    while (( $# )); do
        case $1 in
            --restart) restart=yes ;;
            --no-restart) restart=no ;;
            -*) die "unknown option $1" ;;
            *) if [[ -z $name ]]; then name=$1; elif [[ -z $folder ]]; then folder=$1; else die "too many arguments"; fi ;;
        esac
        shift
    done
    [[ -n $name ]] || die "usage: sudo vmctl share add NAME [FOLDER] [--restart|--no-restart]"
    share_vm "$name"
    [[ $STATUS != installing ]] || die "$name is still being installed; add a shared folder once it is ready"
    old=${SHARE_DIR:-}
    def=$(share_dir "$name")
    if [[ -z $folder ]]; then
        if (( INTERACTIVE )); then
            msg "Which folder on this server should $name see? Give a path, or press Enter for"
            msg "a new folder just for this VM (deleted together with the VM)."
            [[ -n ${OWNER:-} ]] && msg "It has to be inside $(getent passwd "$OWNER" | cut -d: -f6). ~ means that home folder."
            ask folder "Folder" "${old:-$def}"
        else
            folder=${old:-$def}
        fi
    fi
    ensure_share_deps
    ensure_share_wrapper
    if [[ $folder == "$def" ]]; then
        make_share "$name" >/dev/null
        dir=$SHARE_DIR
    else
        dir=$(share_resolve_dir "$name" "$folder")
    fi
    SHARE_DIR=$dir
    if [[ $dir == "$old" && $(share_xml_src "$name" --inactive) == "$dir" ]]; then
        msg "$name already shares $dir."
    else
        [[ -n $old && $old != "$dir" ]] && msg "This replaces its shared folder $old (that folder and its files stay on the server)."
        share_attach "$name" "$dir"
        set_env "$name" SHARE_DIR "$dir"
        event "$name" "Shared folder set to $dir"
        msg "Shared folder of $name: $dir"
        if [[ $dir == "$def" ]]; then msg "  It belongs to this VM: deleting the VM deletes it too."
        else msg "  It stays yours: deleting the VM leaves it and its files alone."; fi
    fi
    share_finish "$name" "$restart"
}

share_remove() {   # vmctl share remove NAME [--yes]
    local name= yes=0 dir def
    while (( $# )); do
        case $1 in
            -y|--yes) yes=1 ;;
            -*) die "unknown option $1" ;;
            *) [[ -z $name ]] && name=$1 || die "too many arguments" ;;
        esac
        shift
    done
    [[ -n $name ]] || die "usage: sudo vmctl share remove NAME [--yes]"
    share_vm "$name"
    dir=${SHARE_DIR:-}
    [[ -n $dir ]] || { msg "$name has no shared folder."; share_detach "$name"; return 0; }
    if (( ! yes && INTERACTIVE )); then
        yes_no "Disconnect the shared folder $dir from $name?" || die "cancelled"
    fi
    if [[ $(vm_state "$name") == running ]] && agent_up "$name"; then
        msg "Disconnecting it inside $name:"
        if [[ $KIND == windows ]]; then
            msg "  $(guest_exec "$name" 60 powershell.exe -NoProfile -EncodedCommand "$(share_windows_off_ps | ps_encode)" | grep -v -e '^#< CLIXML' -e '^<Objs ' | tr '\n' ' ' || true)"
        else
            msg "  $(guest_exec "$name" 60 /bin/sh -c "$(linux_share_off_script)" || true)"
        fi
    fi
    share_detach "$name"
    set_env "$name" SHARE_DIR ""
    event "$name" "Shared folder removed (was $dir)"
    msg "$name no longer has a shared folder (fully gone the next time it is switched off)."
    def=$(share_dir "$name")
    if [[ $dir == "$def" && -d $dir ]]; then
        if (( INTERACTIVE && ! yes )) && yes_no "Also delete the folder $dir and everything in it?"; then
            rm -rf -- "$dir"; rmdir "$(dirname "$dir")" 2>/dev/null || true
            msg "Deleted $dir."
        else
            msg "The folder $dir and its files are still on the server."
        fi
    else
        msg "The folder $dir and its files are still on the server."
    fi
}

share_setup() {   # vmctl share setup NAME [--restart|--no-restart]
    local name= restart=
    while (( $# )); do
        case $1 in
            --restart) restart=yes ;;
            --no-restart) restart=no ;;
            -*) die "unknown option $1" ;;
            *) [[ -z $name ]] && name=$1 || die "too many arguments" ;;
        esac
        shift
    done
    [[ -n $name ]] || die "usage: sudo vmctl share setup NAME"
    share_vm "$name"
    [[ -n ${SHARE_DIR:-} ]] || die "$name has no shared folder (add one with: sudo vmctl share add $name)"
    [[ $(share_xml_src "$name" --inactive) == "$SHARE_DIR" ]] || { ensure_share_deps; ensure_share_wrapper; share_attach "$name" "$SHARE_DIR"; }
    share_finish "$name" "$restart"
}

share_show() {   # vmctl share show NAME
    local name=${1-} live
    [[ -n $name ]] || die "usage: sudo vmctl share show NAME"
    share_vm "$name"
    if [[ -z ${SHARE_DIR:-} ]]; then msg "$name has no shared folder (add one with: sudo vmctl share add $name)"; return 0; fi
    msg "$name's shared folder: $SHARE_DIR on this server"
    msg "  It shows up as $(share_where)."
    live=$(share_xml_src "$name")
    if [[ $(vm_state "$name") != running ]]; then msg "  $name is switched off; the folder connects when it starts."
    elif [[ $live == "$SHARE_DIR" ]]; then msg "  Connected."
    else msg "  Not connected yet: $name has to be switched off and on again (sudo vmctl share setup $name)."; fi
    if [[ $SHARE_DIR == "$(share_dir "$name")" ]]; then msg "  Deleting the VM deletes this folder too."
    else msg "  Deleting the VM leaves this folder alone."; fi
}

share_list() {   # vmctl share list
    local v n=0
    while read -r v; do
        [[ -n $v ]] || continue
        load_vm "$v"; n=$((n + 1))
        if [[ -n ${SHARE_DIR:-} ]]; then msg "$v: $SHARE_DIR ($(share_where))"
        else msg "$v: no shared folder"; fi
    done < <(my_vms)
    (( n )) || msg "You do not own any VMs."
}

usage_share() {
    cat <<'EOF'
vmctl share - give a VM a folder from this server (for example installers,
music or documents from your home folder). Windows sees it as a drive (Z:),
Linux at /mnt/vmshare (and ~/vmshare for the VM's user). One folder per VM.

  sudo vmctl share                           menu: pick a VM, then what to do
  sudo vmctl share list                      your VMs and their shared folders
  sudo vmctl share show NAME                 a VM's shared folder and whether it is connected
  sudo vmctl share add NAME [FOLDER] [--restart|--no-restart]
                                             share FOLDER (inside your home folder; ~ is your
                                             home) with the VM, or with no FOLDER a new folder
                                             ~/vmshare/NAME that is deleted together with the VM.
                                             Also changes the folder of a VM that has one. The
                                             VM restarts once to connect it (asked first unless
                                             --restart or --no-restart is given)
  sudo vmctl share setup NAME [--restart]    finish connecting it (after a restart you skipped,
                                             or after installing qemu-guest-agent in a Linux VM)
  sudo vmctl share remove NAME [--yes]       disconnect it; your files stay on the server

Whatever the VM writes into the folder belongs to the VM's owner on the
server, and the VM can only reach what its owner can reach. The folder is not
part of snapshots. Linux VMs need qemu-guest-agent for automatic setup;
without it, vmctl prints the two commands to run inside the VM.
EOF
}

share_menu() {
    local vms=() v c name
    while read -r v; do [[ -n $v ]] && vms+=("$v"); done < <(my_vms)
    (( ${#vms[@]} )) || die "you do not own any VMs (ask the server admin to run: vmctl owner NAME $CALLER)"
    if (( ${#vms[@]} == 1 )); then name=${vms[0]}; msg "VM: $name"
    else menu c "Which VM?" "${vms[@]}"; name=${vms[c-1]}; fi
    load_vm "$name"
    if [[ -n ${SHARE_DIR:-} ]]; then
        menu c "$name shares $SHARE_DIR. What do you want to do?" "Show its shared folder" \
            "Share a different folder" "Finish connecting it (restart if needed, set it up inside the VM)" \
            "Disconnect it"
        case $c in
            1) share_show "$name" ;;
            2) share_add "$name" ;;
            3) share_setup "$name" ;;
            4) share_remove "$name" ;;
        esac
    else
        menu c "$name has no shared folder. What do you want to do?" "Add a shared folder" "Nothing"
        [[ $c == 1 ]] && share_add "$name"
        return 0
    fi
}

cmd_share() {
    local sub=${1-}; shift || true
    case $sub in
        "")          (( INTERACTIVE )) || { usage_share; return 1; }; share_menu ;;
        list|ls)     share_list ;;
        show|info)   share_show "$@" ;;
        add|set|change) share_add "$@" ;;
        setup|connect) share_setup "$@" ;;
        remove|rm|off|delete) share_remove "$@" ;;
        help|-h|--help) usage_share ;;
        *) usage_share; return 1 ;;
    esac
}

# Is the VM's shared folder the one vmctl made for it (and deletes with it)?
share_is_own() {   # share_is_own NAME  (VM loaded)
    [[ -n ${SHARE_DIR:-} ]] && [[ $SHARE_DIR == "$(share_dir "$1")" || $SHARE_DIR == "$STORE/shared/$1" ]]
}

xml_escape() {
    local s=$1
    s=${s//&/&amp;}; s=${s//</&lt;}; s=${s//>/&gt;}; s=${s//\"/&quot;}; s=${s//\'/&apos;}
    printf '%s' "$s"
}

