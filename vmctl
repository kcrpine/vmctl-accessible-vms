#!/usr/bin/env bash
# vmctl - build and manage KVM/libvirt VMs on this host.
#
#   * Windows 11 / 10 / 11 LTSC / 10 LTSC: ISO is downloaded, installed fully
#     unattended with VirtIO drivers, sound, RDP on its own host port, and NVDA
#     installed and set to start at sign-in.
#   * Tiny11 (trimmed Windows 11, no browser; you give the ISO): installed the
#     same way, but NVDA is downloaded on this server into a shared folder
#     (virtiofs, drive Z: in Windows) and installed from there. The folder
#     stays, for putting other installers (Firefox, Brave...) into the VM.
#   * Shared folders: VM owners give their VM a folder from their home on
#     this server with "sudo vmctl share" (Windows: a drive, Linux:
#     /mnt/vmshare). virtiofsd runs as the owner, not as root.
#   * Linux: install from an ISO through remote-viewer (SPICE, with sound), or
#     an unattended Debian/Ubuntu cloud image with cloud-init.
#   * Every VM gets a SPICE port and a remote-viewer (.vv) connection file.
#   * Host -> VM port forwards for hosting services.
#   * Missing qemu/libvirt packages are installed on first use.
#
# Run "vmctl help" for usage. Prompts are plain numbered questions so the
# script works well with screen readers; every prompt also has a flag.

set -Eeuo pipefail
shopt -s nullglob

VMCTL_VERSION=1.2
SELF=$(readlink -f "$0")
CONF_DIR=/etc/vmctl
CONF=$CONF_DIR/vmctl.conf
VMS_DIR=$CONF_DIR/vms
VIEWER_DIR=$CONF_DIR/viewer
NFT_FILE=$CONF_DIR/forwards.nft
UNIT=/etc/systemd/system/vmctl-forwards.service
VIRSH=(virsh -q -c qemu:///system)
SHARE_WRAPPER=/usr/sbin/vmctl-virtiofsd   # libvirt starts it instead of virtiofsd (see ensure_share_wrapper)
SHARE_TAG=vmctl-share                      # the shared folder's name inside the VM

# ---------------------------------------------------------------- defaults
# Anything here can be overridden in /etc/vmctl/vmctl.conf.
STORE=/var/lib/libvirt/images/vmctl
NET_NAME=vmctl
BRIDGE=virbr-vmctl
NET_PREFIX=192.168.150
RDP_BASE=13389
SSH_BASE=12201
SPICE_BASE=5910
PUBLIC_HOST=
WIN_LOCALE=en-US
WIN_TIMEZONE=UTC
RESERVE_RAM_MB=4096
BOOT_WATCH_MIN=20
INSTALL_TIMEOUT_MIN=360
# Snapshots: daily run time, how many automatic ones each VM keeps by default
# (owners can change their own up to SNAP_KEEP_MAX), how long a clean shutdown
# may take, and the free space a new snapshot needs on the disk store.
SNAP_TIME=04:00
SNAP_KEEP_DEFAULT=10
SNAP_KEEP_MAX=60
SNAP_SHUTDOWN_TIMEOUT=300
SNAP_MIN_FREE_GB=20

VIRTIO_URL=https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso
NVDA_API='https://api.nvaccess.org/nvdaUpdateCheck?versionType=stable'
WINFSP_API=https://api.github.com/repos/winfsp/winfsp/releases/latest
WIN11LTSC_URL='https://go.microsoft.com/fwlink/?linkid=2289029&clcid=0x409&culture=en-us&country=us'
WIN10LTSC_URL='https://go.microsoft.com/fwlink/p/?LinkID=2195404&clcid=0x409&culture=en-us&country=US'
UA='Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0'

# ---------------------------------------------------------------- output
msg()  { printf '%s\n' "$*"; }
step() { printf '\n== %s\n' "$*"; }
warn() { printf 'Warning: %s\n' "$*" >&2; }
die()  { printf 'Error: %s\n' "$*" >&2; exit 1; }

INTERACTIVE=1
[[ -t 0 ]] || INTERACTIVE=0

# ask VAR "Question" [default]
ask() {
    local __v=$1 __q=$2 __def=${3-} __ans
    if (( ! INTERACTIVE )); then
        [[ -n $__def ]] || die "$__q (no answer given and not running interactively; use the matching flag)"
        printf -v "$__v" '%s' "$__def"; return
    fi
    if [[ -n $__def ]]; then __q="$__q [default: $__def]"; fi
    read -r -p "$__q: " __ans || die "input closed"
    printf -v "$__v" '%s' "${__ans:-$__def}"
}

ask_secret() {
    local __v=$1 q=$2 a b
    (( INTERACTIVE )) || die "$q: not running interactively; use --password"
    while :; do
        read -r -s -p "$q: " a; echo
        [[ -n $a ]] || { msg "The password cannot be empty."; continue; }
        read -r -s -p "Type it again to confirm: " b; echo
        [[ $a == "$b" ]] && break
        msg "The two passwords did not match. Try again."
    done
    printf -v "$__v" '%s' "$a"
}

# menu VAR "Question" option1 option2 ...   -> VAR = chosen number (1-based)
menu() {
    local __v=$1 q=$2; shift 2
    local i n=$# ans
    (( INTERACTIVE )) || die "$q: not running interactively; use the matching flag"
    msg "$q"
    for (( i = 1; i <= n; i++ )); do msg "  $i. ${!i}"; done
    while :; do
        read -r -p "Enter a number from 1 to $n: " ans || die "input closed"
        [[ $ans =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= n )) && break
        msg "That is not one of the choices."
    done
    printf -v "$__v" '%s' "$ans"
}

confirm() {   # confirm "Question"  -> 0 if user typed yes
    local a
    (( INTERACTIVE )) || return 0
    read -r -p "$1 Type yes to continue: " a
    [[ ${a,,} == yes || ${a,,} == y ]]
}

need_root() { (( EUID == 0 )) || die "run vmctl as root (sudo vmctl ...). Your own VMs: sudo vmctl snapshot, sudo vmctl share"; }

# ---------------------------------------------------------------- config
load_conf() {
    # shellcheck source=/dev/null
    [[ -f $CONF ]] && . "$CONF"
    [[ -n $PUBLIC_HOST ]] || PUBLIC_HOST=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
    [[ -n $PUBLIC_HOST ]] || PUBLIC_HOST=$(hostname -f)
}

write_default_conf() {
    [[ -f $CONF ]] && return
    install -d -m 700 "$CONF_DIR" "$VMS_DIR" "$VIEWER_DIR"
    cat >"$CONF" <<EOF
# vmctl settings. Remove the # in front of a line to change it.
# Where disks, ISOs and install media are stored:
#STORE=$STORE
# Host name or IP that remote-viewer files and connection hints point to.
# Empty = this server's main IP address.
#PUBLIC_HOST=
# First host port handed out for each kind of access:
#RDP_BASE=$RDP_BASE
#SSH_BASE=$SSH_BASE
#SPICE_BASE=$SPICE_BASE
# Private network for the VMs (libvirt network "$NET_NAME", bridge $BRIDGE):
#NET_PREFIX=$NET_PREFIX
# Windows language and time zone (Windows time zone names, for example
# "Eastern Standard Time" or "Pacific Standard Time"):
#WIN_LOCALE=$WIN_LOCALE
#WIN_TIMEZONE=$WIN_TIMEZONE
# RAM (MB) kept free for the host when checking a new VM's size:
#RESERVE_RAM_MB=$RESERVE_RAM_MB
# Snapshots: time of the daily run (24-hour clock, change it with
# vmctl snapshot time HH:MM), automatic snapshots kept per VM by default and
# at most, seconds a clean shutdown may take, free GB needed for a snapshot:
#SNAP_TIME=$SNAP_TIME
#SNAP_KEEP_DEFAULT=$SNAP_KEEP_DEFAULT
#SNAP_KEEP_MAX=$SNAP_KEEP_MAX
#SNAP_SHUTDOWN_TIMEOUT=$SNAP_SHUTDOWN_TIMEOUT
#SNAP_MIN_FREE_GB=$SNAP_MIN_FREE_GB
EOF
    chmod 600 "$CONF"
}

vm_env()  { printf '%s/%s.env' "$VMS_DIR" "$1"; }
vm_fwd()  { printf '%s/%s.fwd' "$VMS_DIR" "$1"; }
vm_vv()   { printf '%s/%s.vv' "$VIEWER_DIR" "$1"; }
vm_plog() { printf '%s/logs/%s-progress.log' "$STORE" "$1"; }   # Windows COM1 output
vm_elog() { printf '%s/logs/%s-events.log' "$STORE" "$1"; }     # what vmctl itself did (watcher etc.)

# event NAME TEXT: record an action vmctl took for a VM. 'vmctl progress' and
# the boot follower read these out, so background work is visible too.
event() {
    local name=$1; shift
    printf '%s\n' "$*" >>"$(vm_elog "$name")" 2>/dev/null || true
    logger -t vmctl "$name: $*" 2>/dev/null || true
}

EV_SEEN=0
events_mark() {   # start reading a VM's events from "now"
    local f; f=$(vm_elog "$1")
    EV_SEEN=$( { [[ -f $f ]] && wc -l <"$f"; } || echo 0)
}
show_events() {   # print events written since the last call
    local f n; f=$(vm_elog "$1")
    [[ -f $f ]] || return 0
    n=$(wc -l <"$f")
    (( n > EV_SEEN )) || return 0
    sed -n "$((EV_SEEN + 1)),${n}p" "$f" | sed 's/^/  vmctl: /'
    EV_SEEN=$n
}

# Official remote-viewer (virt-viewer) installer for Windows.
VIEWER_WIN_URL=https://gitlab.com/virt-viewer/virt-viewer/-/releases/v11.0/downloads/virt-viewer-x64-11.0-1.0.msi
viewer_win_hint() { msg "  No remote-viewer on your Windows PC? Install it from: $VIEWER_WIN_URL"; }

vm_exists() { [[ -f $(vm_env "$1") ]]; }

load_vm() {   # sets NAME OS KIND MODE IP MAC SPICE_PORT SPICE_PASS ALLOW STATUS ...
    local f
    # The name becomes a file that is sourced as root (also for sudo users), so
    # never let it point outside $VMS_DIR.
    [[ $1 =~ ^[A-Za-z][A-Za-z0-9-]{0,14}$ ]] || die "no VM called '$1' (see: vmctl list)"
    OWNER= SNAP_AUTO= SNAP_KEEP= SHARE_DIR= SHARE_GUEST_ID=   # older records do not have these
    f=$(vm_env "$1")
    [[ -f $f ]] || die "no VM called '$1' (see: vmctl list)"
    # shellcheck source=/dev/null
    . "$f"
}

save_vm() {   # save_vm NAME  (writes the variables listed below)
    local f k; f=$(vm_env "$1")
    {
        for k in NAME OS OS_LABEL KIND MODE IP MAC SPICE_PORT SPICE_PASS ALLOW STATUS AUTOSTART DATA_DISKS \
                 RAM_MB CPUS DISK_GB DISK SEED USERNAME CREATED OWNER SNAP_AUTO SNAP_KEEP SHARE_DIR SHARE_GUEST_ID; do
            printf '%s=%q\n' "$k" "${!k-}"
        done
    } >"$f.tmp"
    chmod 600 "$f.tmp"; mv "$f.tmp" "$f"
}

set_status() {
    local name=$1 st=$2
    sed -i "s/^STATUS=.*/STATUS=$st/" "$(vm_env "$name")"
}

set_env() {   # set_env NAME KEY VALUE: change (or add) one setting in a VM's record
    local f k=$2 v; f=$(vm_env "$1")
    v=$(printf '%q' "$3")
    if grep -q "^$k=" "$f"; then
        grep -v "^$k=" "$f" >"$f.tmp"; printf '%s=%s\n' "$k" "$v" >>"$f.tmp"
        chmod 600 "$f.tmp"; mv "$f.tmp" "$f"
    else
        printf '%s=%s\n' "$k" "$v" >>"$f"
    fi
}

# ---------------------------------------------------------------- guest agent
# guest_exec NAME SECONDS PROGRAM [ARG...]: run a program inside the VM through
# the QEMU guest agent; prints its output and returns its exit code.
guest_exec() {
    local name=$1 tmo=$2 prog=$3 args pid r i code
    shift 3
    # Each argument becomes one JSON string, even if it spans several lines or
    # starts with "-" (NUL-separated, so jq never reads them as its own options).
    args=$(printf '%s\0' "$@" | jq -Rsc 'split("\u0000") | .[:-1]')
    pid=$("${VIRSH[@]}" qemu-agent-command "$name" \
        "$(jq -nc --arg p "$prog" --argjson a "$args" '{execute:"guest-exec",arguments:{path:$p,arg:$a,"capture-output":true}}')" 2>/dev/null \
        | jq -r '.return.pid // empty') || return 1
    [[ -n $pid ]] || return 1
    for (( i = 0; i < tmo; i++ )); do
        r=$("${VIRSH[@]}" qemu-agent-command "$name" "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":$pid}}" 2>/dev/null) || return 1
        [[ $(jq -r '.return.exited' <<<"$r") == true ]] && break
        sleep 1
    done
    jq -r '.return["out-data"] // empty' <<<"$r" | base64 -d 2>/dev/null | tr -d '\r' || true
    jq -r '.return["err-data"] // empty' <<<"$r" | base64 -d 2>/dev/null | tr -d '\r' || true
    code=$(jq -r '.return.exitcode // 1' <<<"$r")
    return "$code"
}

agent_up() { "${VIRSH[@]}" qemu-agent-command "$1" '{"execute":"guest-ping"}' >/dev/null 2>&1; }

# ---------------------------------------------------------------- data disks
# DATA_DISKS in a VM's record: "data1:100 data2:50" (disk id : size in GB).
# Each is <store>/disks/<vm>-<id>.qcow2 with virtio serial "vmctl-<id>".
data_disk_path() { printf '%s/disks/%s-%s.qcow2' "$STORE" "$1" "$2"; }

data_disk_mount() {   # where a Linux guest mounts a data disk: data1 -> /data, data2 -> /data2
    if [[ $1 == data1 ]]; then echo /data; else echo "/${1}"; fi
}

# Shell script that formats (only if empty), labels, mounts and adds a data
# disk to /etc/fstab inside a Linux guest. Safe to run more than once.
linux_disk_script() {   # linux_disk_script ID [OWNER]
    local id=$1 owner=${2-} mnt; mnt=$(data_disk_mount "$id")
    cat <<EOF
dev=/dev/disk/by-id/virtio-vmctl-$id
i=0; while [ ! -e "\$dev" ] && [ \$i -lt 30 ]; do sleep 1; i=\$((i+1)); done
[ -e "\$dev" ] || { echo "data disk $id not found"; exit 1; }
blkid "\$dev" >/dev/null 2>&1 || mkfs.ext4 -q -L vmctl-$id "\$dev"
mkdir -p $mnt
grep -q "LABEL=vmctl-$id " /etc/fstab || echo "LABEL=vmctl-$id $mnt ext4 defaults,nofail 0 2" >>/etc/fstab
mountpoint -q $mnt || mount $mnt
${owner:+id -u $owner >/dev/null 2>&1 && chown $owner: $mnt}
echo "data disk $id mounted at $mnt (\$(df -h --output=size $mnt | tail -n1 | tr -d ' ') total), kept in /etc/fstab"
EOF
}

# PowerShell that turns every blank (RAW) disk into an NTFS "Data" drive with
# a drive letter. Windows keeps the letter across restarts by itself.
windows_disk_ps() {
    cat <<'EOF'
Get-Disk | Where-Object PartitionStyle -eq 'RAW' | ForEach-Object {
    $v = $_ | Initialize-Disk -PartitionStyle GPT -PassThru | New-Partition -AssignDriveLetter -UseMaximumSize |
         Format-Volume -FileSystem NTFS -NewFileSystemLabel 'Data' -Confirm:$false
    "data disk ready as drive $($v.DriveLetter): ($([math]::Round($v.Size / 1GB)) GB, label Data)"
}
EOF
}

# Attach <vm>-<id>.qcow2 as a virtio disk with serial vmctl-<id>: to the saved
# settings always, and to the running VM too if it is running. Prints the
# target (vdb, vdc...).
attach_data_disk() {   # NAME ID
    local name=$1 id=$2 path used t target= xml flags=(--config)
    path=$(data_disk_path "$name" "$id")
    used=$("${VIRSH[@]}" domblklist "$name" | awk '{print $1}')
    for t in vdb vdc vdd vde vdf vdg vdh vdi vdj vdk; do
        grep -qx "$t" <<<"$used" || { target=$t; break; }
    done
    [[ -n $target ]] || return 1
    xml=$(mktemp)
    cat >"$xml" <<EOF
<disk type='file' device='disk'>
  <driver name='qemu' type='qcow2' cache='none' discard='unmap'/>
  <source file='$path'/>
  <target dev='$target' bus='virtio'/>
  <serial>vmctl-$id</serial>
</disk>
EOF
    [[ $(vm_state "$name") == running ]] && flags+=(--live)
    if ! "${VIRSH[@]}" attach-device "$name" "$xml" "${flags[@]}" >/dev/null; then rm -f "$xml"; return 1; fi
    rm -f "$xml"
    echo "$target"
}

# Prepare all data disks inside a running guest via the guest agent.
setup_data_disks_in_guest() {   # NAME  -> 0 ok, 1 could not
    local name=$1 d id out
    load_vm "$name"
    [[ -n ${DATA_DISKS:-} ]] || { msg "$name has no data disks."; return 0; }
    agent_up "$name" || return 1
    if [[ $KIND == windows ]]; then
        out=$(guest_exec "$name" 300 powershell.exe -NoProfile -Command "$(windows_disk_ps)") || return 1
        [[ -n $out ]] && msg "  $out" || msg "  The data disks were already set up."
    else
        for d in $DATA_DISKS; do
            id=${d%%:*}
            out=$(guest_exec "$name" 300 /bin/sh -c "$(linux_disk_script "$id" "${USERNAME:-}")") || { msg "  $out"; return 1; }
            msg "  $out"
        done
    fi
}

manual_disk_help() {   # what to run by hand when the guest agent is not there
    local name=$1 d id
    load_vm "$name"
    if [[ $KIND == windows ]]; then
        msg "  In Windows: open Disk Management, initialise the new disk (GPT), create a volume and give it a letter."
    else
        msg "  Inside the VM, as root, run this for each data disk (it formats, mounts and adds it to /etc/fstab):"
        for d in $DATA_DISKS; do
            id=${d%%:*}
            msg "    # $id"
            linux_disk_script "$id" "${USERNAME:-}" | sed 's/^/    /'
        done
        msg "  Or install qemu-guest-agent in the VM and run: vmctl disk setup $name"
    fi
}

# ---------------------------------------------------------------- dependencies
pkg_mgr() {
    if command -v apt-get >/dev/null; then echo apt
    elif command -v dnf >/dev/null; then echo dnf
    elif command -v zypper >/dev/null; then echo zypper
    elif command -v pacman >/dev/null; then echo pacman
    else echo none; fi
}

ovmf_present() {
    local f
    for f in /usr/share/OVMF/OVMF_CODE*.fd /usr/share/edk2/ovmf/OVMF_CODE*.fd \
             /usr/share/edk2/x64/OVMF_CODE*.fd /usr/share/qemu/ovmf-x86_64*.bin; do
        return 0
    done
    return 1
}

deps_missing() {   # prints what is missing, one per line (nothing = all there)
    local c
    for c in virsh virt-install qemu-img curl jq openssl nft ss swtpm python3; do
        command -v "$c" >/dev/null || echo "$c"
    done
    command -v genisoimage >/dev/null || command -v mkisofs >/dev/null || command -v xorriso >/dev/null || echo "genisoimage"
    [[ -x /usr/bin/qemu-system-x86_64 || -x /usr/libexec/qemu-kvm ]] || command -v qemu-system-x86_64 >/dev/null || echo "qemu"
    ovmf_present || echo "OVMF (UEFI firmware)"
    # Screen reading (boot messages, sign-in detection) needs OCR.
    command -v tesseract >/dev/null || echo "tesseract (OCR)"
    python3 -c "import PIL" 2>/dev/null || echo "python3 Pillow"
    return 0
}
deps_ok() { [[ -z $(deps_missing) ]]; }

# Kernel modules VMs need, loaded now and on every boot (/etc/modules-load.d).
# name|why|required (1 = cannot run VMs without it)
kernel_module_list() {
    local cpu=kvm_intel
    grep -q AuthenticAMD /proc/cpuinfo && cpu=kvm_amd
    cat <<EOF
kvm|hardware virtualization (KVM)|1
$cpu|hardware virtualization for this CPU|1
tun|virtual network cards for VMs|1
vhost_net|fast VM networking|0
loop|mounting ISO images (VirtIO drivers)|1
nf_tables|firewall tables for port forwards|1
nft_nat|address translation for port forwards|0
nft_masq|internet access for VMs (masquerade)|0
nft_fib_ipv4|recognising this server's own addresses in forwards|0
EOF
}

module_loaded() {   # built into the kernel or loaded as a module
    [[ -d /sys/module/$1 ]] || grep -qw "$1" "/lib/modules/$(uname -r)/modules.builtin" 2>/dev/null
}

CHECK_VERBOSE=0   # 1 = print every step of the server check (create, check)
vmsg() { (( CHECK_VERBOSE )) && msg "$@"; return 0; }

ensure_kernel_modules() {
    local mod why req want=() changed=0 conf=/etc/modules-load.d/vmctl.conf
    vmsg "Checking the processor and kernel for virtual machines:"
    if grep -Eq '\b(vmx|svm)\b' /proc/cpuinfo; then
        vmsg "  Processor: hardware virtualization ($(grep -q svm /proc/cpuinfo && echo AMD-V || echo Intel VT-x)) is available"
    else
        msg "  Processor: no VT-x / AMD-V flag found; it may be switched off in the BIOS"
    fi
    while IFS='|' read -r mod why req; do
        want+=("$mod")
        if module_loaded "$mod"; then
            vmsg "  Kernel module $mod: already loaded ($why)"
            continue
        fi
        msg "  Kernel module $mod: not loaded, loading it now ($why)"
        if modprobe "$mod" 2>/dev/null; then
            msg "  Kernel module $mod: loaded"
        else
            if (( req )); then
                case $mod in
                    kvm*) die "cannot load $mod: enable VT-x / AMD-V (virtualization) in the BIOS, or nested virtualization on a VPS" ;;
                    *)    die "cannot load the $mod kernel module, which is needed for $why" ;;
                esac
            fi
            warn "could not load $mod ($why); continuing without it"
        fi
    done < <(kernel_module_list)
    [[ -e /dev/kvm ]] || die "/dev/kvm is missing: enable VT-x / AMD-V in the BIOS (or nested virtualization on a VPS)"
    vmsg "  /dev/kvm is present: VMs will run with hardware acceleration"
    # Load them again on every boot.
    if [[ ! -f $conf ]] || [[ $(grep -v '^#' "$conf") != "$(printf '%s\n' "${want[@]}")" ]]; then
        { echo "# Kernel modules needed by vmctl's virtual machines (written by vmctl)"; printf '%s\n' "${want[@]}"; } >"$conf"
        changed=1
    fi
    if (( changed )); then msg "  Saved the kernel module list in $conf so they load on every boot"
    else vmsg "  The module list in $conf makes them load on every boot"; fi
    return 0
}

ensure_deps() {
    (( CHECK_VERBOSE )) && step "Checking this server"
    vmsg "Checking the required software (QEMU, libvirt, virt-install, UEFI firmware, TPM emulator, OCR...)"
    if ! deps_ok; then
        step "Installing missing software: $(deps_missing | paste -sd, - | sed 's/,/, /g')"
        local pm; pm=$(pkg_mgr)
        case $pm in
            apt)
                local want=(qemu-system-x86 qemu-utils qemu-system-modules-spice libvirt-daemon-system
                            libvirt-clients virtinst ovmf swtpm swtpm-tools genisoimage curl jq openssl
                            nftables dnsmasq-base iproute2 tesseract-ocr python3-pil) have=() p
                export DEBIAN_FRONTEND=noninteractive
                msg "This takes a minute or two. Details go to /var/log/vmctl-install.log."
                apt-get update -q >>/var/log/vmctl-install.log 2>&1
                # Older releases lack some packages (e.g. spice is built in); skip those.
                for p in "${want[@]}"; do apt-cache show "$p" >/dev/null 2>&1 && have+=("$p"); done
                apt-get install -y -q "${have[@]}" >>/var/log/vmctl-install.log 2>&1 \
                    || die "package installation failed; see /var/log/vmctl-install.log"
                msg "Packages installed." ;;
            dnf)    dnf install -y qemu-kvm qemu-img libvirt virt-install edk2-ovmf swtpm swtpm-tools \
                        xorriso curl jq openssl nftables iproute tesseract python3-pillow ;;
            zypper) zypper --non-interactive install qemu-kvm libvirt virt-install qemu-ovmf-x86_64 swtpm \
                        xorriso curl jq openssl nftables iproute2 tesseract-ocr tesseract-ocr-traineddata-english python3-Pillow ;;
            pacman) pacman -Sy --needed --noconfirm qemu-full libvirt virt-install edk2-ovmf swtpm \
                        libisoburn curl jq openssl nftables dnsmasq iproute2 tesseract tesseract-data-eng python-pillow ;;
            *) die "no supported package manager found; install qemu, libvirt, virt-install, OVMF, swtpm, genisoimage, curl, jq, tesseract (OCR) and python3 Pillow yourself" ;;
        esac
        deps_ok || die "some required tools are still missing after installing packages"
    else
        vmsg "  All required software is installed"
    fi

    ensure_kernel_modules

    vmsg "Checking the libvirt service"
    if ! "${VIRSH[@]}" uri >/dev/null 2>&1; then
        local u
        msg "  libvirt is not answering; starting its services"
        if systemctl list-unit-files libvirtd.socket >/dev/null 2>&1; then
            systemctl enable --now libvirtd.socket libvirtd.service >/dev/null 2>&1 || true
        fi
        for u in virtqemud.socket virtnetworkd.socket virtstoraged.socket; do
            systemctl list-unit-files "$u" >/dev/null 2>&1 && systemctl enable --now "$u" >/dev/null 2>&1 || true
        done
        "${VIRSH[@]}" uri >/dev/null 2>&1 || die "cannot connect to libvirt (qemu:///system)"
        msg "  libvirt started"
    else
        vmsg "  libvirt is running ($("${VIRSH[@]}" version --daemon 2>/dev/null | sed -n 's/^Running against daemon: *//p' | head -n1))"
    fi
    ensure_ocr || true
    install -d -m 711 "$STORE" "$STORE/isos" "$STORE/disks" "$STORE/logs"
    install -d -m 711 "$STORE/seed"
    install -d -m 700 "$CONF_DIR" "$VMS_DIR" "$VIEWER_DIR"
    ensure_unit
    configure_guest_shutdown
}

mkiso() {   # mkiso OUT LABEL DIR
    local out=$1 label=$2 dir=$3
    if command -v genisoimage >/dev/null; then genisoimage -quiet -o "$out" -V "$label" -J -r -iso-level 4 "$dir"
    elif command -v mkisofs >/dev/null; then mkisofs -quiet -o "$out" -V "$label" -J -r -iso-level 4 "$dir"
    else xorriso -as mkisofs -quiet -o "$out" -V "$label" -J -r -iso-level 4 "$dir"; fi
}

# ---------------------------------------------------------------- firewall
fw_mode() {
    if command -v ufw >/dev/null && [[ $(ufw status 2>/dev/null) == "Status: active"* ]]; then echo ufw
    elif command -v iptables >/dev/null; then echo iptables
    else echo none; fi
}

ufw_add() {   # ufw_add <ufw args...>   (ufw itself skips exact duplicates)
    ufw "$@" >/dev/null || warn "ufw $* failed"
}

ufw_delete_comment() {   # delete every ufw rule whose comment matches the regex
    local re=$1 n
    while :; do
        n=$(ufw status numbered | { grep -E "# ${re}\$" || true; } | tail -n1 | sed -E 's/^\[ *([0-9]+)\].*/\1/')
        [[ -n $n ]] || break
        ufw --force delete "$n" >/dev/null
    done
}

split_allow() {   # "a,b c" -> one source per line; empty/any -> any
    local s=${1:-any}
    s=${s//,/ }
    [[ -z ${s// } ]] && s=any
    tr ' ' '\n' <<<"$s" | sed '/^$/d'
}

valid_allow() {
    local s
    while read -r s; do
        [[ $s == any || $s =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$ || $s =~ ^[0-9a-fA-F:]+(/[0-9]{1,3})?$ ]] \
            || { warn "'$s' is not an IP address or subnet"; return 1; }
    done < <(split_allow "$1")
}

# Rules for the private VM network itself (DHCP/DNS to the host, VM traffic out).
fw_net() {
    local have
    case $(fw_mode) in
        ufw)
            have=$(ufw status | grep -c '# vmctl:net$' || true)
            if (( have >= 3 )); then
                vmsg "  Firewall (ufw): the VM network rules are in place"
                return 0
            fi
            msg "  Firewall (ufw): letting VMs use this server's DHCP (port 67) and DNS (port 53)"
            ufw_add allow in on "$BRIDGE" to any port 67 proto udp comment vmctl:net
            ufw_add allow in on "$BRIDGE" to any port 53 comment vmctl:net
            msg "  Firewall (ufw): letting VM traffic out to the internet (routed through $BRIDGE)"
            ufw_add route allow in on "$BRIDGE" comment vmctl:net ;;
        iptables)
            vmsg "  Firewall: no ufw; vmctl's own iptables chains (VMCTL-IN, VMCTL-FWD) handle the VM network" ;;
        *)
            vmsg "  Firewall: none found; nothing to open" ;;
    esac
}

# Add the ufw rules for one VM: SPICE port plus every forward.
fw_vm_add() {
    local name=$1 src proto hp gp allow label
    load_vm "$name"
    [[ $(fw_mode) == ufw ]] || return 0
    if ! grep -q '^SPICE_CLOSED=1' "$(vm_env "$name")"; then
        while read -r src; do
            ufw_add allow proto tcp from "$src" to any port "$SPICE_PORT" comment "vmctl:$name:spice"
        done < <(split_allow "$ALLOW")
    fi
    [[ -f $(vm_fwd "$name") ]] || return 0
    while read -r proto hp gp allow label; do
        [[ -n ${proto:-} && ${proto:0:1} != '#' ]] || continue
        while read -r src; do
            ufw_add route allow proto "$proto" from "$src" to "$IP" port "$gp" comment "vmctl:$name:$proto:$hp"
        done < <(split_allow "$allow")
    done <"$(vm_fwd "$name")"
}

fw_vm_del() {   # fw_vm_del NAME [suffix-regex]
    [[ $(fw_mode) == ufw ]] || return 0
    ufw_delete_comment "vmctl:$1:${2:-.*}"
}

# Rebuild the nftables DNAT/masquerade table from every VM's .fwd file, plus
# plain-iptables accept rules on hosts without ufw.
dnat_rules() {   # one "fib daddr type local ... dnat" line per forward of every VM
    local f name ip proto hp gp allow label
    for f in "$VMS_DIR"/*.fwd; do
        name=$(basename "$f" .fwd)
        [[ -f $(vm_env "$name") ]] || continue
        ip=$(sed -n 's/^IP=//p' "$(vm_env "$name")")
        echo "    # $name"
        while read -r proto hp gp allow label; do
            [[ -n ${proto:-} && ${proto:0:1} != '#' ]] || continue
            echo "    fib daddr type local $proto dport $hp dnat to $ip:$gp"
        done <"$f"
    done
}

apply_forwards() {
    local name proto hp gp allow label tmp rules
    tmp=$(mktemp)
    rules=$(dnat_rules)
    {
        echo "# Generated by vmctl - do not edit; use 'vmctl forward'."
        echo "table ip vmctl"
        echo "delete table ip vmctl"
        echo "table ip vmctl {"
        echo "  chain prerouting {"
        echo "    type nat hook prerouting priority dstnat; policy accept;"
        echo "$rules"
        echo "  }"
        echo "  chain output {"
        echo "    type nat hook output priority -100; policy accept;"
        echo "$rules"
        echo "  }"
        echo "  chain postrouting {"
        echo "    type nat hook postrouting priority srcnat; policy accept;"
        echo "    ip saddr $NET_PREFIX.0/24 ip daddr != { $NET_PREFIX.0/24, 224.0.0.0/24, 255.255.255.255 } masquerade"
        echo "    ip saddr $NET_PREFIX.0/24 ip daddr $NET_PREFIX.0/24 ct status dnat masquerade"
        echo "  }"
        echo "}"
    } >"$tmp"
    install -m 600 "$tmp" "$NFT_FILE"; rm -f "$tmp"
    nft -f "$NFT_FILE" || die "nft rejected $NFT_FILE"

    if [[ $(fw_mode) == iptables ]]; then
        # Own chains so a rebuild never touches anyone else's rules.
        local ch
        for ch in VMCTL-FWD VMCTL-IN; do iptables -N "$ch" 2>/dev/null || iptables -F "$ch"; done
        iptables -C FORWARD -j VMCTL-FWD 2>/dev/null || iptables -I FORWARD 1 -j VMCTL-FWD
        iptables -C INPUT -j VMCTL-IN 2>/dev/null || iptables -I INPUT 1 -j VMCTL-IN
        iptables -A VMCTL-FWD -i "$BRIDGE" -j ACCEPT
        iptables -A VMCTL-FWD -o "$BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
        iptables -A VMCTL-IN -i "$BRIDGE" -p udp --dport 67 -j ACCEPT
        iptables -A VMCTL-IN -i "$BRIDGE" -p udp --dport 53 -j ACCEPT
        iptables -A VMCTL-IN -i "$BRIDGE" -p tcp --dport 53 -j ACCEPT
        local e src
        for e in "$VMS_DIR"/*.env; do
            name=$(basename "$e" .env)
            ( load_vm "$name"
              if ! grep -q '^SPICE_CLOSED=1' "$e"; then
                  while read -r src; do
                      if [[ $src == any ]]; then iptables -A VMCTL-IN -p tcp --dport "$SPICE_PORT" -j ACCEPT
                      else iptables -A VMCTL-IN -s "$src" -p tcp --dport "$SPICE_PORT" -j ACCEPT 2>/dev/null || true; fi
                  done < <(split_allow "$ALLOW")
              fi
              [[ -f $(vm_fwd "$name") ]] || exit 0
              while read -r proto hp gp allow label; do
                  [[ -n ${proto:-} && ${proto:0:1} != '#' ]] || continue
                  while read -r src; do
                      if [[ $src == any ]]; then iptables -A VMCTL-FWD -d "$IP" -p "$proto" --dport "$gp" -j ACCEPT
                      else iptables -A VMCTL-FWD -s "$src" -d "$IP" -p "$proto" --dport "$gp" -j ACCEPT 2>/dev/null || true; fi
                  done < <(split_allow "$allow")
              done <"$(vm_fwd "$name")" )
        done
    fi
}

# When the server shuts down, shut every VM down cleanly; when it boots, start
# only the VMs with automatic start on. (libvirt's defaults instead suspend VMs
# to disk and bring back whatever happened to be running.)
configure_guest_shutdown() {
    local f=/etc/default/libvirt-guests
    [[ -d /etc/sysconfig && ! -f $f ]] && f=/etc/sysconfig/libvirt-guests
    systemctl cat libvirt-guests.service >/dev/null 2>&1 || return 0
    grep -q '^# vmctl settings' "$f" 2>/dev/null && return 0
    [[ -f $f ]] && cp -n "$f" "$f.bak-vmctl"
    cat >>"$f" <<'EOF'

# vmctl settings: when this server shuts down, every VM is shut down cleanly
# (each gets up to 5 minutes); when it boots, only VMs with automatic start
# on are started (vmctl autostart NAME on|off).
ON_BOOT=ignore
ON_SHUTDOWN=shutdown
SHUTDOWN_TIMEOUT=300
PARALLEL_SHUTDOWN=4
EOF
    systemctl enable libvirt-guests.service >/dev/null 2>&1 || true
}

# After a server restart: give unfinished Windows installs their watcher back
# (the VM is started even if automatic start is off, so setup can finish).
resume_installs() {
    local e name
    for e in "$VMS_DIR"/*.env; do
        name=$(basename "$e" .env)
        grep -q '^STATUS=installing$' "$e" || continue
        if [[ $(vm_state "$name") != running ]]; then
            event "$name" "The server restarted during the Windows install; starting the VM so setup can continue"
            "${VIRSH[@]}" start "$name" >/dev/null 2>&1 || true
        fi
        start_watcher "$name"
    done
}

cmd_autostart() {   # vmctl autostart NAME [on|off]
    local name=${1:?usage: vmctl autostart NAME [on|off]} setting=${2-}
    load_vm "$name"
    case ${setting,,} in
        "") msg "$name starts automatically with the server: ${AUTOSTART:-yes}" ;;
        on|yes)
            "${VIRSH[@]}" autostart "$name" >/dev/null
            set_env "$name" AUTOSTART yes
            msg "$name will now start automatically whenever this server starts." ;;
        off|no)
            "${VIRSH[@]}" autostart --disable "$name" >/dev/null
            set_env "$name" AUTOSTART no
            msg "$name will no longer start by itself; after a server restart start it with: vmctl start $name" ;;
        *) die "usage: vmctl autostart NAME [on|off]" ;;
    esac
}

ensure_unit() {
    [[ -f $UNIT ]] && return
    cat >"$UNIT" <<EOF
[Unit]
Description=vmctl VM port forwards (nftables DNAT)
After=network-online.target nftables.service ufw.service libvirtd.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$SELF apply

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable vmctl-forwards.service >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------- network
ensure_network() {
    local clash
    vmsg "Checking the private VM network ($NET_NAME, $NET_PREFIX.0/24)"
    if ! "${VIRSH[@]}" net-info "$NET_NAME" >/dev/null 2>&1; then
        # Never create it on top of an address range something else already uses.
        clash=$(ip -4 -o addr show | awk -v p="$NET_PREFIX." -v br="$BRIDGE" 'index($4, p) == 1 && $2 != br {print $2; exit}')
        [[ -n $clash ]] || clash=$(ip -4 route show | awk -v n="$NET_PREFIX.0/24" -v br="$BRIDGE" '$1 == n && $0 !~ br {for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i+1); exit}}')
        if [[ -n $clash ]]; then
            die "the address range $NET_PREFIX.0/24 is already used on this server (by $clash). Set NET_PREFIX in $CONF to a free range, for example NET_PREFIX=192.168.151, and run vmctl again."
        fi
        msg "  The private network does not exist yet; creating it"
        msg "  Address range $NET_PREFIX.0/24 is free on this server"
        msg "  Defining network $NET_NAME: bridge $BRIDGE, this server is $NET_PREFIX.1, each VM gets a fixed address from $NET_PREFIX.10"
        local x; x=$(mktemp)
        # forward mode 'open': libvirt adds no firewall rules of its own (its
        # NAT mode would reject our port forwards); vmctl's nft table does the NAT.
        cat >"$x" <<EOF
<network>
  <name>$NET_NAME</name>
  <forward mode='open'/>
  <bridge name='$BRIDGE' stp='on' delay='0'/>
  <ip address='$NET_PREFIX.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='$NET_PREFIX.200' end='$NET_PREFIX.250'/>
    </dhcp>
  </ip>
</network>
EOF
        "${VIRSH[@]}" net-define "$x" >/dev/null; rm -f "$x"
        msg "  Setting the network to start automatically when the server boots"
        "${VIRSH[@]}" net-autostart "$NET_NAME" >/dev/null
    else
        vmsg "  Network $NET_NAME exists (bridge $BRIDGE, this server is $NET_PREFIX.1)"
    fi
    # Capture first: "cmd | grep -q" + pipefail fails when grep exits early (SIGPIPE).
    if ! grep -Eq '^Active: +yes' <<<"$("${VIRSH[@]}" net-info "$NET_NAME")"; then
        msg "  Starting the network (bridge $BRIDGE and its DHCP/DNS service for the VMs)"
        "${VIRSH[@]}" net-start "$NET_NAME" >/dev/null
    else
        vmsg "  The network is running"
    fi
    if [[ $(sysctl -n net.ipv4.ip_forward) != 1 ]]; then
        msg "  Turning on IP forwarding so VMs can reach the internet (saved in /etc/sysctl.d/90-vmctl.conf)"
        echo 'net.ipv4.ip_forward = 1' >/etc/sysctl.d/90-vmctl.conf
        sysctl -q -w net.ipv4.ip_forward=1
    else
        vmsg "  IP forwarding is on"
    fi
    fw_net
    if ! nft list table ip vmctl >/dev/null 2>&1; then
        msg "  Loading vmctl's NAT and port-forward table (nftables table ip vmctl)"
        apply_forwards
    else
        vmsg "  vmctl's NAT and port-forward table is loaded"
    fi
    vmsg "  Private network ready"
}

# ---------------------------------------------------------------- allocation
used_ports() {
    local f
    for f in "$VMS_DIR"/*.fwd; do awk '!/^#/ && NF {print $2}' "$f"; done
    for f in "$VMS_DIR"/*.env; do sed -n 's/^SPICE_PORT=//p' "$f"; done
    ss -Htuln | awk '{n=split($5,a,":"); print a[n]}'
}

port_free() { ! grep -qx "$1" <<<"$(used_ports)"; }

next_port() {
    local p=$1 used; used=$(used_ports | sort -un)
    while grep -qx "$p" <<<"$used"; do p=$((p + 1)); done
    echo "$p"
}

next_ip() {
    local i used
    # Also skip addresses still leased to deleted VMs: dnsmasq will not hand a
    # reserved address to a new MAC until the old lease expires.
    used=$( { for f in "$VMS_DIR"/*.env; do sed -n 's/^IP=//p' "$f"; done
              "${VIRSH[@]}" net-dumpxml "$NET_NAME" | grep -o "ip='[0-9.]*'" | tr -d "ip='"
              "${VIRSH[@]}" net-dhcp-leases "$NET_NAME" | grep -oE "$NET_PREFIX\.[0-9]+" || true; } | sort -u)
    for (( i = 10; i < 200; i++ )); do
        grep -qx "$NET_PREFIX.$i" <<<"$used" || { echo "$NET_PREFIX.$i"; return; }
    done
    die "no free addresses left in $NET_PREFIX.10-199"
}

make_mac() {
    local m
    m=52:54:00:$(printf '%s' "$1" | md5sum | sed -E 's/^(..)(..)(..).*/\1:\2:\3/')
    # /dev/null keeps grep off stdin when nullglob leaves no .env files.
    if grep -qs "^MAC=$m$" /dev/null "$VMS_DIR"/*.env; then
        m=52:54:00:$(od -An -N3 -tx1 /dev/urandom | tr -s ' ' ':' | sed 's/^://')
    fi
    echo "$m"
}

# (no "tr </dev/urandom | head": tr dies of SIGPIPE, which pipefail turns into an error)
rand_pass() { head -c 400 /dev/urandom | tr -dc 'A-HJ-NP-Za-km-z2-9' | cut -c "1-${1:-12}"; }

# ---------------------------------------------------------------- downloads
human_mb() { echo $(( ${1:-0} / 1048576 )); }

# Downloads use curl's own user agent: several mirrors (fedorapeople,
# Fedora) answer a browser user agent with an anti-bot HTML page instead
# of the file. Only the Microsoft API calls send $UA.
remote_size() {
    curl -sIL "$1" | tr -d '\r' | awk 'tolower($1)=="content-length:" {n=$2} END {print n+0}'
}

# Is FILE really an ISO / qcow2 image (and not, say, an HTML error page)?
media_ok() {   # media_ok FILE [NAME-THAT-DECIDES-THE-TYPE]
    local f=$1 kind=${2:-$1}
    case $kind in
        *.iso) [[ $(dd if="$f" bs=1 skip=32769 count=5 2>/dev/null) == CD001 ]] ;;
        *.qcow2|*.img) [[ $(head -c 3 "$f") == QFI ]] ;;
        *) [[ -s $f ]] ;;
    esac
}

# download URL DEST   - resumable, prints a plain progress line every 20 s
# (no redrawing progress bar, which screen readers read over and over).
download() {
    local url=$1 dest=$2 part="$2.part" total pid cur pct
    if [[ -f $dest ]]; then
        media_ok "$dest" && { msg "Using the already-downloaded $(basename "$dest")"; return 0; }
        warn "the cached $(basename "$dest") is damaged; downloading it again"
        rm -f "$dest"
    fi
    total=$(remote_size "$url")
    msg "Downloading $(basename "$dest")$( (( total > 0 )) && echo " ($(human_mb "$total") MB)")"
    curl -fsSL --retry 8 --retry-delay 5 --retry-all-errors -C - -o "$part" "$url" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        sleep 20
        kill -0 "$pid" 2>/dev/null || break
        cur=$(stat -c %s "$part" 2>/dev/null || echo 0)
        if (( total > 0 )); then pct=$(( cur * 100 / total ))
            msg "  $(human_mb "$cur") of $(human_mb "$total") MB ($pct percent)"
        else msg "  $(human_mb "$cur") MB so far"; fi
    done
    wait "$pid" || die "download failed: $url (partial file kept at $part; run again to resume)"
    cur=$(stat -c %s "$part")
    (( total == 0 || cur == total )) || die "download of $(basename "$dest") is incomplete ($cur of $total bytes); run again to resume"
    if ! media_ok "$part" "$dest"; then
        rm -f "$part"
        die "what $url returned is not a disc or disk image (maybe an error or anti-bot page)"
    fi
    mv "$part" "$dest"
    msg "  Download complete."
}

# ---------------------------------------------------------------- disks
disk_used() { du -h "$1" 2>/dev/null | cut -f1 || true; }   # space an image really takes

# make_disk PATH GB WHAT - a new, empty qcow2 disk. No preallocation: with
# preallocation=metadata a 1000 GB disk took 2-3 minutes here with no output;
# a plain qcow2 is ready at once and only takes space as data is written.
make_disk() {
    local path=$1 gb=$2 what=$3 t0=$SECONDS
    msg "Creating the $what: $gb GB ($path)"
    qemu-img create -q -f qcow2 "$path" "${gb}G" || die "creating the $what failed"
    msg "  Done in $(( SECONDS - t0 )) seconds. It takes $(disk_used "$path") on the server now and grows as data is written, up to $gb GB."
}

# copy_disk SRC DEST - convert an image into a qcow2 disk, printing a plain
# progress line every 10 s (like download, no redrawing progress bar).
copy_disk() {
    local src=$1 dest=$2 t0=$SECONDS pid out pct
    out=$(mktemp)
    qemu-img convert -p -O qcow2 "$src" "$dest" >"$out" 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        sleep 10
        kill -0 "$pid" 2>/dev/null || break
        pct=$(tr '\r' '\n' <"$out" | grep -o '[0-9]*\.[0-9]*/100%' | tail -n 1 | cut -d. -f1 || true)
        msg "  ${pct:-0} percent copied"
    done
    if ! wait "$pid"; then
        tr '\r' '\n' <"$out" | grep -v '/100%' >&2 || true
        rm -f "$out"
        die "copying the disk image failed"
    fi
    rm -f "$out"
    msg "  Done in $(( SECONDS - t0 )) seconds ($(disk_used "$dest") on the server)."
}

# Microsoft's consumer download API (same flow as quickemu's Mido).
# Prints a signed ISO URL, or fails.
ms_consumer_url() {
    local page=$1 url sid html ped skujson skuid linkjson link
    url="https://www.microsoft.com/en-us/software-download/$page"
    sid=$(cat /proc/sys/kernel/random/uuid)
    html=$(curl -fsS -A "$UA" -H 'Accept:' --max-filesize 2000000 "$url") || return 1
    ped=$(grep -Eo '<option value="[0-9]+">Windows' <<<"$html" | head -n1 | cut -d'"' -f2)
    [[ -n $ped ]] || return 1
    curl -fsS -o /dev/null -A "$UA" "https://vlscppe.microsoft.com/tags?org_id=y6jn8c31&session_id=$sid" || return 1
    skujson=$(curl -fsS -A "$UA" --referer "$url" "https://www.microsoft.com/software-download-connector/api/getskuinformationbyproductedition?profile=606624d44113&ProductEditionId=$ped&SKU=undefined&friendlyFileName=undefined&Locale=en-US&sessionID=$sid") || return 1
    skuid=$(jq -r '.Skus[] | select(.Language=="English" or .Language=="English (United States)").Id' <<<"$skujson" | head -n1)
    [[ -n $skuid ]] || return 1
    linkjson=$(curl -fsS -A "$UA" --referer "$url" "https://www.microsoft.com/software-download-connector/api/GetProductDownloadLinksBySku?profile=606624d44113&productEditionId=undefined&SKU=$skuid&friendlyFileName=undefined&Locale=en-US&sessionID=$sid") || return 1
    if jq -e '.Errors' <<<"$linkjson" >/dev/null 2>&1; then
        warn "Microsoft refused the download: $(jq -r '.Errors[0].Value' <<<"$linkjson")"
        return 1
    fi
    link=$(jq -r '[.ProductDownloadOptions[] | select(.Uri | test("x64"))][0].Uri // empty' <<<"$linkjson")
    [[ -n $link ]] || return 1
    echo "$link"
}

# Resolve the newest file matching REGEX in an HTTP directory listing.
latest_in_index() {
    local index=$1 re=$2 f
    f=$(curl -fsSL --retry 4 --retry-all-errors --retry-delay 2 "$index" | grep -oE "$re" | sort -uV | tail -n1)
    [[ -n $f ]] || return 1
    echo "${index%/}/$f"
}

latest_dir() {   # newest numeric subdirectory (e.g. 42/ or 22.2/) of an index
    # Mirrors write links as href="44/" or href="/full/path/44/"; accept both.
    curl -fsSL --retry 4 --retry-all-errors --retry-delay 2 "$1" | grep -oE 'href="[^"]*"' \
        | sed -nE 's|.*[/"]([0-9]+(\.[0-9]+)?)/"$|\1|p' | sort -uV | tail -n1
}

# Linux ISO catalogue: id|label
LINUX_ISOS=(
    "debian13|Debian 13 (netinst; the installer offers speech synthesis)"
    "ubuntu2604-desktop|Ubuntu 26.04 LTS Desktop (Orca screen reader on the live session)"
    "ubuntu2604-server|Ubuntu 26.04 LTS Server"
    "ubuntu2404-desktop|Ubuntu 24.04 LTS Desktop"
    "ubuntu2404-server|Ubuntu 24.04 LTS Server"
    "fedora-workstation|Fedora Workstation (latest)"
    "fedora-server|Fedora Server (latest)"
    "mint|Linux Mint Cinnamon (latest)"
    "custom|Another distro: give an ISO URL or a file on this server"
)

linux_iso_url() {
    local v
    case $1 in
        debian13) latest_in_index https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/ 'debian-13\.[0-9.]+-amd64-netinst\.iso' ;;
        ubuntu2604-desktop) latest_in_index https://releases.ubuntu.com/26.04/ 'ubuntu-26\.04(\.[0-9]+)?-desktop-amd64\.iso' ;;
        ubuntu2604-server)  latest_in_index https://releases.ubuntu.com/26.04/ 'ubuntu-26\.04(\.[0-9]+)?-live-server-amd64\.iso' ;;
        ubuntu2404-desktop) latest_in_index https://releases.ubuntu.com/24.04/ 'ubuntu-24\.04(\.[0-9]+)?-desktop-amd64\.iso' ;;
        ubuntu2404-server)  latest_in_index https://releases.ubuntu.com/24.04/ 'ubuntu-24\.04(\.[0-9]+)?-live-server-amd64\.iso' ;;
        fedora-workstation|fedora-server)
            local base=https://download.fedoraproject.org/pub/fedora/linux/releases/ ed=Workstation kind=Live
            [[ $1 == fedora-server ]] && { ed=Server; kind=dvd; }
            # download.fedoraproject.org sends each request to a different mirror,
            # and some mirrors are broken, so try a few times.
            local try
            for try in 1 2 3 4 5; do
                v=$(latest_dir "$base" 2>/dev/null) && [[ -n $v ]] \
                    && latest_in_index "$base$v/$ed/x86_64/iso/" "Fedora-$ed-$kind-[^\"]*x86_64[^\"]*\\.iso" 2>/dev/null \
                    && return 0
            done
            return 1 ;;
        mint)
            v=$(latest_dir https://mirrors.kernel.org/linuxmint/stable/) || return 1
            echo "https://mirrors.kernel.org/linuxmint/stable/$v/linuxmint-$v-cinnamon-64bit.iso" ;;
        *) return 1 ;;
    esac
}

